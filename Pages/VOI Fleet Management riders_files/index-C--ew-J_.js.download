    align-items: flex-end;
    flex: 1;
`,m6t=hn.img`
    height: 50px;

    &:hover {
        cursor: pointer;
    }

    &.run-animation {
        @keyframes drive-scooter {
            50% {
                transform: translate(150px, 0);
                animation-timing-function: linear;
            }

            50.001% {
                transform: translate(-140px, 0);
                animation-timing-function: ease-out;
            }
