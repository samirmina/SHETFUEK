const client = ZAFClient.init();

client.on('app.registered', async () => {
  // Step 1: Hide the app's UI panel
  await client.invoke('hide');

  // Step 2: Wait for ticket data to become available
  await delay(2000);

  // Step 3: Get ticket info
  const data = await client.get(['ticket.id', 'ticket.tags']);
  const ticketId = data['ticket.id'];
  const tags = data['ticket.tags'] || [];

  // Step 4: Check for specific tags
  const match = tags.find(tag => ['high', 'top', 'outstanding'].includes(tag));
  if (match) {
    const article = getIndefiniteArticle(match);
    const label = capitalize(match);

    // Step 5: Show the notification
    await client.invoke(
      'notify',
      `💡 Ticket #${ticketId} — this user is ${article} ${label} contributor`,
      'notice'
    );
  }
});

function delay(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

function getIndefiniteArticle(word) {
  return /^[aeiou]/i.test(word) ? 'an' : 'a';
}

function capitalize(word) {
  return word.charAt(0).toUpperCase() + word.slice(1);
}
