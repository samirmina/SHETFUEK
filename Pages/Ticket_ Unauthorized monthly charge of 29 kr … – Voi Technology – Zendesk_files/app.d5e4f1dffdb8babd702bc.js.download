#import "../fragments/LegacyLocalGraphIdentityFieldsFragment.gql"
#import "../fragments/LegacyLocalGraphRoleFieldsFragment.gql"
#import "../fragments/LegacyLocalGraphRoleConfigurationFieldsFragment.gql"
#import "../fragments/LegacyLocalGraphGroupFieldsFragment.gql"
#import "../fragments/LegacyLocalGraphAbilitiesFieldsFragment.gql"

query legacyUser($id: ID!) {
  user(id: $id) {
    id
    ...UserFields
    roleInfo {
      ...RoleFields
    }
    groups {
      ...GroupFields
    }
    defaultGroup {
      ...GroupFields
    }
    organization {
      id
      details
      name
      domainNames
      organizationFields {
        fieldName
        value
      }
      url
      tags
      groupId
      notes
      externalId
      sharedComments
      sharedTickets
    }
  }
}
