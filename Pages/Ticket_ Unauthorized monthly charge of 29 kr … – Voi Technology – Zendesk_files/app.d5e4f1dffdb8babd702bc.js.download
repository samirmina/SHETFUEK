mutation CreateInternalThreadMutation(
  $clientMutationId: String
  $entityUri: String!
  $body: String!
  $subject: String!
  $to: [ID!]!
  $fileAttachmentIds: [String!]
  $ticketAttachmentIds: [String!]
) {
  createInternalThread(
    input: {
      clientMutationId: $clientMutationId
      entityUri: $entityUri
      htmlBody: $body
      subject: $subject
      to: $to
      via: SUPPORT
      fileAttachmentIds: $fileAttachmentIds
      ticketAttachmentIds: $ticketAttachmentIds
    }
  ) {
    threadEdge {
      node {
        id
        ...ThreadFragment
      }
    }
