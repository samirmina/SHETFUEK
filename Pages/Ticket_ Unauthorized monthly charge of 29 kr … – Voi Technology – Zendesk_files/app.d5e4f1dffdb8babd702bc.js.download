e RCS","txt.ticket.channel.apple_business_chat":"Apple Business Chat","txt.ticket.channel.apple_business_chat_v2":"Apple Messages for Business","txt.ticket.channel.google_business_messages":"Google's Business Messages","txt.ticket.channel.kakaotalk":"KakaoTalk","txt.ticket.channel.business_messaging_slack_connect":"Slack","txt.ticket.channel.instagram_dm":"Instagram Direct","txt.ticket.channel.sunshine_conversations_api":"Sunshine Conversations API","txt.ticket.channel.sunshine_conversations_twitter_dm":"X Corp Direct Message","txt.ticket.channel.side_conversation":"Side conversation","txt.ticket.channel.ticket_sharing":"Ticket sharing","txt.ticket.channel.llm":"LLM","txt.ticket.channel.task":"Task","txt.suite_trial.interim_onboarding.view_tour":"View tour","txt.suite_trial.interim_onboarding.read_article":"Read article","txt.suite_trial.setup_and_go_live.header":"Set up and go live","txt.suite_trial.setup_and_go_live.description":"Get ready to help customers. To start, here are some of the most popular setup tasks for preparing to solve customer issues, plus collaborate and work efficiently as a team.","txt.suite_trial.setup_and_go_live.description_v2":"Get ready to help customers. Here are some of the most popular setup tasks for preparing to solve customer issues, plus collaborate and work efficiently as a team.","txt.suite_trial.setup_and_go_live.team_section.header":"Structure your team","txt.suite_trial.setup_and_go_live.team_section.description":"For easy management, set up team members and assign them to groups.","txt.suite_trial.setup_and_go_live.team_section.task_1.title":"Create groups","txt.suite_trial.setup_and_go_live.team_section.task_1.article_link":"https://support.zendesk.com/hc/en-us/articles/4405924126746#topic_r5j_c3m_qqb","txt.suite_trial.setup_and_go_live.team_section.task_2.title":"Add agents and admins","txt.suite_trial.setup_and_go_live.team_section.task_2.article_link":"https://support.zendesk.com/hc/en-us/articles/4405924126746#topic_ijz_g3m_qqb","txt.suite_trial.setup_and_go_live.tools_section.header":"Add workflow tools and apps","txt.suite_trial.setup_and_go_live.tools_section.description":"Improve processes by creating workflows and connecting apps that save your team time and energy.","txt.suite_trial.setup_and_go_live.tools_section.task_1.title":"Create custom ticket fields","txt.suite_trial.setup_and_go_live.tools_section.task_1.article_link":"https://support.zendesk.com/hc/en-us/articles/4405924126746#topic_ysq_phm_qqb","txt.suite_trial.setup_and_go_live.tools_section.task_2.title":"Filter tickets using views","txt.suite_trial.setup_and_go_live.tools_section.task_2.article_link":"https://support.zendesk.com/hc/en-us/articles/4405924126746#topic_nzt_zhm_qqb","txt.suite_trial.setup_and_go_live.tools_section.task_3.title":"Automate repeat actions with triggers","txt.suite_trial.setup_and_go_live.tools_section.task_3.article_link":"https://support.zendesk.com/hc/en-us/articles/4405924126746#topic_pn3_xhm_qqb","txt.suite_trial.setup_and_go_live.tools_section.task_4.title":"Integrate third-party apps","txt.suite_trial.setup_and_go_live.tools_section.task_4.article_link":"https://support.zendesk.com/hc/en-us/articles/4405924126746#topic_ysc_thm_qqb","txt.suite_trial.setup_and_go_live.email_support_section.header":"Enhance your email support","txt.suite_trial.setup_and_go_live.email_support_section.description":"Use custom emails for faster routing, give templates a branded feel, or forward a current support email.","txt.suite_trial.setup_and_go_live.email_support.task_1.title":"Create additional email addresses","txt.suite_trial.setup_and_go_live.email_support_section.task_1.article_link":"https://support.zendesk.com/hc/en-us/articles/4405924126746#topic_lzb_m3m_qqb","txt.suite_trial.setup_and_go_live.email_support.task_2.title":"Customize email templates","txt.suite_trial.setup_and_go_live.email_support_section.task_2.article_link":"https://support.zendesk.com/hc/en-us/articles/4405924126746#topic_b2j_l3m_qqb","txt.suite_trial.setup_and_go_live.email_support.task_3.title":"Adding an existing support email address","txt.suite_trial.setup_and_go_live.email_support.task_3.title_v2":"Add an existing support email address","txt.suite_trial.setup_and_go_live.email_support_section.task_3.article_link":"https://support.zendesk.com/hc/en-us/articles/203663336#topic_glt_l3w_jw","txt.suite_trial.setup_and_go_live.email_support_section.task_3.article_link_v2":"https://support.zendesk.com/hc/en-us/articles/4405924126746#topic_tym_w3m_qqb","txt.suite_trial.setup_and_go_live.go_live.badge":"Go live","txt.suite_trial.setup_and_go_live.list_tasks_section.header":"See the complete list of setup tasks","txt.suite_trial.setup_and_go_live.list_tasks_section.description":"Continue creating a rich Zendesk support system that helps your business improve response times, customer satisfaction, and agent efficiency.","txt.suite_trial.setup_and_go_live.list_tasks_section.cta":"See tasks","txt.suite_trial.setup_and_go_live.list_tasks_section.cta_url":"https://support.zendesk.com/hc/en-us/articles/360022372273","txt.suite_trial.setup_and_go_live.resources_section.header":"Learning and help resources","txt.suite_trial.setup_and_go_live.help_section.get_help":"Get help","txt.suite_trial.setup_and_go_live.help_section.header":"Help is here for you at every step","txt.suite_trial.setup_and_go_live.help_section.description":"Get answers anytime of day or night when you message Zendesk. In your profile menu, select {{#bold}}Get help{{/bold}} and start typing.","txt.suite_trial.setup_and_go_live.training_section.header":"Free on-demand training courses","txt.suite_trial.setup_and_go_live.training_section.description":"Training is built-in to your Zendesk plan and available 24/7.","txt.suite_trial.setup_and_go_live.training_section.link_text":"Learn about our training programs","txt.suite_trial.setup_and_go_live.training_section.link_url":"https://training.zendesk.com/page/learning-paths","txt.suite_trial.framework.hours":"{{hours}} hrs","txt.suite_trial.framework.reporting_and_analytics_theme.header":"Reporting and analytics","txt.suite_trial.framework.reveal_opportunities_through_data_task.header":"Reveal opportunities through data","txt.suite_trial.framework.reveal_opportunities_through_data_task.description":"Reporting and analytics integrates data from every channel. You'll see your most popular support areas and busiest times, plus identify areas where agents need workflow tools or more training. Quick insights with no statistics degree required.","txt.suite_trial.framework.reveal_opportunities_through_data_task.list.description":"Here's how to make smarter decisions:","txt.suite_trial.framework.reveal_opportunities_through_data_task.list.list_item_one":"Access key customer insights and agent performance metrics to run a more efficient business","txt.suite_trial.framework.reveal_opportunities_through_data_task.list.list_item_two":"See historical and real-time trends so you can take action and fix problem areas right away","txt.suite_trial.framework.reveal_opportunities_through_data_task.subhead_for_stats":"Companies that harness data see big operational improvements","txt.suite_trial.framework.reveal_opportunities_through_data_task.x_time_value":"{{number}}{{#styledSign}}x{{/styledSign}}","txt.suite_trial.framework.reveal_opportunities_through_data_task.statistic_1":"faster resolutions of tickets","txt.suite_trial.framework.reveal_opportunities_through_data_task.statistic_2":"reduction in customer wait time","txt.suite_trial.framework.reveal_opportunities_through_data_task.statistic_3":"volume of customer requests solved","txt.suite_trial.framework.reveal_opportunities_through_data_task.video_alt_txt":"Get an overview on how to collect, learn from, and act on your customer service data.","txt.suite_trial.framework.visualize_your_data_task.header":"Visualize your data","txt.suite_trial.framework.visualize_your_data_task.description":"Customizable, built-in dashboards and charts make it easy to manage team staffing and performance, plus gain understanding of customer interactions. From ticket volume and resolution times to identifying opportunities to coach agents, you can look at real-time and historical trends across all channels to enhance the overall customer experience.","txt.suite_trial.framework.visualize_your_data_task.img_caption_support_dashboard":"{{#boldText}}Support dashboard{{/boldText}} gives key insights about your ticket volumes, busiest times, and how efficiently agents solve them.","txt.suite_trial.framework.visualize_your_data_task.img_caption_omnichannel_reporting_charts":"{{#boldText}}Omnichannel reporting charts{{/boldText}} let you see all the tickets created across each channel so you can understand how customers reach you.","txt.suite_trial.framework.visualize_your_data_task.img_caption_team_performance_charts":"{{#boldText}}Team performance charts{{/boldText}} help you understand agent performance and identify opportunities for coaching your team.","txt.suite_trial.framework.visualize_your_data_task.img_caption_live_team_dashboard":"{{#boldText}}Live team dashboard{{/boldText}} gives real-time visibility across all your channels and helps you balance staffing in the moment.","txt.ticket.collision.ticket_updated_title":"Ticket updated","txt.ticket.collision.show_more":"Show more","txt.ticket.collision.show_less":"Show less","txt.ticket.collision.submitted_by_one":"Submitted by {{person}}","txt.ticket.collision.submitted_by_many":"Submitted by {{people}} and {{lastPerson}}","txt.ticket.collision.submitted_by_you":"Submitted by you","txt.ticket.collision.submitted_by_many_and_you":"Submitted by {{people}} and you","txt.ticket.collision.separator":"{{Person}}, {{Person}}","txt.ticket.collision.separator_updated":", ","txt.ticket.collision.also_here":"Also here","txt.ticket.collision.viewing":"Viewing","txt.ticket.collision.editing":"Editing","txt.ticket.collision.idle":"Idle","txt.ticket_table.column.collision.header":"Agent collision","txt.ticket_table.column.collision.agent_viewing":"Agent viewing ticket","txt.ticket_table.column.collision.no_agent_viewing":"No agent viewing this ticket","txt.ticket_table.column.conversation_indicator.header":"Conversation","txt.ticket_table.column.conversation_indicator.active":"Active conversation","txt.ticket_table.column.conversation_indicator.no_active":"No active conversation","txt.ticket_table.column.group_privacy.header":"Group privacy","txt.ticket_table.column.group_privacy.public_group":"Public group","txt.ticket_table.column.row_overflow_menu.header":"Actions","txt.ticket.incidents.button_label":"Incidents","txt.ticket.incidents.view_header":"Incidents","txt.ticket.incidents.first_paragraph":"{{#strong}}Incident{{/strong}} type tickets can be linked to {{#strong}}Problem{{/strong}} type tickets.","txt.ticket.incidents.second_paragraph":"Solving a Problem ticket automatically solves the linked Incident tickets. If the Problem ticket is solved with a comment, the comment is also added to the Incident tickets as well.","txt.suite_trial.framework.visualize_your_data_task.img_title_support_dashboard":"Support dashboard","txt.suite_trial.framework.visualize_your_data_task.img_title_omnichannel_reporting_charts":"Omnichannel reporting charts","txt.suite_trial.framework.visualize_your_data_task.img_title_team_performance_charts":"Team performance charts","txt.suite_trial.framework.visualize_your_data_task.img_title_live_team_dashboard":"Live team dashboard","txt.suite_trial.framework.lern_more.theme":"Learn more","txt.suite_trial.framework.lern_more.title":"Learn more about Zendesk","txt.suite_trial.framework.lern_more.description":"Go beyond the trial to see how Zendesk is flexible enough to fit any business.","txt.suite_trial.framework.lern_more.banner_title":"Zendesk has a plan that matches your business","txt.suite_trial.framework.lern_more.banner_text":"Zendesk Suite is a complete customer service solution that has a variety of plans to fit companies of all sizes in any stage of business.","txt.suite_trial.framework.lern_more.banner_button_text":"See plans","txt.suite_trial.framework.lern_more.banner_pricing_link":"https://www.zendesk.com/pricing","txt.suite_trial.framework.lern_more.sub_header":"Additional ways to explore Zendesk","txt.suite_trial.framework.lern_more.list_item_header_one":"Watch demo videos to see how it all works","txt.suite_trial.framework.lern_more.list_item_text_one":"Zendesk demo videos show you additional capabilities and how to use tools that keep your business in sync. {{#link}}See videos{{/link}}","txt.suite_trial.framework.lern_more.list_item_header_two":"Discover how businesses like yours use Zendesk","txt.suite_trial.framework.lern_more.list_item_text_two":"Others have forged the path for you, so learn how they implemented and used Zendesk to better serve their customers. {{#link}}Read customer stories{{/link}}","txt.suite_trial.framework.lern_more.list_item_header_tree":"Use the free on-demand training courses","txt.suite_trial.framework.lern_more.list_item_text_three":"Training is built-in to your Zendesk plan and available 24/7. {{#link}}Learn about the training programs{{/link}}","txt.suite_trial.framework.lern_more.list_item_header_four":"Check out the evaluation guides","txt.suite_trial.framework.lern_more.list_item_text_four":"Get step-by-step tips for how to plan, use, and evaluate your Zendesk trial. {{#link}}Read the evaluation guides{{/link}}","txt.suite_trial.framework.lern_more.list_item_text_one_link":"https://www.zendesk.com/demo/ondemand/?demoStep=personal#service","txt.suite_trial.framework.lern_more.list_item_text_two_link":"https://www.zendesk.com/why-zendesk/customers/","txt.suite_trial.framework.lern_more.list_item_text_two_link_v2":"https://www.zendesk.com/customer/small-teams-power-growth-innovation-customer-service/","txt.suite_trial.framework.lern_more.list_item_text_three_link":"https://training.zendesk.com","txt.suite_trial.framework.lern_more.list_item_text_four_link":"https://support.zendesk.com/hc/en-us/articles/360053763453","txt.suite_trial.preview_update.bot_header":"Answer Bot","txt.suite_trial.preview_update.bot_text_one":"Hi there. Got a question?","txt.suite_trial.preview_update.customer_text":"I need a refund","txt.suite_trial.preview_update.bot_text_two":"This article might help:","txt.suite_trial.preview_update.bot_article_title":"Returns and exchanges","txt.suite_trial.preview_update.bot_article_content":"Something not right ...","txt.suite_trial.preview_update.bot_article_link_text":"View article","txt.suite_trial.preview_update.bot_text_three":"Was this helpful?","txt.suite_trial.preview_update.time":"Just now","txt.suite_trial.preview_update.button_yes":"Yes","txt.suite_trial.preview_update.button_no":"No","txt.suite_trial.preview_update.button_no_english_only":"No, I still need help","txt.suite_trial.preview_update.placeholder_text":"Type a message","txt.suite_trial.apps_and_int_theme.header":"Apps and integrations","txt.suite_trial.apps_and_int_theme.task_one_name":"Connect your business tools","txt.suite_trial.apps_and_int_theme.task_two_name":"Explore the Marketplace","txt.suite_trial.apps_and_int_theme.task_one.paragraph":"The Zendesk Marketplace is a one-stop-shop to make all types of integrations seamless. You're able to create a unified customer experience that fits your business.","txt.suite_trial.apps_and_int_theme.task_one.list_sub_header":"There are over 1,200 apps and integrations in the Zendesk Marketplace.","txt.suite_trial.apps_and_int_theme.task_one.list_item_one":"Get apps for everything from time-tracking to e-commerce","txt.suite_trial.apps_and_int_theme.task_one.list_item_two":"Build your own apps with the custom apps framework","txt.suite_trial.apps_and_int_theme.task_two.sub_header":"Connect everything within a few clicks. Find partners, apps, and integrations that help drive customer satisfaction, increase agent productivity, and streamline workflows.","txt.suite_trial.apps_and_int_theme.task_two.list_sub_header":"Apps and integrations can help your business in a number of ways.","txt.suite_trial.apps_and_int_theme.task_two.list_item_one":"Save agents time when you put everything they need into one view","txt.suite_trial.apps_and_int_theme.task_two.list_item_two":"Improve communication, organization, and access to information by having it all work together effortlessly","txt.suite_trial.apps_and_int_theme.task_two.list_item_three":"Build custom apps and integrations using Zendesk tools, frameworks, and open API. {{#link}}Read developer docs{{/link}}","txt.suite_trial.apps_and_int_theme.task_two.explore_button":"Explore all apps","txt.suite_trial.apps_and_int_theme.task_two.slack_tile_link":"https://www.zendesk.com/apps/support/156097/slack/","txt.suite_trial.apps_and_int_theme.task_two.jira_tile_link":"https://www.zendesk.com/apps/support/24475/jira/","txt.suite_trial.apps_and_int_theme.task_two.shopify_tile_link":"https://www.zendesk.com/apps/chat/93859/shopify-for-zendesk/","txt.suite_trial.apps_and_int_theme.task_two.google_play_tile_link":"https://www.zendesk.com/apps/support/86800/google-play-reviews/","txt.suite_trial.apps_and_int_theme.task_two.mailchimp_tile_link":"https://www.zendesk.com/apps/support/5502/mailchimp-activity/","txt.suite_trial.apps_and_int_theme.task_two.survey_monkey_tile_link":"https://www.zendesk.com/apps/support/142392/surveymonkey/","txt.suite_trial.apps_and_int_theme.task_two.zoom_tile_link":"https://www.zendesk.com/apps/support/117340/zoom/","txt.suite_trial.apps_and_int_theme.task_two.asana_tile_link":"https://www.zendesk.com/apps/support/353312/asana/","txt.suite_trial.apps_and_int_theme.task_two.marketplace_slack_tile_link":"https://www.zendesk.com/apps/support/156097/slack/","txt.suite_trial.apps_and_int_theme.task_two.marketplace_slack_tile_link_v2":"https://www.zendesk.com/marketplace/apps/support/972305/slack/","txt.suite_trial.apps_and_int_theme.task_two.