}

type ArticlesResultRow {
  id: ID!
  title: String
  updatedAt: String
  createdAt: String
  locale: String
  htmlUrl: String
  name: String
  snippet: String
}

type UsersResultRow {
  avatar: String
  email: String
  id: ID!
  name: String
  organization: String
  role: String
  updatedAt: String
}

type OrganizationsResultRow {
  id: ID!
  createdAt: String
  name: String
  notes: String
  organization: String
  updatedAt: String
}

type SideConversation {
  id: ID!
  subject: String!
}

type SideConversationsResultRow {
  id: ID!
  participants: [String]
  status: String
  sideConversation: SideConversation
  subject: String
  ticketId: String
}

union RowsResult =
  | TicketsResultRow
  | ArticlesResultRow
  | UsersResultRow
  | OrganizationsResultRow
  | SideConversationsResultRow

type SearchResult {
  columns: [SearchResultColumn]!
  count: Int!
  facets: FacetCounts
  rows: [RowsResult]!
}

extend type Query {
  searchBox(query: String!): SearchBox
