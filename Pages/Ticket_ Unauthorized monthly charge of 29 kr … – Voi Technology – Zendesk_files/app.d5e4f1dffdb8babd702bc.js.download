Message"}},directives:[],selectionSet:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"sanitizedHTMLContent"},arguments:[],directives:[]}]}},{kind:"InlineFragment",typeCondition:{kind:"NamedType",name:{kind:"Name",value:"SunshineConversationsFileUpload"}},directives:[],selectionSet:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"url"},arguments:[],directives:[]},{kind:"Field",name:{kind:"Name",value:"message"},arguments:[],directives:[]},{kind:"Field",name:{kind:"Name",value:"sanitizedHTMLContent"},arguments:[],directives:[]}]}},{kind:"InlineFragment",typeCondition:{kind:"NamedType",name:{kind:"Name",value:"ChatConversationAttachment"}},directives:[],selectionSet:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"url"},arguments:[],directives:[]}]}}]}}]}}]}}]}}]}}],loc:{start:0,end:2161}};function n(e,t){if("FragmentSpread"===e.kind)t.add(e.name.value);else if("VariableDefinition"===e.kind){var i=e.type;"NamedType"===i.kind&&t.add(i.name.value)}e.selectionSet&&e.selectionSet.selections.forEach(function(e){n(e,t)}),e.variableDefinitions&&e.variableDefinitions.forEach(function(e){n(e,t)}),e.definitions&&e.definitions.forEach(function(e){n(e,t)})}t.loc.source={body:`# operation.owner: 'box-office'

query printTicketConversationEvents(
  $id: ID!
  $includeInternalNotes: Boolean!
  $hasMssAttachments: Boolean!
  $cursor: String
) {
  ticket(id: $id) {
    id
    conversationEvents(first: 100, after: $cursor) {
      pageInfo {
        hasNextPage
        endCursor
      }
      edges {
        node {
          id
          __typename
          timestamp

          ... on ConversationEventWithActor {
            actor {
              id
              name
            }
          }

          ... on PublicMessage {
            sanitizedHTMLContent
            attachments {
              id
              contentUrl
              mappedContentUrl
              malwareScanResult @include(if: $hasMssAttachments)
            }
          }

          ... on InternalNote @include(if: $includeInternalNotes) {
            sanitizedHTMLContent
            attachments {
              id
              contentUrl
              mappedContentUrl
              malwareScanResult @include(if: $hasMssAttachments)
            }
          }

          ... on TalkPublicCallSummary {
            sanitizedHTMLContent
          }

          ... on TalkInternalCallSummary @include(if: $includeInternalNotes) {
            sanitizedHTMLContent
          }

          ... on FacebookPost {
            sanitizedHTMLContent
          }

          ... on FacebookPrivateMessage {
            sanitizedHTMLContent
          }

          ... on GenReplySend {
            generatedAnswer
          }

          ... on TalkPartnerPublicCallSummary {
            sanitizedHTMLContent
          }

          ... on TalkPartnerInternalCallSummary @include(if: $includeInternalNotes) {
            sanitizedHTMLContent
          }

          ... on ChatConversationMessage {
            content
          }

          ... on SunshineConversationsTextMessage {
            sanitizedHTMLContent
          }

          ... on SunshineConversationsFileUpload {
            url
            message
            sanitizedHTMLContent
          }

          ... on ChatConversationAttachment {
            url
          }
        }
      }
    }
  }
}
