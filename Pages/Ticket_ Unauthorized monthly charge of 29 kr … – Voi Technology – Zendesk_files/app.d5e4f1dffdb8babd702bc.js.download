mutation CreateEmailThreadMutation(
  $clientMutationId: String
  $entityUri: String!
  $body: String!
  $subject: String!
  $to: [ID!]!
  $cc: [ID!]!
  $bcc: [ID!]!
  $fileAttachmentIds: [String!]
  $ticketAttachmentIds: [String!]
) {
  createEmailThread(
    input: {
      clientMutationId: $clientMutationId
      entityUri: $entityUri
      htmlBody: $body
      subject: $subject
      to: $to
      cc: $cc
      bcc: $bcc
      via: SUPPORT
      fileAttachmentIds: $fileAttachmentIds
      ticketAttachmentIds: $ticketAttachmentIds
    }
  ) {
    threadEdge {
      node {
        id
        ...ThreadFragment
      }
    }
  }
}
