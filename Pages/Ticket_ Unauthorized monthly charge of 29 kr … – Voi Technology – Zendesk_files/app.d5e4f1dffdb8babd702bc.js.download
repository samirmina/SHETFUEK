#import 'SideConversations/data/fragments/CollaborationGraphPersonFragment.gql'
#import 'SideConversations/data/fragments/CollaborationGraphParticipantPersonFragment.gql'

fragment ThreadFragment on Thread {
  __typename
  createdAt
  deadline
  entityUri
  externalIds {
    type
    value
  }
  hasAttachments
  id
  messageAddedAt
  messageCount
  previewText
  state
  subject
  updatedAt
  uiUpdatedAt
  participantPeople {
    id
    ...ParticipantPersonFragment
  }
  readReceipts {
    ...ReceiptFragment
  }
  creator {
    id
    ...PersonFragment
  }
}
