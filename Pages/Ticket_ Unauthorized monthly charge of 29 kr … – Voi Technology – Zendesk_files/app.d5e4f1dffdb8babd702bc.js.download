d:"Name",value:"trialExpiresOn"},arguments:[],directives:[]},{kind:"Field",name:{kind:"Name",value:"daysLeftInTrial"},arguments:[],directives:[]}]}},{kind:"Field",name:{kind:"Name",value:"voice"},arguments:[],directives:[],selectionSet:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"voiceCustomer"},arguments:[],directives:[]},{kind:"Field",name:{kind:"Name",value:"planType"},arguments:[],directives:[]},{kind:"Field",name:{kind:"Name",value:"trial"},arguments:[],directives:[]},{kind:"Field",name:{kind:"Name",value:"legacy"},arguments:[],directives:[]}]}}]}}]}},{kind:"Field",name:{kind:"Name",value:"helpCenterSettings"},arguments:[],directives:[],selectionSet:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"features"},arguments:[],directives:[],selectionSet:{kind:"SelectionSet",selections:[{kind:"Field",name:{kind:"Name",value:"hasGroups"},arguments:[],directives:[]}]}}]}}]}}]}}],loc:{start:0,end:4560}};i.loc.source={body:`#import './LegacyLocalGraphAccountEmailSettingsFragment.gql'
#import './LegacyLocalGraphAccountFeaturesFragment.gql'
#import './LegacyLocalGraphAccountOnboardingSettingsFragment.gql'
#import './LegacyLocalGraphAccountKnowledgeSettingsFragment.gql'
#import './LegacyLocalGraphAccountSideConversationsSettingsFragment.gql'
#import './LegacyLocalGraphAccountTicketsSettingsFragment.gql'
#import './LegacyLocalGraphAccountTicketFormSettingsFragment.gql'
#import "./LegacyLocalGraphAccountDeviceMetadataSettingsFragment.gql"
#import '../../timeZones/fragments/LegacyLocalGraphTimeZoneFragment.gql'

query currentAccount {
  currentAccount {
    id
    name
    ownerId
    subdomain
    hourCycle
    isSandbox
    url
    createdAt
    region
    countryCode
    timeZone {
      ...TimeZoneDefaultFields
    }
    features {
      ...AccountFeaturesFragment
    }
    settings {
      activeFeatures {
        voice
        chat
        onHoldStatus
        userContextAsDefault
        hasCustomerSatisfactionEnabled
        hasCustomerSatisfactionSurveyEnabled
        organizationAccessEnabled
        approvalsActivated
        hasEverUsedApprovals
        hasEverUsedTasks
        dataMaskingConfiguredInRoles
        approversAsEndUsers
        agentTaskLists
      }
      email {
        ...AccountEmailSettingsFragment
      }
      tickets {
        ...AccountTicketsSettingsFragment
      }
      ticketForm {
        ...AccountTicketFormSettingsFragment
      }
      user {
        hasMultipleOrganizationsEnabled
        hasAgentCreatedWelcomeEmails
        sharedEmailCreationEnabled
      }
      lotus {
        reporting
        podId
      }
      branding {
        faviconUrl
        headerColor
      }
      brands {
        defaultBrandId
        requireBrandOnNewTickets
      }
      metrics {
        accountSize
      }
      limits {
        attachmentSize
        maxUsersPerSharedIdentity {
          email
        }
      }
      rule {
        enableMacroSuggestions
        macroMostUsed
        macroOrder
        skillBasedFilteredViews
      }
      routing {
        enabled
        autoroutingTag
        maxEmailCapacity
        maxMessageCapacity
        autoAcceptMessagingEnabled
        autoOpenEmailEnabled
        reassignmentAgentStatusChangeEnabled
        reassignmentAgentStatusChangeMessagingAgentStatuses
        reassignmentAgentStatusChangeMessagingEnabled
        reassignmentAgentStatusChangeSupportAgentStatuses
        reassignmentAgentStatusChangeSupportEnabled
      }
      onboarding {
        ...AccountOnboardingSettingsFragment
      }
      knowledge {
        ...AccountKnowledgeSettingsFragment
      }
      agents {
        unifiedAgentStatuses
        unifiedNavigationEnabled
        awAutoActivationTimestamp
        awAutoActivationStatus
        agentWorkspace
        agentAsARequester
        agentHome
        darkModeAgentWorkspace
        darkModeTermsAndConditionsAccepted
        contactCenterRealtimeTranslationEapEnabled
        suggestedAssigneesEapEnabled
        suggestedAssigneesEapTosAccepted
        splitViewEnabled
        splitViewTosAccepted
        splitViewEapEnabled
        splitViewEapTosAccepted
        splitViewEapInheritedAccessDisabled
        spellCheckerEnabled
      }
      sideConversations {
        ...AccountSideConversationsSettingsFragment
      }
      chat {
        enabled
        ctmAutoActivationTimestamp
        ctmSegment
        ctmAutoActivationStatus
        ctmPreventOptOut
        ctmOperatingHoursMigrationStatus
        ctmChatTriggersMigrationStatus
        ctmPreChatFormMigrationStatus
        ctmOfflineFormMigrationStatus
        ctmVisitorIpBannedMigrationStatus
        ctmGoalsMigrationStatus
        ctmMigratedTimestamp
      }
      sandbox {
        type
      }
      deviceMetadata {
        ...AccountDeviceMetadataSettingsFragment
      }
      messaging {
        messagingEndSession
      }
      voice {
        enabled
      }
    }
    subscription {
      createdAt
      daysLeftInTrial
      planName
      trial
      trialExpiresOn
      suspended
      termEndDate
      salesModel
      helpDeskSize
      supportExperienceType
      plans {
