.options.move_down_once":"Move down once","txt.app_shortcuts.no_apps_in_sight.header":"No apps in sight","txt.app_shortcuts.no_apps_in_sight.body":"If you unpin any apps, they will appear here.","txt.app_shortcuts.onboarding.pin_app_tooltip.title":"Pin your go-to apps","txt.app_shortcuts.onboarding.pin_app_tooltip.body":"Easily access your most-used apps by pinning them to the sidebar.","txt.app_shortcuts.onboarding.unpin_app_tooltip.title":"Unpin app at any time","txt.app_shortcuts.onboarding.unpin_app_tooltip.body":"Remove your app from the sidebar if you no longer need it.","txt.app_shortcuts.onboarding.reorder_app_tooltip.title":"Reorder your apps","txt.app_shortcuts.onboarding.rearrange_app_tooltip.body":"Simply drag and drop or find the options to change the order within each app.","txt.app_shortcuts.screen_reader_announcement.pinned":"{{appName}} has been pinned","txt.app_shortcuts.screen_reader_announcement.unpinned":"{{appName}} has been unpinned","txt.keyboard_shortcuts.key.windows":"Win","txt.rate_limit.notification.title":"Rate limit reached","txt.rate_limit.notification.message":"This message will persist until the rate limit has been lifted.","txt.rate_limit.notification.title2":"Access temporarily restricted","txt.rate_limit.notification.message2":`You've reached your activity limit.

