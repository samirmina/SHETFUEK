type MacroResults {
  macros: [Macro!]!
  macrosPageNumber: Int
  totalMacrosPages: Int
  categories: [String]
  groups: [Group]
}

type SuggestedMacro {
  id: ID!
  score: Float!
}

type SuggestedMacrosResult {
  predictionId: String!
  suggestedMacros: [SuggestedMacro]
}

type AllMacroResults {
  macros: [Macro!]!
  mostUsed: [Macro!]
}

type FeedbackSuggestedMacroResult {
  success: String!
  macros: [MacroFeedback]
  error: FeedbackError
}

type FeedbackError {
  status: Boolean!
  message: String
}

type MacroFeedback {
  id: String
  title: String
  usage: String
}

input FeedbackMacrosInput {
  id: String!
  position: Int
  title: String
  usage: String
}

extend type Query {
  macroResults(
    page: Int
    perPage: Int
    sortBy: String
    sortOrder: String
    queryString: String
    access: String
    category: String
    groupId: ID
    sideloads: String
  ): MacroResults!
  allMacroResults: AllMacroResults!
  suggestedMacrosResult(ticketId: String, limit: Int): SuggestedMacrosResult
}

extend type Mutation {
  feedbackSuggestedMacroResult(
    macros: [FeedbackMacrosInput]
    ticketId: String
    predictionId: String
    feature: String
