  recipientCount: Int
}

type CollabThreadReopened implements AuditEvent {
  id: ID!
  isPublic: Boolean
  threadId: ID!
  subject: String
}

type CollabThreadReply implements AuditEvent {
  id: ID!
  isPublic: Boolean
  threadId: ID!
  subject: String
}
`,`type AuditReEngagementSentEvent implements AuditEvent {
  id: ID!
  messagesCount: Int!
}
`,`type AuditTwitterEvent implements AuditEvent {
  id: ID!
  message: String
  isDirectMessage: Boolean
  author: User
}

type TwitterCommentStatus {
  id: ID
  isLiked: Boolean
  isRetweeted: Boolean
  isFollowingUser: Boolean
}

type LikeTweet {
  id: ID
  isLiked: Boolean
}

type Retweet {
  id: ID
  isRetweeted: Boolean
}

extend type Query {
  twitterCommentStatuses(ticketId: ID!): [TwitterCommentStatus]
}

extend type Mutation {
  likeTweet(eventId: ID!, like: Boolean!): LikeTweet
  retweet(eventId: ID!, retweet: Boolean!): Retweet
}
`,`type AuditVoiceUser {
  id: ID
  name: String
}

enum RecordingType {
  VOICEMAIL
  CALL
  AI
  UNKNOWN
}

type AuditVoiceEvent implements AuditEvent {
  id: ID!

  callId: ID!
  callType: Int

  startedAt: String
  location: String
  duration: Int

  from: String
  formattedFrom: String

  to: String
  formattedTo: String

  answeredBy: AuditVoiceUser

  recordingUrl: String
  recordingType: RecordingType!
  recordingConsentAction: String

  transcriptionStatus: String
  transcription: String
  isTranscriptionVisible: Boolean
}

type VoiceDeleteRecordingResponse {
  eventId: ID!
  callId: ID!
  success: Boolean!
}

extend type Mutation {
  deleteVoiceRecording(
    eventId: ID!
    callId: ID!
    recordingType: RecordingType!
  ): VoiceDeleteRecordingResponse!
}
`,`type AuditTpeVoiceUser {
  id: ID
  name: String
}

type AuditTpeVoiceEvent implements AuditEvent {
  id: ID!
  agent: AuditTpeVoiceUser
  appId: String
  appName: String
  callAbandonedPosition: String
  callback: Boolean
  callbackNumber: String
  callbackSource: String
  callDisposition: String
  callEndedAt: String
  callId: ID!
  callRecordingConsentAction: String
  callStartedAt: String
  callTypeString: String
  completionStatus: String
  consultationTime: Int
  createdAt: String
  customerRequestedVoicemail: Boolean
  direction: String
  dnis: String
  duration: Int
  endUser: AuditTpeVoiceUser
  endUserLocation: String
  exceededQueueTime: Boolean
  externalId: String
  formattedFrom: String
  fromLine: String
  formattedTo: String
  fromLineNickname: String
  holdTime: Int
  ivrAction: String
  ivrDestinationGroupName: String
  ivrHops: Int
  ivrRoutedTo: String
  ivrTimeSpent: Int
  notRecordingTime: Int
  outsideBusinessHours: Boolean
  overflowed: Boolean
  overflowedTo: String
  phoneName: String
  queueName: String
  queueTime: Int
  recordingControlInteractions: Int
  recordingTime: Int
  talkTime: Int
  timeToAnswer: Int
  title: String
  toLine: String
  toLineNickname: String
  updatedAt: String
  voicemail: Boolean
  waitTime: Int
  wrapUpTime: Int
  recordingUrl: String
  transcript: String
}
`,`
${eY("ConversationLog")}

type AuditVia {
  channel: String
  source: JSON
}

type AuditFlag {
  reason: Int!
  isTrusted: Boolean!
  type: String
  message: JSON
}

type AuditSystem {
  client: String
  address: String
  location: String
  messageId: String
  jsonEmailIdentifier: String
  rawEmailIdentifier: String
}

type AuditCustom {
  z1RequestUrl: String
}

type AuditDecorationAuthor {
  id: ID
  name: String
  username: String
  avatar: String
  locale: String
}

type AuditDecorationSource {
  zendeskId: ID
  name: String
}

type AuditDecorationChannel {
  allowChannelback: Boolean
}

type AuditDecoration {
  createdAt: String
  author: AuditDecorationAuthor
  source: AuditDecorationSource
  externalId: String
  resourceType: String
  channel: AuditDecorationChannel
  anyChannel: AuditDecorationChannel
}

# Warning:
#  in various AuditEvent implementations, you cannot have two fields with the
#  same name with a different type.

interface AuditEvent {
  id: ID!
}

interface AuditNode {
  id: ID!
  createdAt: String!
  author: User
  via: AuditVia
  system: AuditSystem
  custom: AuditCustom
  isTrusted: Boolean!
  flags: [AuditFlag]!
  decoration: AuditDecoration
}

input ConversationLogFilter {
  type: String
}

extend type ConversationLog implements AuditNode {
  createdAt: String!
  author: User
  via: AuditVia
  system: AuditSystem
  custom: AuditCustom
  isTrusted: Boolean!
  flags: [AuditFlag]!
  decoration: AuditDecoration

  events(filter: ConversationLogFilter): [AuditEvent]
}

input EmailReport {
  description: String
  messageId: String!
  jsonEmailIdentifier: String!
  rawEmailIdentifier: String!
}

input TicketCommentReportInput{
  ticketId: ID!
  eventId: ID!
  emailReport: EmailReport!
}

type TicketCommentReport{
  z1RequestUrl: String!
}

extend type Query {
  conversationLogsFeed(ticketId: ID!, eventFilter: ConversationLogFilter, connection: ConnectionInput): ConversationLogsConnection
  conversationReport(id: ID!): TicketCommentReport
}

extend type Mutation {
  saveConversationReport(report: TicketCommentReportInput): TicketCommentReport
}
