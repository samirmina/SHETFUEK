  id: ID!
  articleId: ID!
  body: String
  brandId: ID!
  htmlUrl: String!
  labelNames: [String]
  locale: String!
  score: Float!
  snippet: String!
  title: String!
  url: String!
}

type Ticket {
  ticketId: ID!
}

type FailedTicket {
  reason: String!
}

union TicketFetch = Ticket | FailedTicket

type Event {
  id: ID!
}

type ContentPin {
  id: ID!
  contentId: String!
  contentType: String!
  locale: String
}

type ContentPins {
  data: [ContentPin]!
  count: Int!
}

input ArticleOwnerInput {
  id: ID
  type: String
}

input LastSearchInput {
  query: String
  rank: Int
  resultsCount: Int
  url: String
}

input SearchDataInput {
  id: ID!
  type: String!
  locale: String
  searchId: String
  url: String
}

type SourceContent {
  id: ID!
  locale: String
  title: String!
  url: String!
  type: String!
  searchId: String!
}

type GenerativeAnswer {
  solved: Boolean!
  answer: String!
  formattedAnswer: String!
  sourceContents: [SourceContent]!
}

type Citations {
  id: ID!
  locale: String!
  type: String
  title: String
  url: String
}

type VoiceSuggestions {
  status: String!
  text: String!
  citations: [Citations]
}

type SuggestionRecord {
  id: ID!
  locale: String!
  type: String!
  title: String!
  url: String!
}

type SuggestionsArticle {
  id: ID!
  records: [SuggestionRecord]!
}

input QuickAnswerFiltersInput {
  locales: [String!]
  record_types: [String!]
  brand_ids: [ID!]
  external_source_ids: [String!]
  external_type_ids: [String!]
  article_category_ids: [ID!]
  article_section_ids: [ID!]
}

input FilterScope {
  field: String!
  filter_type: String!
  values: [String!]!
  strict: Boolean
}

input SuggestionsFiltersInput {
  locales: [String!]
  record_types: [String!]
  brand_ids: [ID!]
  external_source_ids: [String!]
  external_type_ids: [String!]
  article_category_ids: [ID!]
  article_section_ids: [ID!]
  scope: [FilterScope!]
}

extend type Query {
  interactions(
    brandId: ID!
    deflectionChannelId: ID!
    enquiry: String!
    locale: String!
    requesterId: ID!
    ticketId: ID!
    viaId: ID!
  ): [AnswerBotArticle]!
  contentPins(ticketId: ID): ContentPins!
  generativeAnswer(query: String!, ticketId: ID, searchData: [SearchDataInput!]!): GenerativeAnswer!
  quickAnswer(
    query: String
    ticketId: ID
    searchId: String
    filters: QuickAnswerFiltersInput
  ): GenerativeAnswer!
  voiceSuggestions(ticketId: ID): VoiceSuggestions!
  articleSuggestions(
    query: String!
    ticketId: ID
    filters: SuggestionsFiltersInput
  ): SuggestionsArticle!
}

extend type Mutation {
  createTicket(
    subject: String!
    commentBody: String!
    articleOwner: ArticleOwnerInput
    brandId: ID
    tags: [String!]
    skipAssignee: Boolean
  ): TicketFetch!
  recordArticleView(
    brandId: ID!
    articleId: ID!
    locale: String!
    lastSearch: LastSearchInput
  ): String
  recordArticleFeedbackEvent(articleId: ID!, ticketId: ID!, locale: String!): Event!
  recordArticleRequestEvent(ticketId: ID!, requestTicketId: ID!): Event!
  recordPostView(postId: ID!, lastSearch: LastSearchInput): String
  createContentPin(ticketId: ID!, contentId: ID!, contentType: String!, locale: String): ContentPin!
  deleteContentPin(remoteId: ID!): ContentPin!
  generativeAnswerFeedback(
    searchId: String!
    isHelpful: Boolean!
    channel: String!
    feedbackCategory: String
    textFeedback: String
    ticketId: ID
  ): String
