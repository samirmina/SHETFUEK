  recommendations(locations: $locations, maxCount: $maxCount) {
    topBar {
      ...AppMarketAppInfo
    }
    navBar {
      ...AppMarketAppInfo
    }
    ticketSidebar {
      ...AppMarketAppInfo
    }
    newTicketSidebar {
      ...AppMarketAppInfo
    }
    userSidebar {
      ...AppMarketAppInfo
    }
    organizationSidebar {
      ...AppMarketAppInfo
    }
    background {
      ...AppMarketAppInfo
    }
    chatSidebar {
      ...AppMarketAppInfo
    }
    modal {
      ...AppMarketAppInfo
    }
    ticketEditor {
      ...AppMarketAppInfo
    }
    systemTopBar {
      ...AppMarketAppInfo
    }
    customObjectRecordSidebar {
      ...AppMarketAppInfo
    }
  }
}

fragment AppMarketAppInfo on AppMarketApp {
  id
  name
  logo
  installUrl
  detailsUrl
  paid
  description
  rating {
    totalCount
    average
  }
  plan {
    amount
    planType
  }
}
