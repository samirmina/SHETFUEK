  updated_at: String
}

type FacetTypes {
  article: Int
  group: Int
  organization: Int
  ticket: Int
  user: Int
  side_conversation: Int
}

type FacetCounts {
  type: FacetTypes
}

type SearchBox {
  results: [ResultType]
  facets: FacetCounts
  highlights: Highlights
  users: [UserType]
  organizations: [OrganizationType]
  groups: [GroupType]
  next_page: String
  previous_page: String
  count: Int
}

type SearchResultColumn {
  id: ID
  sortable: Boolean
  title: String
  type: String
}

type TicketsResultRowComment {
  author: String
  authorPhoto: String
  authorRole: String
  body: String
  createdAt: String
  id: ID!
  isPublic: Boolean
}

type TicketsResultRow {
  createdAt: String
  customStatus: CustomStatus
  description: String
  group: String
  id: ID!
  isSelectable: Boolean
  requester: String
  status: String
  subject: String
  subjectTooltip: String
  updatedAt: String
  photoRequester: String
  tags: [String]
