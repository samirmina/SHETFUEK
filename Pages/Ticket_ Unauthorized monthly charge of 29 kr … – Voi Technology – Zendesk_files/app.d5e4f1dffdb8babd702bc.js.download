}

type MacroDefinitionAction {
  title: String!
  type: String!
  subject: String!
  group: String
  repeatable: Boolean
  nullable: Boolean
  values: [ActionValues!]
}

extend type Query {
  macroDefinitions: [MacroDefinitionAction!]
