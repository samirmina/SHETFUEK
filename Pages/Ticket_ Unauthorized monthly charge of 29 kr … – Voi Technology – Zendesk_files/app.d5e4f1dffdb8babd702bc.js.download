      actorType
      timestamp
      ... on ChatMessageEvent {
        actorId
        actorSupportId
        actorDisplayName
        message
        messageSource
        messageId
        index
        optimisticUpdate @client {
          isOptimistic @client
          status @client
          timestamp @client
        }
        translation {
          message
        }
      }
      ... on ChatJoinEvent {
        actorId
        actorSupportId
        actorDisplayName
      }
      ... on ChatLeaveEvent {
        actorId
        actorSupportId
        actorDisplayName
      }
      ... on ChatFileEvent {
        actorId
        actorSupportId
        actorDisplayName
        messageId
        messageSource
        mimeType
        filename
        url
        index
        supportAttachmentId
      }
      ... on ChatRatingEvent {
        actorId
        actorDisplayName
        newRating
        oldRating
      }
      ... on ChatRatingCommentEvent {
        actorId
        actorDisplayName
        comment
      }
      ... on ChatRequestRatingEvent {
        actorId
        actorSupportId
        actorDisplayName
      }
      ... on ChatNameChangeEvent {
        actorId
        actorSupportId
        actorDisplayName
        userNewDisplayName
        userOldDisplayName
      }
      ... on ChatEmailChangeEvent {
        actorId
        actorSupportId
        actorDisplayName
        userNewEmail
        userOldEmail
      }
      ... on ChatDepartmentTransferEvent {
        actorId
        actorSupportId
        actorDisplayName
        departmentName
      }
      ... on ChatMessageStatusEvent {
        statusTimestamp
        messageStatus
        parentMessageIndex
      }
    }
  }
}
