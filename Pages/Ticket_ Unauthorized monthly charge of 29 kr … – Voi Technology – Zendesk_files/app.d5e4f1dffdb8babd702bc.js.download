nnel.conversation.translation_toggle_show_in_language":"Show message in {{language}}","txt.omnichannel.conversation.translation_retry_button":"Retry translation","txt.omnichannel.conversation.translation_retry_button2":"Retry","txt.omnichannel.conversation.translation_error":"Message couldn't be translated","txt.omnichannel.conversation.translation_translating":"Translating...","txt.omnichannel.conversation.translation_translating2":"Translating","txt.omnichannel.conversation.translation_ai_indicator":"Translated to {{locale}} by AI.","txt.omnichannel.conversation_translator_detected_language":"Detected language {{language}}","txt.omnichannel.send_in_language.label":"Send in {{language}}","txt.omnichannel.conversation_translator_translating_messages_from":"Translating messages from {{language}}","txt.omnichannel.conversation_translator_start_translate":"Translate","txt.omnichannel.conversation_translator_stop_translate":"Stop","txt.omnichannel.conversation_translator_select_language":"Select a language to translate","txt.omnichannel.conversation_translator_no_results":"No results","txt.omnichannel.conversation.tooltip.translated_by_ai":"Translated by AI","txt.omnichannel.conversation.tooltip.translation_error":"Translation failed","txt.ask.focus_mode_modal.header":"Introducing Focus mode","txt.ask.focus_mode_modal.description.first":"Focus mode prevents agents in a Chat or Talk conversation from being routed any incoming chats or calls until their current conversation is over.","txt.ask.focus_mode_modal.disabled.header":"Disabled","txt.ask.focus_mode_modal.disabled.description":"Agents with active live conversations get incoming chats or calls","txt.ask.focus_mode_modal.enabled.header":"Enabled","txt.ask.focus_mode_modal.enabled.description":"Agents with active live conversations don't get incoming chats or calls","txt.ask.focus_mode_modal.description.second":"This lets agents focus on the conversation at hand before moving on to the next one. Agents still receive incoming chats up to the max chat limit.","txt.ask.focus_mode_modal.configure_chat_limits_link":"https://support.zendesk.com/hc/en-us/articles/360022366213-Setting-up-chat-routing#topic_dlr_wt1_q5","txt.ask.focus_mode_modal.configure_chat_limits_text":"Modify chat limit settings","txt.ticket.show.email.blocklisted_cc.label":'User "{{requester}}" is blocklisted and cannot be added as an email CC.',"txt.ticket.show.email.blocklisted_follower.label":'User "{{requester}}" is blocklisted and cannot be added as a follower.',"txt.support_suite_trial_refresh.sample_ticket_creator.next":"Next","txt.support_suite_trial_refresh.sample_ticket_creator.role_description.context":"We want to show you the basics of how to use Zendesk, so let's kick things off with a sample request email from a customer. You're going to be The Agent.","txt.support_suite_trial_refresh.sample_ticket_creator.role_description.dont_worry":"We'll guide you every step of the way. It'll be easy. Promise.","txt.support_suite_trial_refresh.sample_ticket_creator.welcome.prompt":"Welcome to Zendesk, the place where customer experience dreams come true.","txt.support_suite_trial_refresh.sample_ticket_creator.welcome.skip":"Skip","txt.support_suite_trial_refresh.sample_ticket_creator.email.send":"Send","txt.support_suite_trial_refresh.sample_ticket_creator.email.tooltip":"Sometimes customers have urgent requests. Let's see how this works out.","txt.support_suite_trial_refresh.sample_ticket_walk_through.chat_context_1":"Hey there,","txt.support_suite_trial_refresh.sample_ticket_walk_through.chat_context_2":"Sure thing, we'll get on that right away. No need to worry. You're in good hands.","txt.support_suite_trial_refresh.sample_ticket_walk_through.chat_context_3":"Cheers,","txt.support_suite_trial_refresh.sample_ticket_walk_through.chat_context_4":"The Agent","txt.support_suite_trial_refresh.sample_ticket_walk_through.tooltip.nav":"This is Zendesk. All requests end up right here. We call them tickets.","txt.support_suite_trial_refresh.sample_ticket_walk_through.tooltip.chat_body":"Here’s what customer conversations look like. Whether it’s email, chat, voice, or social messaging, it’s all front and center.","txt.support_suite_trial_refresh.sample_ticket_walk_through.tooltip.reply_body":"This is where you respond to the customer. Normally, you’d have to do this part on your own. For this sample request, we have a response ready to go. Keep going to see what happens next.","txt.support_suite_trial_refresh.sample_ticket_walk_through.tooltip.submit":"To send your response, just submit the ticket. You can always categorize messages for follow-up.","txt.support_suite_trial_refresh.sample_ticket_walk_through.tooltip.success":"Success. Your response went through and will appear here, so you have a single view of the entire conversation from start to finish.","txt.support_suite_trial_refresh.sample_ticket_walk_through.congrats_modal.title":"Congrats, you just solved your first request","txt.support_suite_trial_refresh.sample_ticket_walk_through.congrats_modal.context":"See, we told you this would be easy. But this is just the beginning of what Zendesk has to offer. Let’s keep going and get you all set up.","txt.support_suite_trial_refresh.sample_ticket_creator.email.to":"To: support@{{subdomain}}.zendesk.com","txt.support_suite_trial_refresh.sample_ticket_creator.email.from":"From: {{email}}","txt.suite_trial.simplified_getting_started.channels_card.header":"Help your customers on any channel","txt.suite_trial.simplified_getting_started.channels_card.updated_sub_header":"These are some of the capabilities included in Zendesk.","txt.suite_trial.simplified_getting_started.channels_card.ticketing_header":"Ticketing system","txt.suite_trial.simplified_getting_started.channels_card.ticketing_description":"Deliver support everywhere, all from one place.","txt.suite_trial.simplified_getting_started.channels_card.chat_header":"Live chat and messaging","txt.suite_trial.simplified_getting_started.channels_card.chat_description":"Meet customers across web, mobile, and social.","txt.suite_trial.simplified_getting_started.channels_card.voice_header":"Integrated voice software","txt.suite_trial.simplified_getting_started.channels_card.voice_description":"Sometimes talking it out solves the problem fastest.","txt.suite_trial.simplified_getting_started.channels_card.guide_header":"Help center","txt.suite_trial.simplified_getting_started.channels_card.guide_description":"A smart knowledge base for better self-service.","txt.suite_trial.simplified_getting_started.ticketing_card.header":"See how ticketing works","txt.suite_trial.simplified_getting_started.ticketing_card.cta":"Take a tour","txt.suite_trial.simplified_getting_started.ticketing_card.skip":"Skip tour and go to setup","txt.suite_trial.simplified_getting_started.ticket_tour.step_one.header":"A single screen overview","txt.suite_trial.simplified_getting_started.ticket_tour.step_one.description":"All customer service tickets end up right here. It's a good place for agents to see the big picture and start their day.","txt.suite_trial.simplified_getting_started.ticket_tour.step_two.header":"All channels in one place","txt.suite_trial.simplified_getting_started.ticket_tour.step_two.description":"Here's what customer conversations look like. Whether it's email, chat, voice, or social messaging, it's all front and center.","txt.suite_trial.simplified_getting_started.ticket_tour.step_three.header":"Choose the right channel for your customer","txt.suite_trial.simplified_getting_started.ticket_tour.step_three.description":"Agents choose the channel best for responding. Or leave an internal note for your team members.","txt.suite_trial.simplified_getting_started.ticket_tour.step_four.header":"Make it official","txt.suite_trial.simplified_getting_started.ticket_tour.step_four.description":"Submit the ticket response and define its status. Tickets can be open, solved/closed, or something in between.","txt.suite_trial.getting_started.ticket_tour.step_five.description.first.cts":"Submit the ticket by defining its status as open, solved, or something in between. Or use a custom status that aligns to your workflow.","txt.suite_trial.getting_started.ticket_tour.step_five.description.second.cts":"To create a custom status, go to {{boldText}} in the {{link}}.","txt.suite_trial.getting_started.ticket_tour.step_five.objects_and_rules.second.cts":"Objects and Rules","txt.suite_trial.getting_started.ticket_tour.step_five.description.placeholder":"{{firstParagraph}} {{secondParagraph}}","txt.suite_trial.getting_started.ticket_tour.step_five.admin_center.second.cts":"Admin Center","txt.suite_trial.simplified_getting_started.ticket_tour.button.go_to_setup":"Go to setup","txt.suite_trial.simplified_getting_started.alt_text.balloons":"Customer service agent wearing a headset and sitting at a desk as balloons float through the air in celebration.","txt.suite_trial.simplified_getting_started.alt_text.ticketing":"Example of email conversation inside of the ticketing system and the customer is asking the agent about reimbursement policy.","txt.suite_trial.simplified_getting_started.alt_text.chat":"Example of conversation inside of messaging and the customer is asking the agent about changing the size of the retail order.","txt.suite_trial.simplified_getting_started.alt_text.voice":"Example of how the agent accepts an incoming phone call as well as how to log the details of the call.","txt.suite_trial.simplified_getting_started.alt_text.guide":"Example of a help center article.","txt.suite_trial.simplified_getting_started.alt_text.ticket_tour":"Example of agent looking at a customer’s profile and responding to via email.","txt.comment.omniredaction.menu.label":"Redact","txt.comment.omniredaction.menu.redact_message":"Redact message","txt.comment.omniredaction.richtext.redact.message.confirmation.modal.title":"Redact message","txt.comment.omniredaction.richtext.redact.message.confirmation.modal.description":"The entire message will be permanently redacted. Partial redaction isn't available for this message type.","txt.comment.omniredaction.richtext.redact.message.confirmation.modal.redact.button":"Redact message","txt.comment.omniredaction.richtext.redact.message.confirmation.modal.redact.cancel":"Cancel","txt.comment.omniredaction.menu.open_redaction_editor":"Mark text for redaction","txt.comment.omniredaction.composer.cancel":"Cancel","txt.comment.omniredaction.composer.redact":"Redact","txt.call_console.agent_status_dropdown.aria_label":"Agent status dropdown","txt.call_console.agent_status_dropdown.aria_field_label":"Status","txt.call_console.call_via_dropdown.aria_label":"Call via dropdown","txt.comment.omniredaction.composer.add_redaction":"Mark for redaction","txt.comment.omniredaction.composer.remove_redaction":"Unmark for redaction","txt.comment.omniredaction.composer.no_marked_content":"Mark content for redaction","txt.comment.omniredaction.successful":"Redaction successful","txt.comment.omniredaction.failure.title":"Redaction failed","txt.comment.omniredaction.failure.subtitle":"Wait a moment, then try again","txt.comment.omniredaction.composer.description":"Highlight text or select attachments then click on <b>Mark for redaction (Ctrl Shift Y)</b>. Redaction is not reversible.","txt.comment.omniredaction.composer.directions":"Highlight text or select attachments then click on <b>Mark for redaction (Enter)</b>. Redaction is not reversible","txt.omnichannel.attachments.redacted_attachment_thumbnail":"Attachment redacted","txt.omnichannel.attachments.redacted_inline_image_thumbnail":"Image redacted","txt.simplified_email_threading_onboarding.opt_in.confirmation.title":"Enable simplified email threading","txt.simplified_email_threading_onboarding.opt_in.confirmation.change_intro":"When you enable simplified email threading, the look and feel of your email notifications will change. Existing placeholders in your trigger and automation email notifications, plus any custom email HTML, will be replaced. You can always disable simplified email threading to get your original settings back.","txt.simplified_email_threading_onboarding.opt_in.confirmation.change_outro":"To see updates before switching over, download a list of changes to review.","txt.simplified_email_threading_onboarding.opt_in.confirmation.download":"Download list","txt.simplified_email_threading_onboarding.opt_in.confirmation.file_name":"simplified_email_threading_opt_in_affected_rules.zip","txt.simplified_email_threading_onboarding.opt_in.confirmation.button":"Enable","txt.simplified_email_threading_onboarding.opt_in.splash.title":"Enable simplified email threading","txt.simplified_email_threading_onboarding.opt_in.splash.description":"Get started","txt.simplified_email_threading_onboarding.opt_in.splash.info":"Improve your email experience with simplified email threading. With simplified formatting, it's easier to read through replies and get to the info you need fast.","txt.simplified_email_threading_onboarding.opt_in.splash.info_link_text_v2":"Learn about simplified email threading","txt.simplified_email_threading_onboarding.opt_in.splash.info_link":"https://support.zendesk.com/hc/en-us/articles/360056258994","txt.simplified_email_threading_onboarding.opt_in.splash.button":"Next","txt.simplified_email_threading_onboarding.opt_in.buttons.back":"Back","txt.simplified_email_threading_onboarding.opt_out.confirmation.title_v2":"Disable simplified email threading","txt.simplified_email_threading_onboarding.opt_out.confirmation.change_intro":"When you disable simplified email threading, the look and feel of your email will change. Any existing email settings you have for triggers and automations, plus any custom email HTML styles will be affected.","txt.simplified_email_threading_onboarding.opt_out.confirmation.change_body":"You can always enable simplified email threading again for a more streamlined experience.","txt.simplified_email_threading_onboarding.opt_out.confirmation.change_outro":"You can download a list of the changes to review before you switch back.","txt.simplified_email_threading_onboarding.opt_out.confirmation.download":"Download list","txt.simplified_email_threading_onboarding.opt_out.confirmation.file_name":"simplified_email_threading_opt_out_affected_rules.zip","txt.simplified_email_threading_onboarding.opt_out.confirmation.back":"Back","txt.simplified_email_threading_onboarding.opt_out.confirmation.button":"Disable","txt.simplified_email_threading_onboarding.opt_out.feedback.title_v2":"Disable simplified email threading","txt.simplified_email_threading_onboarding.opt_out.feedback.prompt":"Help us improve. Tell us what you think about simplified email threading.","txt.simplified_email_threading_onboarding.opt_out.feedback.button":"Submit feedback","txt.simplified_email_threading_onboarding.opt_out.buttons.back":"Back","txt.simplified_email_threading_onboarding.opt_out.buttons.skip":"Skip","txt.omnipanel.nav.aria-label":"Context Panel sidebar","txt.omnipanel.selector_tooltip.user_profile":"User profile","txt.omnipanel.selector_tooltip.customer_context":"Customer context","txt.omnipanel.selector_tooltip.customer_context_terminology":"{{zt.customer_singular}} context","txt.omnipanel.selector_tooltip.intelligence":"Intelligence","txt.omnipanel.selector_tooltip.knowledge":"Knowledge","txt.omnipanel.selector_tooltip.merge_suggestions":"Merge suggestions","txt.omnipanel.selector_tooltip.related_tickets":"Related tickets","txt.omnipanel.selector_tooltip.apps":"Apps","txt.omnipanel.onboarding.step_1.title":"Introducing the context panel","txt.omnipanel.onboarding.step_1.description":"A new way to see your apps and customer context","txt.omnipanel.onboarding.step_2.title":"Easy access to your favorite tools","txt.omnipanel.onboarding.step_2.description":"Open and close the panel from the context bar","txt.omnipanel.onboarding.step_2.description_v2":"Open and close sections in the context panel","txt.omnipane