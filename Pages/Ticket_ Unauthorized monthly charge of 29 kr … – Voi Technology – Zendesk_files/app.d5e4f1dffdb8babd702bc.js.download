            userOldDisplayName
          }
          ... on ChatEmailChangeEvent {
            actorId
            actorDisplayName
            userNewEmail
            userOldEmail
          }
          ... on ChatDepartmentTransferEvent {
            actorId
            actorDisplayName
            departmentName
          }
        }
      }
    }
  }
}
