  requirements: [String]
}

type SuccessResponse {
  success: Boolean!
}

type ErrorDetails {
  base: [ErrorMessage]
  password: [ErrorMessage]
}

type ErrorMessage {
  description: String!
}

type ErrorResponse {
  details: ErrorDetails
  message: String
}

type SuccessErrorResponse {
  success: Boolean!
  error: ErrorResponse
}

type OneTimePassword {
  provisioning_url: String
  secret_key: String
}

type ConfigureTwoFactorAuthenticationResponse {
  one_time_password: OneTimePassword
}

input ChangePasswordInput {
  id: ID!
  currentPassword: String!
  newPassword: String!
}

extend type Mutation {
  changePassword(user: ChangePasswordInput!): SuccessErrorResponse
}

input ConfigureTwoFactorAuthenticationInput {
  timeBased: Boolean
  force: Boolean
}

extend type Mutation {
  configureTwoFactorAuthentication(
    settings: ConfigureTwoFactorAuthenticationInput!
  ): ConfigureTwoFactorAuthenticationResponse
}

input DeleteUserInput {
  id: ID!
}

extend type Mutation {
  deleteUser(user: DeleteUserInput!): User
}

input PasswordRequirementsInput {
  id: ID!
}

extend type Query {
  passwordRequirements(user: PasswordRequirementsInput!): PasswordRequirements
}

input RemovePhotoInput {
  id: ID!
}

extend type Mutation {
  removePhoto(photo: RemovePhotoInput!): SuccessResponse
}

extend type Mutation {
  resetPassword(userId: ID!, brandId: ID): SuccessErrorResponse
}

input SendTwoFactorAuthenticationSmsCodeInput {
  timeBased: Boolean!
  force: Boolean!
  phone: String!
}

extend type Mutation {
  sendTwoFactorAuthenticationSmsCode(
    settings: SendTwoFactorAuthenticationSmsCodeInput!
  ): SuccessErrorResponse
}

input SetPasswordInput {
  id: ID!
  newPassword: String!
}

extend type Mutation {
  setPassword(user: SetPasswordInput!): SuccessErrorResponse
}

input SuspendUserInput {
  id: ID!
  suspended: Boolean!
}

extend type Mutation {
  suspendUser(user: SuspendUserInput!): User
}

input UpdateUserNameInput {
  id: ID!
  name: String!
}

extend type Mutation {
  updateUserName(user: UpdateUserNameInput!): User
}

input UploadPhotoInput {
  id: ID!
}

extend type Mutation {
  uploadPhoto(user: UploadPhotoInput!, file: Upload!): User
}

input VerifyTwoFactorAuthenticationInput {
  timeBased: Boolean
  force: Boolean
  code: String
}

extend type Mutation {
  verifyTwoFactorAuthentication(settings: VerifyTwoFactorAuthenticationInput!): SuccessErrorResponse
}
