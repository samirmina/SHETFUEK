  ticketForms {
    id
    ticketFields {
      id
      isRequiredForAgent
    }

    agentConditions {
      parentField {
        id
        __typename
      }

      childFields {
        ticketField {
          id
        }
        ... on AgentConditionChild {
          requiredOnStatuses {
            ... on RequiredOnSomeStatuses {
              statuses
              customStatuses
            }
          }
        }
      }

      ... on TicketFormDropdownCondition {
        selectedOption {
          value
          isValid
          customFieldOption {
            id
            name
            value
          }
        }
      }
      ... on TicketFormPriorityCondition {
        priority {
          name
          value
        }
      }
      ... on TicketFormTicketTypeCondition {
        ticketType {
          name
          value
        }
      }
      ... on TicketFormCheckboxCondition {
        isChecked
      }
      ... on TicketFormTextCondition {
        text
      }
      ... on TicketFormMultilineCondition {
        paragraph
      }
    }
  }
}
