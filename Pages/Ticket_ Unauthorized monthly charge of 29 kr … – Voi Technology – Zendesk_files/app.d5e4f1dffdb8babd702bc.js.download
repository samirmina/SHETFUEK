  globalNavigationOnboarding: Boolean
  globalNavProfileMenuStatusVisibility: Boolean
  apolloCacheGrowthMetrics: Boolean
  apolloCacheTracking: Boolean
  apolloCacheTrackerThresholdMedium: Boolean
  apolloCacheTrackerThresholdSmall: Boolean
  leakDetectionThresholdLarge: Boolean
  leakDetectionThresholdMedium: Boolean
  leakDetectionThresholdSmall: Boolean
