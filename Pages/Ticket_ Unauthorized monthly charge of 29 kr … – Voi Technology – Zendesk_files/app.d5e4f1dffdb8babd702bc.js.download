  unifiedNavigationAvailable: Boolean
  unifiedNavigationEapAccess: Boolean
  unifiedNavigationEapHideBannerForNonAdmins: Boolean
  unifiedNavigationFullRollout: Boolean
  unifiedNavigationShowGaComingBanner: Boolean
  temporaryCustomerContextFix: Boolean

  # Rollers
  editInternalNotes: Boolean

  # Hibiscus
  atMentionsPermissionsOptIn: Boolean
  aiAsyncCommentTranslations: Boolean
  aiTranslationsForMessaging: Boolean
  allowMacrosInHighAssistMode: Boolean
  allowMacrosInHighAssistModeWithHighAssistRecovery: Boolean
  assigneeNext: Boolean
  autoAssistPreapprovedAuditEvents: Boolean
  autoAssistPlanChangeAuditEvents: Boolean
  awaitConvologSubscription: Boolean
  collapsibleTicketFields: Boolean
  convertMarkdownOnPaste: Boolean
  convertSoftBreaksToParagraphs: Boolean
  composerReinitialize: Boolean
  convologPhishingFlags: Boolean
  copilotAwaitSubscription: Boolean
  copilotDoubleApprovalPrevention: Boolean
  copilotRichTextForAsyncTickets: Boolean
  copilotRichTextForSuncoTickets: Boolean
  copilotTranslationsForZaf: Boolean
  correctedSuggestedReplyRendering: Boolean
  darkModePreStyledEmail: Boolean
  enableDebugLoggingTags: Boolean
  enhanceWritingSubscriptions: Boolean
  eventLogMessagingTriggers: Boolean
  excludeFromTicketConversationMetrics: Boolean
  hideServeChatButton: Boolean
  macroPreviewFixedCommentField: Boolean
  messagingSubscriptionActorAutoResubErrorReconnect: Boolean
  omnicomposerTableButton: Boolean
  preAgentTickets: Boolean
  preventDuplicatePlans: Boolean
  preventNewLinesToParagraphsInMacros: Boolean
  refetchCopilotStateWhenToggling: Boolean
  richTextForZafSendMessage: Boolean
  richTextSuncoMessaging: Boolean
  selectInternalNoteChannelForPrivateTickets: Boolean
  spellChecker: Boolean
  suggestedReplies: Boolean
  suspenseSelectors: Boolean
  textareaOmnicomposer: Boolean
  ticketCommentFlagsHigherPlacement: Boolean
  tightenTicketIdType: Boolean
  showOutboundTranslationByDefault: Boolean

  # Pingu
  allMetricsSentToDatadogRum: Boolean

  # Flamingo
  activeTicketTimeTracking: Boolean
  agentHomeKillswitch: Boolean
  approvalsAgentHomeSplitView: Boolean
  bookMeetingBannerEnterprise: Boolean
  dashboardFilterCountSync: Boolean
  splitView: Boolean
  splitViewApps: Boolean
  splitViewCardChanges: Boolean
  splitViewContextPanel: Boolean
  splitViewEap: Boolean
  splitViewEapEligible: Boolean
  splitViewEditorApps: Boolean
  splitViewFeedbackBanner: Boolean
  splitViewInstrumentation: Boolean
  splitViewNewSubNavItems: Boolean
  splitViewReadReceipt: Boolean
  splitViewRealtimeConnectionBanner: Boolean
  splitViewRedirect: Boolean
  splitViewUnifiedWorkItemCards: Boolean
  splitViewWorkItemFirst: Boolean

  # EAP framework
