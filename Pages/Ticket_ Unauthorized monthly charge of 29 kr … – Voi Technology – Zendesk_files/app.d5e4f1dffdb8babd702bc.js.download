enum MalwareScanResult {
  not_scanned
  malware_found
  malware_not_found
  failed_to_scan
}

"""
Input for updating an Attachment Access Override.
"""
input SetMalwareAccessOverrideInput {
  """
  ID automatically assigned when created
  """
  attachmentId: ID!
  """
  Value \`false\`: access Restricted. Value \`true\`: access allowed
  """
  allowOverride: Boolean!
}

extend type Mutation {
  """
  Updates the access to an attachment with malware.
  """
  setMalwareAccessOverride(input: SetMalwareAccessOverrideInput!): AuditAttachment
}
