me:{kind:"Name",value:"scChannel"},arguments:[],directives:[]}]}}]}}]}}]}}],loc:{start:0,end:1797}};function n(e,t){if("FragmentSpread"===e.kind)t.add(e.name.value);else if("VariableDefinition"===e.kind){var i=e.type;"NamedType"===i.kind&&t.add(i.name.value)}e.selectionSet&&e.selectionSet.selections.forEach(function(e){n(e,t)}),e.variableDefinitions&&e.variableDefinitions.forEach(function(e){n(e,t)}),e.definitions&&e.definitions.forEach(function(e){n(e,t)})}t.loc.source={body:`query macroPreviewQuery($macroId: ID!, $ticketId: ID) {
  macroPreview(id: $macroId, ticketId: $ticketId) {
    id
    title
    description
    attachments {
      ... on Attachment {
        contentType
        contentUrl
        createdAt
        filename
        size
      }
      ... on FailedAttachment {
        reason
      }
    }
    fieldActions {
      ... on TextField {
        label
        textValue: value
        valid
      }
      ... on TagsField {
        label
        tags
      }
      ... on CCField {
        label
        # TODO: check if \`id\` field is queriable / valid and include it below
        # eslint-disable-next-line @graphql-eslint/require-id-when-available
        ccs {
          avatar
          name
        }
      }
      ... on FollowerField {
        label
        # TODO: check if \`id\` field is queriable / valid and include it below
        # eslint-disable-next-line @graphql-eslint/require-id-when-available
        followers {
          avatar
          name
        }
      }
      ... on StatusField {
        status
        icon
        className
        label
      }
      ... on CheckboxField {
        label
        isChecked: value
      }
    }
    bodyActions {
      ... on GenericCommentField {
        isPublic
        text
        htmlText
      }
      ... on CommentField {
        text
        isPublic
        renderedText
      }
      ... on RichCommentField {
        text
        isPublic
        renderedText
      }
      ... on TextField {
        label
        textValue: value
        valid
      }
      ... on SideConversationField {
        label
        body
        scSubject
        scRecipients
      }
      ... on SideConversationSlackField {
        label
        body
        scChannel
      }
    }
  }
}
