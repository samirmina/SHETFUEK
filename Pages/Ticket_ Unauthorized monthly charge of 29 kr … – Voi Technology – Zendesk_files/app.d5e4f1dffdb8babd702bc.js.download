oarding_v2.chat_task_subhead_link":"set up your Web Widget","txt.suite.onboarding_v2.chat_task_button":"Open Chat","txt.suite.onboarding_v2.talk_task_title":"Talk","txt.suite.onboarding_v2.talk_task_headline":"Your Talk number is {{customerPhoneNumber}}","txt.suite.onboarding_v2.talk_task_subhead":"You're all set to start receiving calls. In the meantime, {{link}}, or add Talk to your widget.","txt.suite.onboarding_v2.talk_task_subhead_link":"peruse the settings","txt.suite.onboarding_v2.talk_task_subhead_no_number":"You're almost set to start receiving calls. {{link}} and add Talk to your widget.","txt.suite.onboarding_v2.talk_task_subhead_select_number":"Select a phone number","txt.suite.onboarding_v2.talk_next_steps":"Next steps","txt.suite.onboarding_v2.talk_widget":"Enable Talk on the Web Widget","txt.suite.onboarding_v2.talk_settings":"Manage Talk settings","txt.suite.onboarding_v2.talk_dashboard":"Check out Talk dashboard","txt.suite.onboarding_v2.talk_task_button":"Open Talk","txt.suite.onboarding_v2.guide_task_title":"Guide","txt.suite.onboarding_v2.guide_task_headline":"Your Help Center is at {{customerURL}}","txt.suite.onboarding_v2.guide_task_subhead":"You can update the look and feel of your Help Center at any time. Use logos and images that your customers will recognize.","txt.suite.onboarding_v2.guide_hero":"1. Hero image","txt.suite.onboarding_v2.guide_logo":"2. Logo","txt.suite.onboarding_v2.guide_color":"3. Colors","txt.suite.onboarding_v2.guide_preview_desc":"Here's a preview of your Help Center. You can continue to {{link}}","txt.suite.onboarding_v2.guide_preview_link":"customize the theme","txt.suite.onboarding_v2.guide_task_button_build":"Build Help Center","txt.suite.onboarding_v2.guide_task_button_open":"Open Help Center","txt.admin.shared_components.editable_header.tooltip":"Edit","txt.admin.shared_components.navigation_header.go_back_aria_label":"Go back","txt.support_suite_trial_refresh.nav.welcome":"Welcome","txt.support_suite_trial_refresh.nav.welcome_descriptive_text":"Experience The Support Suite","txt.support_suite_trial_refresh.welcome_task.welcome_screen_descriptive":"The Support Suite is everything you need to provide omnichannel support.","txt.support_suite_trial_refresh.welcome_task.welcome_product_list":"You'll quickly see how Support, Guide, Chat, and Talk work together to help make customers and businesses happy.","txt.support_suite_trial_refresh.welcome_task.support_suite":"Learn about setting up {{link}}","txt.support_suite_trial_refresh.welcome_task.support_suite_link":"The Support Suite","txt.support_suite_trial_refresh.welcome_task.support_suite_link_url":"https://support.zendesk.com/hc/en-us/articles/360022372273","txt.support_suite_trial_refresh.welcome_task.video_link":"Watch video","txt.support_suite_trial_refresh.welcome_task.alt_support_suite_logo":"Logo for Zendesk Support Suite","txt.support_suite_trial_refresh.welcome_task.alt_video_thumbnail":"Video thumbnail with colorful letters spelling omnichannel","txt.support_suite_trial_refresh.support_task.cta_bar.button.support_address":"Add support address","txt.support_suite_trial_refresh.guide_onboarding_task.upload_or_choose":"{{file}} or choose from {{template}}.","txt.support_suite_trial_refresh.guide_onboarding_task.your_hero_image":"Upload your hero image","txt.support_suite_trial_refresh.guide_onboarding_task.your_logo":"Upload your logo","txt.support_suite_trial_refresh.chat_task.agent":"Agent","txt.support_suite_trial_refresh.chat_task.via_chat":"via chat","txt.support_suite_trial_refresh.chat_task.conversation_with":"Conversation with {{visitor_name}}","txt.support_suite_trial_refresh.onboarding_set_up.nav.welcome":"See how Support Suite works","txt.support_suite_trial_refresh.onboarding_set_up.nav.support":"Connect with customers","txt.support_suite_trial_refresh.onboarding_set_up.nav.team":"Set up your team","txt.support_suite_trial_refresh.onboarding_set_up.nav.progress_bar_total_progress":"Total progress:","txt.support_suite_trial_refresh.onboarding_set_up.nav.progress_bar_descriptive_text":"{{total_progress}} {{completed}}/4 complete","txt.support_suite_trial_refresh.onboarding_set_up.nav.progress_bar_descriptive_text_v2":"{{total_progress}} {{completed}}/{{total}} complete","txt.support_suite_trial_refresh.onboarding_set_up.section.estimate_time":"{{section_title}} ({{minute}} min)","txt.support_suite_trial_refresh.onboarding_set_up.welcome_section.title":"Welcome to Zendesk","txt.support_suite_trial_refresh.onboarding_set_up.welcome_section.subhead":"Here are 4 steps to get you started","txt.support_suite_trial_refresh.onboarding_set_up.welcome_section.paragraph_3":"Better customer support awaits you.","txt.support_suite_trial_refresh.onboarding_set_up.welcome_section.cta":"Get started","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.address_task.title":"Get your built-in support email address and phone number","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.address_task.your_address_no_brackets":"Your support address is {{support_address}}","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.address_task.your_phone_no_brackets":"Your support phone number is {{phone_number}}","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.address_task.choose_phone_text":"Go to settings to choose your phone number","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.address_task.choose_phone_text_v2":"Go to Admin Center to choose your phone number","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.address_task.note":"You can keep it or choose a new one after you buy the Support Suite.","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.address_task.note_v2":"You can keep this phone number, choose a new one, or forward an existing number after you buy.","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.email_task.title":"Create your own support email address","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.email_task.cta":"Create support email address","txt.support_suite_trial_refresh.onboarding_set_up.email_validation.empty_error":"Enter email name","txt.support_suite_trial_refresh.onboarding_set_up.email_validation.exist_error":"Email already exists. Try another one.","txt.support_suite_trial_refresh.onboarding_set_up.email_validation.server_error":"There’s a server error. Try again in a moment.","txt.support_suite_trial_refresh.onboarding_set_up.email_validation.invalid_error":"Invalid email. Try another one.","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.email_task.add_email_modal.title":"Create a new support email address","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.email_task.add_email_modal.paragraph":"Create different email addresses for popular requests. It helps get tickets to the right people with the right answers.","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.email_task.add_email_modal.hint":"Try info, sales, jobs, or hello","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.email_task.success_email_modal.title":"Support email address created","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.email_task.success_email_modal.paragraph_no_bracket":"{{email}} is ready to use","txt.support_suite_trial_refresh.onboarding_set_up.support_section.basic.email_task.success_email_modal.cta":"Create address","txt.support_suite_trial_refresh.onboarding_set_up.support_section.advance.existing_address_task.title":"Forward an existing email address","txt.support_suite_trial_refresh.onboarding_set_up.support_section.advance.existing_address_task.link_text":"Forward existing email","txt.support_suite_trial_refresh.onboarding_set_up.support_section.advance.existing_address_task.link_url":"https://support.zendesk.com/hc/en-us/articles/203663266","txt.support_suite_trial_refresh.onboarding_set_up.support_section.advance.live_chat_task.title":"Set up live chat","txt.support_suite_trial_refresh.onboarding_set_up.support_section.advance.live_chat_task.cta":"Set up live chat web widget","txt.support_suite_trial_refresh.onboarding_set_up.support_section.advance.social_messaging_task.title":"Add social messaging support","txt.support_suite_trial_refresh.onboarding_set_up.support_section.advance.social_messaging_task.paragraph":"Customers want to effortlessly talk to your business like they do with family and friends. Add social messaging support for quick answers through their favorite messaging apps, including WhatsApp, Facebook Messenger, and X Corp Direct Messages.","txt.support_suite_trial_refresh.onboarding_set_up.support_section.advance.social_messaging_task.link_text":"Add social messaging support","txt.support_suite_trial_refresh.onboarding_set_up.support_section.advance.social_messaging_task.link_url":"https://support.zendesk.com/hc/en-us/articles/360048877154","txt.support_suite_trial_refresh.onboarding_set_up.support_section.notificaiton.title":"Support tasks completed","txt.support_suite_trial_refresh.onboarding_set_up.support_section.notificaiton.text":"Nicely done. You can start connecting with customers.","txt.support_suite_trial_refresh.onboarding_set_up.support_section.congrats":"Great work. Your customers can now connect with you wherever and whenever they need you.","txt.support_suite_trial_refresh.onboarding_set_up.team_section.paragraph":"Welcome to your workspace, where all customer details, conversations, and support tools come together in one place. It’s the solution for seamless, streamlined, and more personalized customer support. Productive days are here again.","txt.support_suite_trial_refresh.onboarding_set_up.team_section.agent_workspace_task.title":"See the conversation flow","txt.support_suite_trial_refresh.onboarding_set_up.team_section.agent_workspace_task.paragraph":"Say goodbye to multiple tabs and searching for customer information in different places. The agent workspace organizes conversations into one view, gives interaction history for fast context, and customer details for more personalized support.","txt.support_suite_trial_refresh.onboarding_set_up.team_section.agent_workspace_task.cta":"Tour Agent Workspace","suite_trial.sample_ticket_revamp.agent_workspace.no_ticket.description":"Agent Workspace organizes each customer's conversations into a single view along with their interaction history and profile details. Agents can help customers on chat, messaging, email and voice from a single support ticket.","suite_trial.sample_ticket_revamp.agent_workspace.no_ticket.article_link":"Learn about creating tickets","suite_trial.sample_ticket_revamp.agent_workspace.no_ticket.article_address":"https://support.zendesk.com/hc/en-us/articles/203691476","suite_trial.sample_ticket_revamp.agent_workspace.no_ticket.cta_button":"Next","txt.support_suite_trial_refresh.onboarding_set_up.team_section.add_members_task.title":"Add your team","txt.support_suite_trial_refresh.onboarding_set_up.team_section.add_members_task.paragraph":"To get your team on Zendesk, start by adding admins and agents. You’ll see how everyone plays a part in building a better customer experience.","txt.support_suite_trial_refresh.onboarding_set_up.team_section.add_members_task.agent_description":"Agents are assigned tickets, interact with customers, and resolve support issues","txt.support_suite_trial_refresh.onboarding_set_up.team_section.add_members_task.admin_description":"Admins set up channels you want to support, define new shared views, and manage users","txt.support_suite_trial_refresh.onboarding_set_up.team_section.add_members_task.email":"Email","txt.support_suite_trial_refresh.onboarding_set_up.team_section.add_members_task.role":"Role","txt.support_suite_trial_refresh.onboarding_set_up.team_section.add_members_task.agent":"Agent","txt.support_suite_trial_refresh.onboarding_set_up.team_section.add_members_task.admin":"Admin","txt.support_suite_trial_refresh.onboarding_set_up.team_section.add_members_task.cta":"Add team","txt.support_suite_trial_refresh.team_section.add_members_task.no_more_seats.header":"No more seats left","txt.support_suite_trial_refresh.team_section.add_members_task.no_more_seats.description":"You can add more team members after you buy","txt.support_suite_trial_refresh.onboarding_set_up.team_section.add_members.agent_status_task.title":"Manage conversations","txt.support_suite_trial_refresh.onboarding_set_up.team_section.add_members.agent_status_task.paragraph":"Now that you’ve added your agents, empower them to control their own workflow when supporting customers in real-time. Agents can choose when to receive or pause conversations, so they can help customers at the moment that’s right for them.","txt.support_suite_trial_refresh.onboarding_set_up.team_section.add_members.agent_status_task.cta":"See how to manage conversations","txt.support_suite_trial_refresh.onboarding_set_up.team_section.complete.paragraph":"Look at you go. You’re ready to tackle any request that comes your way.","txt.support_suite_trial_refresh.onboarding_set_up.team_section.email_sent.title":"Email invites sent","txt.support_suite_trial_refresh.onboarding_set_up.team_section.email_sent.text":"When accepted, they can access Zendesk","txt.support_suite_trial_refresh.onboarding_set_up.team_section.notificaiton.title":"Agent experience tasks completed","txt.support_suite_trial_refresh.onboarding_set_up.team_section.notificaiton.text":"You’re on a roll. Your team is now set up for success.","txt.support_suite_trial_refresh.onboarding_set_up.article_section.visit_task.learn_help_center.text":"Learn about setting up your help center","txt.support_suite_trial_refresh.onboarding_set_up.article_section.visit_task.learn_help_center.url":"https://support.zendesk.com/hc/en-us/articles/360052716394","txt.support_suite_trial_refresh.onboarding_set_up.article_section.visit_task.cta":"Visit help center","txt.support_suite_trial_refresh.onboarding_set_up.article_section.celebrate_section.title":"Nice work!","txt.support_suite_trial_refresh.onboarding_set_up.article_section.celebrate_section.paragraph":"You’ve got the basics of Support Suite, now it’s time to explore on your own.","txt.support_suite_trial_refresh.onboarding_set_up.article_section.celebrate_section.learn_text":"Take the next steps in customer support","txt.support_suite_trial_refresh.onboarding_set_up.article_section.celebrate_section.learn_url":"https://support.zendesk.com/hc/en-us/articles/360053763453","txt.support_suite_trial_refresh.onboarding_set_up.article_section.celebrate_section.launch_guide_text":"See the full Support Suite launch guide","txt.support_suite_trial_refresh.onboarding_set_up.article_section.celebrate_section.launch_guide_url":"https://support.zendesk.com/hc/en-us/articles/360022372273","txt.support_suite_trial_refresh.onboarding_set_up.article_section.notificaiton.title":"Self-service tasks completed","txt.support_suite_trial_refresh.onboarding_set_up.article_section.notificaiton.text":"Well done. You’ll be helping customers find what they need in no time.","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.chat_status.title":"Change status","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.chat_status.context":"To start receiving chats and calls, set your chat and phone status to online.","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.conversation_status.title":"Manage conversations","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.conversation_status_status.context":"Accept conversations to start connecting with customers","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.agent_tour.steps":"Step {{current}} of {{total}}","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.agent_tour.first.title":"Take the tour","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.agent_tour.first.context":"Welcome to the Agent Workspace. Before you start, know you can return to setup by selecting home.","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.agent_tour.second.title":"Unified conversation","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.agent_tour.second.context":"Unify support channels into one stream for faster replies and seamless wrap-up.","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.agent_tour.third.title":"Omnichannel composer","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.agent_tour.third.context":"Serve and respond to customers on their preferred channel. Seamlessly channel-switch without ending the conversation.","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.agent_tour.forth.title":"Essentials Card","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.agent_tour.forth.context":"See all relevant customer details like contact information and language, with the ability to add external profiles.","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.agent_tour.fifth.title":"Interaction history","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.agent_tour.fifth.context":"Gain visibility into all previous events and conversations with your customers, including those from external systems.","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.agent_tour.fifth.cta":"Return to setup","txt.support_suite_trial_refresh.onboarding_set_up.tooltip.guide.context":"To return to setup, go back to Support","txt.support_suite_trial_refresh.onboarding_set_up.cta.next":"Next","txt.support_suite_trial_refresh.onboarding_set_up.cta.back":"Back","txt.support_suite_trial_refresh.onboarding_set_up.cta.done":"Done","txt.support_suite_trial_refresh.onboarding_set_up.cta.do_later":"Do this later","txt.support_suite_trial_refresh.onboarding_set_up.cta.mark_as_done":"Mark as done","txt.support_suite_trial_refresh.onboarding_set_up.cta.got_it":"Got it","txt.support_suite_trial_refresh.social_messaging.title":"Add social messaging support","txt.support_suite_trial_refresh.social_messaging.paragraph":"Connect with your customers on their favorite messaging apps like Facebook Messenger, WhatsApp, and X Corp Direct Messages. Add Facebook Messenger below and configure other messaging channels as you need them in {{admin_center}}","txt.support_suite_trial_refresh.social_messaging.admin_center_context":"Admin Center","txt.support_suite_trial_refresh.social_messaging.facebook_setup.title":"Start with Facebook Messenger","txt.support_suite_trial_refresh.social_messaging.facebook_setup.stepper.step_1.title":"Link Facebook account","txt.support_suite_trial_refresh.social_messaging.facebook_setup.stepper.step_1.paragraph":"Allow customers to request and receive support through Facebook Messenger. You need to be a Facebook page admin to link your Facebook page.","txt.support_suite_trial_refresh.social_messaging.facebook_setup.stepper.step_1.cta":"Continue with Facebook","txt.support_suite_trial_refresh.social_messaging.facebook_setup.stepper.step_2.title":"Choose Facebook page","txt.support_suite_trial_refresh.social_messaging.facebook_setup.stepper.step_2.cta":"Add channel","txt.support_suite_trial_refresh.social_messaging.facebook_setup.notification.success":"Channel added","txt.support_suite_trial_refresh.social_messaging.facebook_setup.notification.account_fail":"Account couldn’t be linked","txt.support_suite_trial_refresh.social_messaging.facebook_setup.notification.account_fail_context":"Try again to add support to a social channel.","txt.support_suite_trial_refresh.social_messaging.facebook_setup.notification.channel_fail_title":"Channel wasn’t added","txt.support_suite_trial_refresh.social_messaging.facebook_setup.notification.channel_fail_context":"Give it a moment and try again","txt.support_suite_trial_refresh.social_messaging.facebook_setup.notification.channel_fail_title_v2":"Select a Facebook page","txt.support_suite_trial_refresh.social_messaging.facebook_setup.notification.channel_fail_context_v2":"Link a Facebook page to add support to this social channel","txt.support_suite_trial_refresh.native_messaging.title":"Add messaging to your site","txt.support_suite_trial_refresh.native_messaging.paragraph_1":"Help customers reach you effortlessly by adding messaging to your web, mobile, and social channels. Web messaging makes it easy to have conversations instantly or over multiple days.","txt.support_suite_trial_refresh.native_messaging.paragraph_2":"After setting up messaging for your website with Web SDK, you can add more channels in the {{admin_center}}","txt.support_suite_trial_refresh.native_messaging.paragraph.admin_center":"Admin Center","txt.support_suite_trial_refresh.native_messaging.stepper.title":"Start with Web SDK","txt.support_suite_trial_refresh.native_messaging.stepper.step1.title":"Make it your own","txt.support_suite_trial_refresh.native_messaging.stepper.step1.description":"Style Web SDK to match your company’s brand colors.","txt.support_suite_trial_refresh.native_messaging.stepper.step1.customize_admin_center":"Customize more brand colors in Admin Center","txt.support_suite_trial_refresh.native_messaging.stepper.step2.title":"Embed Web SDK","txt.support_suite_trial_refresh.native_messaging.stepper.step2.description":"Copy and paste Web SDK code before the {{body_tag}} tag on each web page where you want it to appear.","txt.support_suite_trial_refresh.native_messaging.stepper.step2.email_cta":"Email the code to a developer","txt.support_suite_trial_refresh.native_messaging.preview.title":"Preview","txt.support_suite_trial_refresh.native_messaging.preview.chat_date_1":"Nov 17","txt.support_suite_trial_refresh.native_messaging.preview.chat_date_2":"Nov 19","txt.support_suite_trial_refresh.native_messaging.preview.chat_agent":"Agent","txt.support_suite_trial_refresh.native_messaging.preview.conversation.customer.context_1":"Hi, what’s the return policy for doggie halloween costumes?","txt.support_suite_trial_refresh.native_messaging.preview.conversation.customer.context_2":"Oh no, it’s 36 days. Can you help me?","txt.support_suite_trial_refresh.native_messaging.preview.conversation.agent.context_1":"Unworn and 30 days from the purchase date.","txt.support_suite_trial_refresh.native_messaging.preview.conversation.agent.context_2":"Sure, let’s take care of this.","txt.support_suite_trial_refresh.native_messaging.preview.conversation.placeholder":"Type a message","txt.support_suite_trial_refresh.native_messaging.error.color_not_add.title":"Color couldn’t be added.","txt.support_suite_trial_refresh.native_messaging.error.color_not_add.description":"Try again.","txt.support_suite_trial_refresh.native_messaging.error.snippet_not_load.title":"Could not load your code snippet.","txt.support_suite_trial_refresh.native_messaging.error.snippet_not_load.discription":"Refresh the page.","txt.support_suite_trial_refresh.native_messaging.mailto_popup.subject":"Code snippet for web messaging","txt.support_suite_trial_refresh.native_messaging.mailto_popup.body.paragraph":"Hi, we’re putting web messaging onto the site. Here’s the code. Thanks.","txt.support_suite_trial_refresh.native_messaging.codeblock_footer.hover_text":"Copy code","txt.support_suite_trial_refresh.native_messaging.codeblock_footer.copied_text":"Copied","txt.support_suite_trial.post_onboarding.welcome.tab":"Welcome to Zendesk","txt.support_suite_trial.post_onboarding.welcome.subhead":"Here are 3 steps to get you started","txt.support_suite_trial.post_onboarding.explore_more.tab":"Explore more","txt.support_suite_trial.post_onboarding.explore_more.title":"Explore more","txt.support_suite_trial.post_onboarding.ticketing.header":"Test out the ticketing system","txt.support_suite_trial.post_onboarding.ticketing.description":"Send an email to your support address {{email}} and see it automatically become a ticket.","txt.support_suite_trial.post_onboarding.ticketing.cta":"Send an email","txt.support_suite_trial.post_onboarding.launch.header":"See the full Support Suite launch guide","txt.support_suite_trial.post_onboarding.launch.description":"Get a full view of everything The Support Suite has to offer.","txt.support_suite_trial.post_onboarding.launch.view_guide_cta":"View the full Support Suite launch guide","txt.support_suite_trial.post_onboarding.launch.view_guide_url":"https://support.zendesk.com/hc/en-us/articles/360022372273","txt.support_suite_trial.post_onboarding.time_elapsed.early.header":"You're off to a great start","txt.support_suite_trial.post_onboarding.time_elapsed.early.description":"Keep an eye on your inbox for tips on how to make the most of your Support Suite trial.","txt.support_suite_trial.post_onboarding.time_elapsed.late.header":"Your free trial is expiring","txt.support_suite_trial.post_onboarding.time_elapsed.late.description":"When your trial ends, your data is safe and sound until you're ready to buy.","txt.support_suite_trial.post_onboarding.time_elapsed.trial_start":"Trial start","txt.support_suite_trial.post_onboarding.time_elapsed.trial_end":"Trial expires {{date}}","txt.support_suite_trial.post_onboarding.email.subject":"Sample email request","txt.support_suite_trial.post_onboarding.email.body":`Hi there.

Here’s an example of a customer request email. It’s addressed to your support address. After it’s sent, you’ll see it as a ticket in your Agent Workspace.

Send away and see the ticketing system in action.`,"txt.support_suite_trial.less_is_more.welcome_section.subhead":"Get up and running in 3 steps","txt.support_suite_trial.less_is_more.welcome_section.paragraph_1":"With Support Suite, you get an easy-to-use, scalable solution to deliver conversational experiences across any channel.","txt.support_suite_trial.less_is_more.welcome_section.paragraph_1_cta":"Learn about setting up Support Suite","txt.support_suite_trial.less_is_more.support_section.address_task.paragraph":"You have a support email address and phone number that are ready and waiting for you. Any customer email, call, or text becomes a ticket in your account automatically.","txt.support_suite_trial.less_is_more.support_section.email_task.paragraph_1":"Create email addresses to help get the right requests to the right teams for quicker answers.","txt.support_suite_trial.less_is_more.support_section.email_task.paragraph_2":"Popular addresses include {{email1}} or {{email2}}.","txt.support_suite_trial.less_is_more.support_section.optional_tasks.header":"More ways to connect","txt.support_suite_trial.less_is_more.support_section.optional_tasks.description":"Power up your customer service by adding more ways for customers to reach you.","txt.support_suite_trial.less_is_more.support_section.existing_address_task.description":"Keep any existing email addresses and forward them to Zendesk so all conversations are stored in one place.","txt.support_suite_trial.less_is_more.support_section.live_chat_task.description":"With a live chat Web Widget, customers get real-time help without leaving your website.","txt.support_suite_trial.less_is_more.team_section.agent_workspace_task.header":"Tour the Agent Workspace","txt.support_suite_trial.less_is_more.team_section.agent_workspace_task.description":"Your Agent Workspace organizes conversations into one view, gives interaction history for fast context, and customer details for more personalized support.","txt.support_suite_trial.less_is_more.team_section.add_members_task.description":"To get your team on Zendesk, start by adding admins and agents.","txt.support_suite_trial.less_is_more.team_section.agent_status_task.description":"Empower your team when supporting customers in real-time. Agents can choose when to receive or pause conversations, so they can help customers at the moment that’s right for them.","txt.support_suite_trial.less_is_more.article_section.nav":"Create a help center","txt.support_suite_trial.less_is_more.article_section.visit_task.header":"Set up self-service support","txt.support_suite_trial.less_is_more.article_section.visit_task.description":"Help your customers help themselves with a built-in help center. Add FAQs or migrate existing content for individual brands and products for customized support.","txt.support_suite_trial.celebration.support_section.complete.header":"Great work","txt.support_suite_trial.celebration.support_section.complete.description":"Your customers can now connect with you wherever and whenever they need you.","txt.support_suite_trial.celebration.team_section.complete.header":"Look at you go","txt.support_suite_trial.celebration.team_section.complete.description":"You're ready to tackle any request that comes your way.","txt.support_suite_trial.celebration.article_section.complete.header":"Well done","txt.support_suite_trial.celebration.article_section.complete.description":"Here's some extra credit for those high achievers.","txt.support_suite_trial.celebration.next_button":"Next","txt.support_suite_trial.celebration.done_button":"Done","txt.support_suite_trial.social_messaging.refresh_page_error":"Something went wrong. Try refreshing the page.","txt.support_suite_trial.social_messaging.duplicate_page_connection_error":"Page is associated with another Zendesk account","txt.dashboard_toggle_nav.zendesk_suite_product":"Zendesk Suite","txt.support_suite_trial.spp.welcome_section.paragraph_1.content":"Be where your customers are. Zendesk Suite easily delivers conversational experiences across any channel, plus it can support internal teams. And it can grow with your business to keep everything in sync. {{learn_about_link}}","txt.support_suite_trial.spp.welcome_section.paragraph_1.cta":"Learn about Zendesk Suite","txt.support_suite_trial.spp.welcome_section.cta":"Set up Zendesk","txt.support_suite_trial.spp.explore_more.ticketing.subheader":"Test how ticketing works","txt.support_suite_trial.spp.explore_more.ticketing.paragraph":"See how sending an email to your support account {{email_address}} automatically becomes a ticket.","txt.support_suite_trial.spp.explore_more.ticketing.cta":"Send test email","txt.support_suite_trial.spp.explore_more.suite.subheader":"Zendesk Suite has countless capabilities","txt.support_suite_trial.spp.explore_more.suite.paragraph":"See the big picture of everything Zendesk Suite has to offer. Bookmark this main menu to keep it at your fingertips. {{learn_about_link}}","txt.support_suite_trial.spp.explore_more.suite.cta":"Learn about Zendesk Suite","txt.support_suite_trial.spp.explore_more.progress_bar.trial_start":"Trial starts","txt.support_suite_trial.spp.support_section.title":"Connect all your conversations","txt.support_suite_trial.spp.support_section.address_task.header":"Get to know your account","txt.support_suite_trial.spp.support_section.address_task.paragraph_one":"Zendesk Suite turns all of your messaging, from customer chats and phone calls to social interactions and emails, into tickets. Customers don’t have to repeat issues and your agents have the full context as everyone can see the conversation history.","txt.support_suite_trial.spp.support_section.address_task.paragraph_two":"To help you get started, your support contact info is ready to use.","txt.support_suite_trial.spp.support_section.address_task.subheader":"Contact details","txt.support_suite_trial.spp.support_section.address_task.support_address":"Email address {{support_address}}","txt.support_suite_trial.spp.support_section.address_task.support_phone":"Phone number {{support_phone}}","txt.support_suite_trial.spp.support_section.address_task.footer":"Use this contact info or create custom emails in the next step. After you buy, you can choose a new local phone number or forward an existing one.","txt.support_suite_trial.spp.support_section.address_task.cta_button":"Next","txt.support_suite_trial.spp.support_section.email_task.header":"Create custom email addresses","txt.support_suite_trial.spp.support_section.email_task.paragraph_one":"Help get the right requests to the right teams for quicker answers with custom email addresses.","txt.support_suite_trial.spp.support_section.email_task.paragraph_two":"Popular emails include {{email1}} or {{email2}}.","txt.support_suite_trial.spp.support_section.email_task.cta_button":"Create email address","txt.support_suite_trial.spp.support_section.email_task.create_modal.description":"Using different email addresses for popular requests helps get tickets to specific teams.","txt.support_suite_trial.spp.support_section.email_task.success_modal.title":"Email address created","txt.support_suite_trial.spp.support_section.facebook_task.header":"Turn on support in social channels","txt.support_suite_trial.spp.support_section.facebook_task.paragraph_one":"Allow customers to request and receive support on the messaging apps they already use, such as Facebook Messenger, WhatsApp, and X Corp Direct Messages. As you need them, add social channels in {{admin_center}}","txt.support_suite_trial.spp.support_section.facebook_task.step_one.description":"To link the account, you’ll need to be an admin on your Facebook page.","txt.support_suite_trial.spp.support_section.facebook_task.step_one.cta_button":"Go to Facebook","txt.support_suite_trial.spp.support_section.facebook_task.step_two.header":"Select Facebook page","txt.support_suite_trial.spp.support_section.facebook_task.step_two.cta_button":"Add Facebook page","txt.support_suite_trial.spp.support_section.facebook_task.growls.success.description":"Support added to a new social channel.","txt.support_suite_trial.spp.support_section.facebook_task.growls.not_admin.header":"Ask an admin to link the account.","txt.support_suite_trial.spp.support_section.success_message.header":'Say "hello"',"txt.support_suite_trial.spp.support_section.success_message.description":"Get ready as your customers can now connect with you wherever and whenever.","txt.support_suite_trial.spp.team_section.agent_workspace_task.paragraph_one":"Agent Workspace organizes each customer’s conversations into a single view along with their interaction history and profile details. Having it all in one place helps agents provide personalized support.","txt.support_suite_trial.spp.team_section.add_members_task.paragraph_one":"To get your team on Zendesk Suite, start by adding agents and admins.","txt.support_suite_trial.spp.team_section.add_members_task.agent_item":"{{agents_role}} are assigned tickets, interact with customers, and resolve support issues.","txt.support_suite_trial.spp.team_section.add_members_task.agents_role":"Agents","txt.support_suite_trial.spp.team_section.add_members_task.admin_item":"{{admins_role}} set up channels you want to support, define new shared views, and manage users.","txt.support_suite_trial.spp.team_section.add_members_task.admins_role":"Admins","txt.support_suite_trial.spp.team_section.add_members_task.paragraph_two":"For the trial, add up to 4 agents or admins to see how Zendesk can work for your team.","txt.suite_trial.spp.team_section.add_members_task.paragraph_two":"For the trial, add up to 4 team members to see how Zendesk works for your business.","txt.support_suite_trial.spp.team_section.add_members_task.growls.success.header":"Team invites sent","txt.support_suite_trial.spp.team_section.add_members_task.growls.success.description":"Upon acceptance, team members can access Zendesk.","txt.support_suite_trial.spp.team_section.add_members_task.growls.seats_full.header":"All of your trial seats are taken","txt.support_suite_trial.spp.team_section.add_members_task.growls.seats_full.description":"You can swap out a team member or add more seats once you have a Zendesk subscription.","txt.support_suite_trial.spp.team_section.add_members_task.growls.not_enough_remaining_seats.plural_header":"{{remaining_seats_count}} trial seats remaining.","txt.support_suite_trial.spp.team_section.add_members_task.growls.not_enough_remaining_seats.singular_header":"{{remaining_seats_count}} trial seat remaining.","txt.support_suite_trial.spp.team_section.add_members_task.growls.not_enough_remaining_seats.description":"You can swap out a team member or add more seats once you have a Zendesk subscription.","txt.support_suite_trial.spp.team_section.add_members_task.error_message.no_address":"Enter email address.","txt.support_suite_trial.spp.team_section.add_members_task.error_message.server_error":"There’s a server error. Try again in a moment.","txt.support_suite_trial.spp.team_section.agent_status_task.paragraph_one":"Agents can set their availability status to Online to start receiving chats and calls. At any time, they can put conversations on pause to focus attention on urgent or more complex tickets.","txt.support_suite_trial.spp.team_section.success_message.header":"Go team go","txt.support_suite_trial.spp.team_section.success_message.description":"Now your team is set up and ready to handle any requests that come their way.","txt.support_suite_trial.spp.article_section.visit_task.paragraph_one":"A self-service help center saves customers time with easy-to-find content for solving issues. Add FAQs or migrate existing help content that you can separate by brand or product. {{help_center_link}}","txt.support_suite_trial.spp.article_section.visit_task.help_center_link":"Learn about help center","txt.support_suite_trial.spp.article_section.success_message.header":"You did it","txt.support_suite_trial.spp.article_section.success_message.description":"High-five, the basics are set up. Start using Zendesk Suite to help your customers.","txt.support_suite_trial.spp.success_message.continue_cta_button":"Continue setup","txt.support_suite_trial.spp.success_message.final_cta_button":"Explore more","txt.support_suite_trial.spp.support_section.facebook_task.paragraph_part1":"Allow customers to request and receive support on the direct messaging apps they already use.","txt.support_suite_trial.spp.support_section.facebook_task.paragraph_part2":"As you need them, add social channels in {{admin_center}}","txt.support_suite_trial.social_channels.messeneger":"Facebook Messenger","txt.support_suite_trial.social_channels.whats_app":"WhatsApp","txt.support_suite_trial.social_channels.twitter_dm":"X Corp DM","txt.support_suite_trial.social_channels.we_chat":"WeChat","txt.support_suite_trial.social_channels.line":"LINE","txt.suite_trial.framework.overview":"Overview","txt.suite_trial.framework.your_account_theme":"Your account","txt.suite_trial.framework.account_details_task":"View details","txt.suite_trial.framework.account_details_task_v2":"Customer support channels","txt.suite_trial.framework.ticketing_system_theme":"Ticketing system","txt.suite_trial.framework.ticketing_intro_task":"Manage all tickets in one place","txt.suite_trial.framework.aw_tour_task":"Take a tour","txt.suite_trial.framework.aw_tour_task_v2":"Learn about tickets","txt.suite_trial.framework.chat_and_messaging_theme":"Live chat and messaging","txt.suite_trial.framework.help_center_theme":"Help center","txt.suite_trial.framework.hc_intro_task":"Help customers help themselves","txt.suite_trial.framework.design_hc_task":"Design your help center","txt.suite_trial.framework.publish_content_task":"Create and publish content","txt.suite_trial.framework.agent_productivity_theme":"Agent productivity","txt.suite_trial.framework.productivity_intro_task":"Solve tickets faster","txt.suite_trial.framework.use_filters_task":"Filter your ticket queue","txt.suite_trial.framework.use_macros_task":"Use prepared responses","txt.suite_trial.framework.automate_actions_task":"Automate repeat actions","txt.suite_trial.framework.minutes":"{{minutes}} min","txt.suite_trial.framework.task_badge.new":"New","txt.suite_trial.framework.content_library.header":"Getting started with customer support","txt.suite_trial.progress_meter.start":"Ready to start","txt.suite_trial.progress_meter.one_quarter":"Look at you go","txt.suite_trial.progress_meter.half":"You're halfway there","txt.suite_trial.progress_meter.three_quarters":"Almost to the finish line","txt.suite_trial.progress_meter.finished":"Good job, take a bow","txt.suite_trial.footer_nav.back":"Back","txt.suite_trial.footer_nav.next":"Next","txt.web_crawler.progress_tracker.task.add_content":"Add content","txt.web_crawler.chat_preview.suggested_question.header":"Suggested questions","txt.web_crawler.chat_preview.suggested_question.question_prefix":"Ask {{question}}","txt.suite_trial.overview.header":"Jump in and try Zendesk Suite","txt.suite_trial.overview.paragraph_one":"See for yourself how easy it is to use Zendesk. You’ll be able to see how agents can seamlessly help customers, teams can collaborate on tickets, and tools can automate repetitive actions.","txt.suite_trial.overview.paragraph_two":"This trial features Zendesk Suite Professional so you have access to everything. Get ready to start helping your customers today.","txt.suite_trial.overview.subheader":"Level up your customer service","txt.suite_trial.overview.bullets_description":"In less than an hour, you’ll learn what’s in Zendesk, plus set up a few key tasks. Give it a go.","txt.suite_trial.overview.bullets_unify_all":"Unify all channels into a single-view ticketing system.","txt.suite_trial.overview.bullets_add_live_chat":"Add messaging and live chat to your website, mobile apps, and social channels.","txt.suite_trial.overview.bullets_design_theme":"Design a help center theme and learn how to add content.","txt.suite_trial.overview.bullets_improve_operations":"Improve operations through reporting and analytics.","txt.suite_trial.overview.bullets_increase_productivity":"Increase agent productivity using workflow tools.","txt.suite_trial.overview.bullets_unify_all_v2":"Unify all channels into a {{#link}}single-view ticketing system{{/link}}","txt.suite_trial.overview.bullets_add_live_chat_v2":"Add {{#link}}messaging and live chat{{/link}} to your website, mobile apps, and social channels","txt.suite_trial.overview.bullets_design_theme_v2":"Design a {{#link}}help center{{/link}} theme and learn how to add content","txt.suite_trial.overview.bullets_improve_operations_v2":"Improve operations through {{#link}}reporting and analytics{{/link}}","txt.suite_trial.overview.bullets_increase_productivity_v2":"Increase {{#link}}agent productivity{{/link}} using workflow tools","txt.suite_trial.overview.bullets_apps_and_integrations_v2":"Pull together all your business {{#link}}apps and integrations{{/link}} into one place","txt.suite_trial.view_details.description":"See how Zendesk Suite works. It's ready to go with these essential elements that were made just for you.","txt.suite_trial.view_details.description_v2":"Zendesk Suite gives you everything you need to support your customers right out of the box. It’s ready to go with these essential capabilities.","txt.suite_trial.view_details.emailcard.title":"Email","txt.suite_trial.view_details.emailcard.description":"No need to set up a mail server, your out-of-the-box email address is {{support_email}}. Plus, you're able to create an unlimited number of custom emails, which are helpful for teams.","txt.suite_trial.view_details.emailcard.description_v2":"Share this email with your customers, so they can reach you for help. Plus, you can create an unlimited number of custom emails or forward an existing address.","txt.suite_trial.view_details.emailcard.your_email":"Your email is {{support_email}}","txt.suite_trial.view_details.emailcard.create_ticket_via_email_link":"Send a test ticket to {{email}}","txt.suite_trial.view_details.emailcard.description_v3":"Share this email with customers so they can reach you for help. See how it works by sending a test ticket","txt.suite_trial.test_ticket.email_from_customer.subject":"Test ticket: Email from a customer","txt.suite_trial.test_ticket.email_from_customer.prefilled_body":"I’m having a problem setting up your new product. Can you help me troubleshoot?","txt.suite_trial.get_started.tooltip.header":"All your tickets live in Views","txt.suite_trial.get_started.tooltip.body_text":"Customer service tickets end up here. It’s a good place for agents to see the big picture and start their day.","txt.suite_trial.get_started.tooltip.button_text":"OK","txt.suite_trial.view_details.messaging_card.title":"Live chat and messaging","txt.suite_trial.view_details.messaging_card.description":"There's a {{code_string}} that's ready to add to your website. Then you can seamlessly use live chat to help customers while they're on your website.","txt.suite_trial.view_details.messaging_card.description_v2":"Connect with customers across web, mobile, and social. Start with adding Web Widget to your website.","txt.suite_trial.view_details.messaging_card.add_widget_code":"Add your Web Widget code","txt.suite_trial.view_details.messaging_card.string_snippet":"small piece of code","txt.suite_trial.view_details.voicecard.title":"Voice","txt.suite_trial.view_details.voicecard.description":"Your default phone number is {{support_phone_number}}. It'll help you stay dialed in. After you buy, you can choose a new local phone number or forward an existing one.","txt.suite_trial.view_details.voicecard.description_v2":"Connecting with customers on the phone helps you stay dialed in to their needs.","txt.suite_trial.view_details.voicecard.your_phone_number":"Your phone number is {{support_phone_number}}","txt.suite_trial.view_details.helpcentercard.title":"Help center","txt.suite_trial.view_details.helpcentercard.description":"Turn your knowledge into instant answers by creating content. Then house it in your help center at {{help_center_link}}. Whether it's FAQs, videos, or articles, you can assist customers even when no one is in the office.","txt.suite_trial.view_details.helpcentercard.description_v2":"Turn your know-how into instant answers with articles, FAQs, and videos hosted on your help center. Now you can assist customers even when no one’s in the office.","txt.suite_trial.view_details.helpcentercard.set_up_help_center_link":"Set up your help center","txt.suite_trial.view_details.help_center_card.create_help_center_task":"Set up your help center","txt.suite_trial.view_details.help_center_card.description":"Turn your knowledge into instant answers by creating content. Then house it in {{your_help_center}}. Whether it's FAQs, videos, or articles, you can assist customers even when no one is in the office.","txt.suite_trial.view_details.help_center_card.your_help_center_string":"your help center","txt.suite_trial.manage_tickets.description":"Get the whole story. From chats and calls to social interactions and emails, Zendesk turns all customer conversations into tickets.","txt.suite_trial.manage_tickets.description_v2":"Zendesk turns all customer conversations into tickets. Whether customers chat, call, email, or connect on social media, tickets from all channels are in one place.","txt.suite_trial.manage_tickets.description_items_list":"There's one workspace for all tickets, helping you:","txt.suite_trial.manage_tickets.description_items_list_v2":"In the Zendesk workspace, you can:","txt.suite_trial.manage_tickets.description_item_1":"See all the contact info, interaction history, and details","txt.suite_trial.manage_tickets.description_item_2":"Loop in teams without leaving the ticket","txt.suite_trial.manage_tickets_task.alt_video.text":"Play video to learn about the Agent Workspace within the ticketing system.","txt.suite_trial.tour_agent_workspace.description":"Zendesk's ticketing system gives you the big picture as well as the ability to dive into the details. Having everything in one place helps agents respond quicker and provide more personalized support.","txt.suite_trial.tour_agent_workspace.description_v2":"The ticketing system shows all your customer information and history in a single view. Agents can respond quicker and provide more personalized support since everything they need is in one place.","txt.suite_trial.tour_agent_workspace.button":"See how ticketing works","txt.suite_trial.onboarding_set_up.tooltip.agent_tour.first.title":"All channels in one place","txt.suite_trial.onboarding_set_up.tooltip.agent_tour.first.context":"Here's what unified customer conversations look like. Whether it's email, chat, voice, or social channels, it's all front and center, so agents have better context.","txt.suite_trial.onboarding_set_up.tooltip.agent_tour.second.title":"Choose the right channel for your customer","txt.suite_trial.onboarding_set_up.tooltip.agent_tour.second.context":"Agents select the best way for responding on the customer's preferred channel. Plus leave internal notes for your team members.","txt.suite_trial.onboarding_set_up.tooltip.agent_tour.third.title":"Quick customer profile","txt.suite_trial.onboarding_set_up.tooltip.agent_tour.third.context":"The essentials card shows a customer's contact information and preferred language. Plus add external profiles so you can integrate all the customer's information.","txt.suite_trial.onboarding_set_up.tooltip.agent_tour.fourth.title":"View past conversations","txt.suite_trial.onboarding_set_up.tooltip.agent_tour.fourth.context":"The interaction history gives visibility into previous conversations and events, including from external systems, so customers don't have to repeat themselves.","txt.suite_trial.onboarding_set_up.tooltip.agent_tour.fifth.title":"Make it official","txt.suite_trial.onboarding_set_up.tooltip.agent_tour.fifth.context":"Submit the ticket response and define its status. Tickets can be open, solved/closed, or something in between.","txt.suite_trial.onboarding_set_up.cta.next":"Next","txt.suite_trial.onboarding_set_up.cta.back":"Back","txt.suite_trial.onboarding_set_up.cta.done":"Done","txt.suite_trial.growl.trial_extend.text":"Welcome back. You now have 14 extra days.","txt.try_buy_experience.section_header":"About your trial","txt.try_buy_experience.sub_header":"You've set up the basics for helping customers","txt.try_buy_experience.details.paragraph_one":"As you go along, tailor the Suite Professional capabilities to best fit your team.","txt.try_buy_experience.details.paragraph_two":"Explore the ins and outs and everything that you can do to seamlessly help customers. {{link}}","txt.try_buy_experience.details.learn_link_content":"Learn about Zendesk Suite","txt.try_buy_experience.details.learn_link_url":"https://support.zendesk.com/hc/en-us/articles/360053763453","txt.try_buy_experience.dashboard_nav.trial_date":"Trial expires in {{days}} days on {{date}}","txt.try_buy_experience.dashboard_nav.trial_details_parent_string":"{{plan_name}} ends in {{days}} on {{date}}","txt.try_buy_experience.dashboard_nav.trial_details_parent_string_one_day_remaining":"{{plan_name}} ends in {{days}} on {{date}}","txt.try_buy_experience.dashboard_nav.trial_details_parent_string_zero_day_remaining":"{{plan_name}} ends {{days}} on {{date}}","txt.try_buy_experience.dashboard_nav.trial_default_plan_name":"Trial","txt.try_buy_experience.dashboard_nav.trial_professional_plan_name":"{{suite_professional_plan}} trial","txt.try_buy_experience.dashboard_nav.support_trial_plan_name":"{{plan_name}} trial","txt.try_buy_experience.dashboard_nav.number_of_days_remaining":"{{number_of_days}} days","txt.try_buy_experience.dashboard_nav.one_day_remaining":"1 day","txt.try_buy_experience.dashboard_nav.zero_day_remaining":"today","txt.try_buy_experience.dashboard_nav.trial_ended":"Your trial has ended","txt.try_buy_experience.dashboard_nav.cta":"Buy Zendesk","txt.try_buy_experience.plan.tag":"Your trial","txt.try_buy_experience.plan.paragraph_one":"On top of the basics, you can use routing and analytics to help your team collaborate more deeply.","txt.try_buy_experience.plan.list_one":"AI-powered automated answers","txt.try_buy_experience.plan.list_two":"Out-of-the-box reporting and analytics","txt.try_buy_experience.plan.list_three":"Routing based on agent skill","txt.try_buy_experience.plan.paragraph_two":"Work even better together.","txt.mentions.not_a_member_of_assigned_group":"Not a member of assigned group.","txt.mentions.screen_reader.not_a_member_of_assigned_group":"Disabled. Not a member of assigned group.","txt.suite_trial.questionnaire.channels.question":"How do people reach you?","txt.suite_trial.questionnaire.channels.answer_option.help_center":"Help center","txt.suite_trial.questionnaire.channels.answer_option.social_media":"Social media","txt.suite_trial.account_details_refresh.header":"Jump in and try Zendesk Suite","txt.suite_trial.account_details_refresh.description_one":"In less than an hour, learn how agents seamlessly help customers, teams collaborate on tickets, and tools automate repetitive actions.","txt.suite_trial.account_details_refresh.description_two":"This trial features {{plan}} so you have access to everything and can create test tickets to explore all the features.","txt.suite_trial.account_details_refresh.description_three":"Everything's ready, give it a try.","txt.suite_trial.account_details_refresh.subhead_all":"Explore the channels where customers can reach you","txt.suite_trial.account_details_refresh.subhead_partial.used_channel":"Start with the channels you already use","txt.suite_trial.account_details_refresh.subhead_partial.explore_channel":"See how other channels in Zendesk Suite work","txt.suite_trial.account_details_refresh.email_block.subhead":"Email","txt.suite_trial.account_details_refresh.email_block.description":"Your email is {{email_address}}. Send a message to this address, then you'll see how it becomes a ticket.","txt.suite_trial.account_details_refresh.email_block.link_text":"Send a test ticket","txt.suite_trial.account_details_refresh.help_center_block.subhead":"Help center","txt.suite_trial.account_details_refresh.help_center_block.description":"Turn your know-how into instant answers with articles, FAQs, and videos hosted on a help center. Assist customers even when no one's in the office.","txt.suite_trial.account_details_refresh.help_center_block.link_text":"Set up your help center","txt.suite_trial.account_details_refresh.messaging_block.subhead":"Live chat and messaging","txt.suite_trial.account_details_refresh.messaging_block.description":"Add Web Widget to have your conversations across web, mobile, and social become tickets.","txt.suite_trial.account_details_refresh.messaging_block.link_text":"Add your code snippet","txt.suite_trial.account_details_refresh.voice_block.subhead":"Voice","txt.suite_trial.account_details_refresh.voice_block.has_number_description":"Connecting with customers on the phone helps you stay dialed in to their needs.","txt.suite_trial.account_details_refresh.voice_block.no_number_description":"Connecting with customers on the phone helps you stay dialed in to their needs. Go to settings in {{admin_center}} and choose your phone number.","txt.suite_trial.account_details_refresh.voice_block.admin_center_text":"Admin center","txt.suite_trial.account_details_refresh.voice_block.phone_text":"Give yourself a call at {{phone_number}} to create a ticket.","txt.suite_trial.account_details_refresh.voice_block.phone_text_v2":"Give yourself a call at {{phone_number}}.","txt.suite_trial.account_details_refresh.voice_block.link_text":"Get your phone number","txt.suite_trial.account_details_refresh.subhead_all_v2":"Explore the ways customers reach you","txt.suite_trial.account_details_refresh.subhead_partial.explore_channel_v2":"See how other channels work","txt.messaging_as_default.starting_flow.messaging.header":"Messaging and live chat","txt.messaging_as_default.account_details_task.messaging.header":"Messaging and live chat","txt.messaging_as_default.account_details_task.messaging.link_description":"Add your Web Widget code snippet","txt.messaging_as_default.messaging_theme.header":"Messaging and live chat","txt.messaging_as_default.messaging_intro_task.paragraph":"Help customers the moment they need it on your website, mobile apps, and social channels. Messaging makes it easy to have conversations across channels without interrupting the customer experience.","txt.messaging_as_default.messaging_intro_task.list.header":"Here's how messaging works on your website or mobile app:","txt.messaging_as_default.messaging_intro_task.list.one":"Chat with customers in real-time or continue the conversation when it's convenient for them","txt.messaging_as_default.messaging_intro_task.list.two":"Make it easy for your customers to start a message on one channel and move it to another","txt.messaging_as_default.messaging_intro_task.list.three":"Use bots to automatically give customers quick answers to common questions","txt.messaging_as_default.social_messaging_task.paragraph":"Real-time and ongoing customer conversations are seamless when you add Zendesk to your website. After setup, further customize Web Widget to suit your needs, plus set up for your mobile apps and social channels. ","txt.messaging_as_default.social_messaging_task.step_two.cta":"Email code snippet to a team member","txt.messaging_as_default.social_messaging_task.snippet_alert.header":"Couldn’t load your code snippet","txt.messaging_as_default.social_messaging_task.snippet_alert.description":"Refresh the screen.","txt.messaging_as_default.social_messaging_task.mail_template.subject":"Code snippet for Web Widget","txt.messaging_as_default.social_messaging_task.mail_template.paragraph_one":"Hi, we're putting the Web Widget on our website so customers can get help whenever they need. It allows for real-time and ongoing conversations. Here’s the Web Widget code snippet and instructions.","txt.messaging_as_default.social_messaging_task.mail_template.paragraph_two":"Copy and paste the code snippet before the </body> tag on each page where you want it to appear.","txt.quick_assist.nav.profile_menu_item_label":"Help","txt.quick_assist.intro.meet_quick_assist":"Meet Quick Assist, the helpful guide to get you up and running.","txt.quick_assist.intro.quick_assist_reminder":"Quick Assist is here whenever you need it.","txt.quick_assist.intro.profile_menu_help_intro":"You can now find help for any of your Zendesk questions in the profile menu.","txt.quick_assist.intro.profile_menu_help_intro_cta":"Open profile menu","txt.quick_assist.nav.quick_assist":"Quick Assist","txt.quick_assist.nav.popular_topics":"Popular topics","txt.quick_assist.nav.set_up_features":"Set up features","txt.quick_assist.nav.get_started":"Get started","txt.quick_assist.nav.ticket_management":"Ticket management","txt.quick_assist.nav.support_addresses":"Support addresses","txt.quick_assist.nav.macros":"Macros","txt.quick_assist.nav.web_widget":"Web Widget","txt.quick_assist.nav.triggers":"Triggers","txt.quick_assist.nav.reporting":"Reporting","txt.quick_assist.nav.contact_zendesk":"Contact Zendesk","txt.quick_assist.nav.were_online":"We're online","txt.quick_assist.pane.ticket_management.title":"Ticket management","txt.quick_assist.pane.ticket_management.what":"What","txt.quick_assist.pane.ticket_management.what_paragraph":"Learn how to configure your ticket processes.","txt.quick_assist.pane.ticket_management.why":"Why","txt.quick_assist.pane.ticket_management.why_paragraph":"Setting up how you process tickets can help you cut down on busy work.","txt.quick_assist.pane.ticket_management.how.title":"How","txt.quick_assist.pane.ticket_management.how.admin_only":"{{link}} (Admin only)","txt.quick_assist.pane.ticket_management.how.add_tags":"Add tags","txt.quick_assist.pane.ticket_management.how.exclude_tickets_from_notifications":"Exclude tickets from notifications","txt.quick_assist.pane.ticket_management.how.create_view_to_filter_tickets":"Create a view to filter and organize tickets","txt.quick_assist.pane.ticket_management.setting_up_zendesk_feature_training":"Learn about setting up your Zendesk features with our {{link}}.","txt.quick_assist.pane.ticket_management.how.free_ondemand_training":"free on-demand training","txt.quick_assist.pane.ticket_management.how.free_ondemand_training_url":"https://training.zendesk.com/series/zendesk-admins","txt.quick_assist.pane.support_address.title":"Support addresses","txt.quick_assist.pane.support_address.what":"What","txt.quick_assist.pane.support_address.what_paragraph":"A support address is an email address your customers use to get help. Any email sent to a support address will become a ticket.","txt.quick_assist.pane.support_address.why":"Why","txt.quick_assist.pane.support_address.why_paragraph":"Support addresses allow you to set up different email addresses that can help organize customer communication. For example, if someone wants IT support from Acme company, they might send an email to ITsupport@acme.zendesk.com. You can direct tickets to the right teams for a quicker response time and resolution.","txt.quick_assist.pane.support_address.why_paragraph_v2":"With a support address you can direct tickets to the right teams for a quicker response time and resolution.","txt.quick_assist.pane.support_address.where":"Where","txt.quick_assist.pane.setup_features.support_address.where_paragraph_nowrap":"To add a support address, head to {{admin_center}}, click {{icon}} {{channels}} in the sidebar, then select {{talk_email}}. Click the {{add_address}} dropdown and select the type of address you want to add.","txt.quick_assist.pane.setup_features.support_address.talk_and_email":"Talk and email","txt.quick_assist.pane.support_address.where_paragraph_nowrap":"To add a support address, head to the {{admin}} icon {{icon}} in the sidebar, and navigate to {{link}}. You’ll see one default address already set up, support@{{subdomain}}.zendesk.com, but you can always add more.","txt.quick_assist.pane.support_address.where_paragraph_admin":"Admin","txt.quick_assist.pane.support_address.where_paragraph_channels_email":"Channels > Email","txt.quick_assist.pane.support_address.quick_start.title":"Quick start","txt.quick_assist.pane.support_address.quick_start.choosing_the_email":"Choosing the email addresses you want to use to receive support requests","txt.quick_assist.pane.support_address.quick_start.choosing_the_email_url":"https://support.zendesk.com/hc/en-us/articles/360000334947#topic_v3b_zfd_v3","txt.quick_assist.pane.support_address.quick_start.adding_support_addresses":"Adding support addresses for users to submit tickets","txt.quick_assist.pane.support_address.quick_start.adding_support_addresses_url":"https://support.zendesk.com/hc/en-us/articles/203663336","txt.quick_assist.pane.support_address.quick_start.accepting_wildcard":"Accepting wildcard email addresses for support requests","txt.quick_assist.pane.support_address.quick_start.accepting_wildcard_url":"https://support.zendesk.com/hc/en-us/articles/203663336#topic_o1c_53r_l3b","txt.quick_assist.pane.support_address.learn.title":"Learn","txt.quick_assist.pane.support_address.learn.choosing_the_email":"Choosing the email addresses you want to use to receive support requests","txt.quick_assist.pane.support_address.learn.choosing_the_email_url":"https://support.zendesk.com/hc/en-us/articles/360000334947#topic_v3b_zfd_v3","txt.quick_assist.pane.support_address.learn.adding_support_addresses":"Adding support addresses for users to submit tickets","txt.quick_assist.pane.support_address.learn.adding_support_addresses_url":"https://support.zendesk.com/hc/en-us/articles/203663336","txt.quick_assist.pane.support_address.learn.accepting_wildcard":"Accepting wildcard email addresses for support requests","txt.quick_assist.pane.support_address.learn.accepting_wildcard_url":"https://support.zendesk.com/hc/en-us/articles/203663336#topic_o1c_53r_l3b","txt.quick_assist.pane.support_address.find_out_what_else":"Find out what else you can do with support addresses to make your workflow easier. {{link}}.","txt.quick_assist.pane.support_address.find_out_what_else_link":"See all the resources to set up support addresses for requests","txt.quick_assist.pane.support_address.find_out_what_else_link_url":"https://support.zendesk.com/hc/en-us/articles/203663306#topic_ppj_hcf_1k","txt.quick_assist.pane.macros.title":"Macros","txt.quick_assist.pane.macros.what_title":"What","txt.quick_assist.pane.macros.what_paragraph":"A macro is a single, standard email response you or your team creates to answer Support tickets with similar issues. To save time, agents can choose from a list of available macros and apply them to the ticket.","txt.quick_assist.pane.macros.what_paragraph_v2":"A macro is a scripted response or action manually applied to tickets by agents. It's a shortcut. Agents can choose from a list of available macros and apply them to the ticket.","txt.quick_assist.pane.macros.why":"Why","txt.quick_assist.pane.macros.why_paragraph":"A little automated help goes a long way with repeated issues. Macros help you work smarter with pre-filled answers and solutions at the click of a button.","txt.quick_assist.pane.macros.why_paragraph_2":"Here are ways agents can use macros.","txt.quick_assist.pane.macros.why_paragraph_list_item_1":"Add comment text","txt.quick_assist.pane.macros.why_paragraph_list_item_2":"Update ticket fields","txt.quick_assist.pane.macros.why_paragraph_list_item_3":"Add or remove ticket tags","txt.quick_assist.pane.macros.why_paragraph_list_item_4":"Add CCs","txt.quick_assist.pane.macros.why_paragraph_list_item_5":"Change the assignee","txt.quick_assist.pane.macros.why_paragraph_list_item_6":"Set the ticket subject","txt.quick_assist.pane.macros.why_paragraph_list_item_7":"Add attachments to ticket comments","txt.quick_assist.pane.macros.where":"Where","txt.quick_assist.pane.setup_features.macros.where_paragraph_nowrap":"To set up and manage macros, head to {{admin_center}}, click {{icon}} {{workspaces}} in the sidebar, then select {{agent_tools_macros}}. You’ll see some built-in macros that are ready to use. Click the {{add_macros}} button to create your own.","txt.quick_assist.pane.setup_features.macros.workspaces":"Workspaces","txt.quick_assist.pane.setup_features.macros.agent_tools_macros":"Agent tools > Macros","txt.quick_assist.pane.setup_features.macros.add_macros":"Add macros","txt.quick_assist.pane.macros.where_paragraph_nowrap":"To see your macros, head to the {{admin}} icon {{icon}} in the sidebar and then select {{link}}.","txt.quick_assist.pane.macros.where_paragraph_admin":"Admin","txt.quick_assist.pane.macros.where_paragraph_manage_macros":"Manage > Macros","txt.quick_assist.pane.macros.quick_start.title":"Quick start","txt.quick_assist.pane.macros.quick_start.introducing_macros":"Introducing macros","txt.quick_assist.pane.macros.quick_start.introducing_macros_url":"https://support.zendesk.com/hc/en-us/articles/360001996987#macros","txt.quick_assist.pane.macros.quick_start.creating_personal":"Creating personal or shared macros for tickets","txt.quick_assist.pane.macros.quick_start.creating_personal_url":"https://support.zendesk.com/hc/en-us/articles/115001236988-Creating-macros-for-tickets#topic_zh2_4nw_4y","txt.quick_assist.pane.macros.quick_start.organizing":"Organizing and managing your macros","txt.quick_assist.pane.macros.quick_start.organizing_url":"https://support.zendesk.com/hc/en-us/articles/203690816","txt.quick_assist.pane.macros.quick_start.find_out_what":"Find out what else you can do with macros to make your workflow easier. {{link}}. ","txt.quick_assist.pane.macros.quick_start.see_macros_resources":"See macros resources","txt.quick_assist.pane.macros.quick_start.see_macros_resources_url":"https://support.zendesk.com/hc/en-us/articles/360033948613","txt.quick_assist.pane.macros.learn.title":"Learn","txt.quick_assist.pane.macros.learn.introducing_macros":"Introducing macros","txt.quick_assist.pane.macros.learn.introducing_macros_url":"https://support.zendesk.com/hc/en-us/articles/360001996987#macros","txt.quick_assist.pane.macros.learn.creating_personal":"Creating personal or shared macros for tickets","txt.quick_assist.pane.macros.learn.creating_personal_url":"https://support.zendesk.com/hc/en-us/articles/115001236988#topic_zh2_4nw_4y","txt.quick_assist.pane.macros.learn.organizing":"Organizing and managing your macros","txt.quick_assist.pane.macros.learn.organizing_url":"https://support.zendesk.com/hc/en-us/articles/203690816","txt.quick_assist.pane.macros.learn.find_out_what":"Find out what else you can do with macros to make your workflow easier. {{link}}.","txt.quick_assist.pane.macros.learn.see_macros_resources":"See macros resources","txt.quick_assist.pane.macros.learn.see_macros_resources_url":"https://support.zendesk.com/hc/en-us/articles/360033948613","txt.quick_assist.pane.web_widget.title":"Web Widget","txt.quick_assist.pane.web_widget.what":"What","txt.quick_assist.pane.web_widget.what_paragraph":"The Web Widget is an embeddable app that gives customers quick access to your Help Center or your agents in the Support, Talk, and Chat channels.","txt.quick_assist.pane.web_widget.what_paragraph_list_header":"Here are some ways your customers can use the Web Widget.","txt.quick_assist.pane.web_widget.what_paragraph_list_item_1_title":"Guide: ","txt.quick_assist.pane.web_widget.what_paragraph_list_item_1_content":"Search Help Center articles for immediate self-service.","txt.quick_assist.pane.web_widget.what_paragraph_list_item_2_title":"Support: ","txt.quick_assist.pane.web_widget.what_paragraph_list_item_2_content":"Customers submit a support request using a contact form.","txt.quick_assist.pane.web_widget.what_paragraph_list_item_3_title":"Talk: ","txt.quick_assist.pane.web_widget.what_paragraph_list_item_3_content":"Customers request a callback or view a phone number that they can call instead.","txt.quick_assist.pane.web_widget.what_paragraph_list_item_4_title":"Chat: ","txt.quick_assist.pane.web_widget.what_paragraph_list_item_4_content":"Customers start a live chat with an agent.","txt.quick_assist.pane.web_widget.why":"Why","txt.quick_assist.pane.web_widget.why_paragraph":"With Web Widget, your customers always have a little help on hand. They can find a form, request a call back, or start a chat at any time across your site.","txt.quick_assist.pane.web_widget.where":"Where","txt.quick_assist.pane.setup_features.web_widget.where_paragraph_nowrap":"To get started with Web Widget, head to {{admin_center}}, click {{icon}} {{channels}} in the sidebar, then select {{classic_web_widget}}.","txt.quick_assist.pane.setup_features.web_widget.classic_web_widget":"Classic > Web Widget","txt.quick_assist.pane.web_widget.where_paragraph_nowrap":"To find the Web Widget settings, head to the {{admin}} icon {{icon}} in the sidebar and navigate to {{link}}.","txt.quick_assist.pane.web_widget.where_paragraph_admin":"Admin","txt.quick_assist.pane.web_widget.where_paragraph_channels_widgets":"Channels > Widget","txt.quick_assist.pane.web_widget.quick_start.title":"Quick start","txt.quick_assist.pane.web_widget.quick_start.content":"(Only admins can set up and configure the Web Widget)","txt.quick_assist.pane.web_widget.quick_start.item_1":"Using Web Widget to embed customer service in your website","txt.quick_assist.pane.web_widget.quick_start.item_1_url":"https://support.zendesk.com/hc/en-us/articles/203908456","txt.quick_assist.pane.web_widget.quick_start.item_2":"Configure the components in your Web Widget","txt.quick_assist.pane.web_widget.quick_start.item_2_url":"https://support.zendesk.com/hc/en-us/articles/115009692388","txt.quick_assist.pane.web_widget.quick_start.item_3_url":"https://support.zendesk.com/hc/en-us/articles/360022359133#topic_esm_1dt_vdb","txt.quick_assist.pane.web_widget.quick_start.find_out_what":"Find out what else you can do with the Web Widget to make your workflow easier. {{link}}. ","txt.quick_assist.pane.web_widget.quick_start.see_web_widget_resources":"See all Web Widget resources","txt.quick_assist.pane.web_widget.quick_start.see_web_widget_resources_url":"https://support.zendesk.com/hc/en-us/articles/115004744348-Web-Widget-resources","txt.quick_assist.pane.web_widget.learn.title":"Learn","txt.quick_assist.pane.web_widget.learn.content":"(Only admins can set up and configure the Web Widget)","txt.quick_assist.pane.web_widget.learn.item_1":"Using Web Widget to embed customer service in your website","txt.quick_assist.pane.web_widget.learn.item_1_url":"https://support.zendesk.com/hc/en-us/articles/203908456","txt.quick_assist.pane.web_widget.learn.item_2":"Configure the components in your Web Widget","txt.quick_assist.pane.web_widget.learn.item_2_url":"https://support.zendesk.com/hc/en-us/articles/115009692388","txt.quick_assist.pane.web_widget.learn.item_3":"Providing omnichannel support using Web Widget for Support Suite","txt.quick_assist.pane.web_widget.learn.item_3_support_suite":"Providing omnichannel support using Web Widget for Support Suite","txt.quick_assist.pane.web_widget.learn.item_3_url":"https://support.zendesk.com/hc/en-us/articles/360022359133#topic_esm_1dt_vdb","txt.quick_assist.pane.web_widget.learn.find_out_what":"Find out what else you can do with the Web Widget to make your workflow easier. {{link}}.","txt.quick_assist.pane.web_widget.learn.see_web_widget_resources":"See all Web Widget resources","txt.quick_assist.pane.web_widget.learn.see_web_widget_resources_url":"https://support.zendesk.com/hc/en-us/articles/115004744348","txt.quick_assist.pane.web_widget.spp.title":"Web messaging","txt.quick_assist.pane.web_widget.spp.what_paragraph_one":"When you add web messaging, customers get quick answers via automated help, plus easy access to agents. Conversations can be instant or over multiple days.","txt.quick_assist.pane.web_widget.spp.what_paragraph_two":`Create automated customer service flows to best support your team.

You design the questions and answers, then flows utilize Answer Bot that can:`,"txt.quick_assist.pane.web_widget.spp.what_paragraph_two_list_item_one":"Suggest related articles","txt.quick_assist.pane.web_widget.spp.what_paragraph_two_list_item_two":"Search Help Center for additional content","txt.quick_assist.pane.web_widget.spp.what_paragraph_two_list_item_three":"Allow customers to request a human agent","txt.quick_assist.pane.web_widget.spp.what_paragraph_two_list_item_four":"Gather request details for hand-off to agents","txt.quick_assist.pane.web_widget.spp.why_paragraph":"Web messaging makes sure your customers have a little help on hand across your site. Until a ticket is resolved, the conversation history is always there for both customers and agents.","txt.quick_assist.pane.web_widget.spp.web_sdk":"Web SDK","txt.quick_assist.pane.web_widget.spp.web_sdk_paragraph":`To put messaging onto your site, you’ll need to add the Web SDK code on each page where you want web messaging to appear.

For details, head to the Admin Center and navigate to {{web_sdk_link}}`,"txt.quick_assist.pane.web_widget.spp.web_sdk_paragraph_cta":"Channels > Web SDK","txt.quick_assist.pane.web_widget.spp.learn_paragraph_one":"Only admins can set up and configure messaging","txt.quick_assist.pane.web_widget.spp.learn_paragraph_one_list_item_one":"See how web messaging works","txt.quick_assist.pane.web_widget.spp.learn_paragraph_one_list_item_one_url":"https://support.zendesk.com/hc/en-us/articles/360057096813","txt.quick_assist.pane.web_widget.spp.learn_paragraph_one_list_item_two":"Configure web messaging to fit your needs","txt.quick_assist.pane.web_widget.spp.learn_paragraph_one_list_item_two_url":"https://support.zendesk.com/hc/en-us/articles/360055567334","txt.quick_assist.pane.web_widget.spp.learn_paragraph_two":"If your team uses Web Widget (Classic) and isn’t ready to upgrade to web messaging, there’s still lots of support. {{get_help_link}}","txt.quick_assist.pane.web_widget.spp.learn_paragraph_two_cta":"Get help for Web Widget (Classic)","txt.quick_assist.nav.get_help.text":"Get help","txt.quick_assist.nav.ask_a_question":"Ask a question","txt.quick_assist.nav.reach_out_for_more_help":"Reach out for more help","txt.quick_assist.search.back_to_top":"Back to top","txt.quick_assist.nav.get_help.help_link":"https://support.zendesk.com/hc/en-us/requests/new?email={{email}}&subdomain={{subdomain}}&plan={{plan}}","txt.quick_assist.pane.triggers.title":"Triggers","txt.quick_assist.pane.triggers.what_title":"What","txt.quick_assist.pane.triggers.what_paragraph":"Triggers start a workflow action when a ticket is created or updated.","txt.quick_assist.pane.triggers.why":"Why","txt.quick_assist.pane.triggers.why_paragraph":"Triggers automatically take care of repetitive tasks that can take up valuable time and energy throughout the day. Triggers also control all email notifications sent to your customers. You can improve customer satisfaction with quicker updates and communication around their requests.","txt.quick_assist.pane.triggers.why_paragraph_2":"Here are some ways triggers can help improve your workflow.","txt.quick_assist.pane.triggers.why_paragraph_list_item_1":"Routing - get tickets to the agent","txt.quick_assist.pane.triggers.why_paragraph_list_item_2":"Notify - message agents and customers","txt.quick_assist.pane.triggers.why_paragraph_list_item_3":"Escalate - prioritize over other requests","txt.quick_assist.pane.triggers.why_paragraph_list_item_4":"Remind - keep the process moving","txt.quick_assist.pane.triggers.why_paragraph_list_item_5":"Update - edit tickets and user properties","txt.quick_assist.pane.triggers.where":"Where","txt.quick_assist.pane.setup_features.triggers.where_paragraph_nowrap":"To set up and manage triggers, head to {{admin_center}}, click {{icon}} {{objects_and_rules}} in the sidebar, then select {{business_rules_triggers}}. You’ll see some built-in triggers that are ready to use. Click the {{add_trigger}} dropdown to create your own and organize.","txt.quick_assist.pane.setup_features.triggers.objects_and_rules":"Objects and rules","txt.quick_assist.pane.setup_features.triggers.business_rules_triggers":"Business rules > Triggers","txt.quick_assist.pane.setup_features.triggers.add_trigger":"Add trigger","txt.quick_assist.pane.triggers.where_paragraph_nowrap":"To see your triggers, head to the {{admin}} icon {{icon}} in the sidebar and then select {{link}}.","txt.quick_assist.pane.triggers.where_paragraph_admin":"Admin","txt.quick_assist.pane.triggers.where_paragraph_manage_triggers":"Business Rules > Triggers","txt.quick_assist.pane.triggers.quick_start.title":"Quick start","txt.quick_assist.pane.triggers.quick_start.about_triggers":"About triggers and how they work","txt.quick_assist.pane.triggers.quick_start.about_triggers_url":"https://support.zendesk.com/hc/en-us/articles/203662246","txt.quick_assist.pane.triggers.quick_start.default_triggers":"About the Support default triggers","txt.quick_assist.pane.triggers.quick_start.default_triggers_link":"https://support.zendesk.com/hc/en-us/articles/203662176","txt.quick_assist.pane.triggers.quick_start.creating_triggers":"Creating triggers for automatic ticket updates and notifications","txt.quick_assist.pane.triggers.quick_start.creating_triggers_url":"https://support.zendesk.com/hc/en-us/articles/203662106","txt.quick_assist.pane.triggers.quick_start.find_out_what":"Find out what else you can do with triggers to make your workflow easier. {{link}}. ","txt.quick_assist.pane.triggers.quick_start.see_triggers_resources":"See all triggers resources","txt.quick_assist.pane.triggers.quick_start.see_triggers_resources_url":"https://support.zendesk.com/hc/en-us/articles/203662226-Triggers-resources","txt.quick_assist.pane.search_articles.place_holder":"Search the help center","txt.quick_assist.pane.search_articles.result_count":"results","txt.quick_assist.pane.search_articles.result_count_singular":"result","txt.quick_assist.pane.search_articles.recent_searches":"Recent searches","txt.quick_assist.pane.triggers.learn.title":"Learn","txt.quick_assist.pane.triggers.learn.about_triggers":"About triggers and how they work","txt.quick_assist.pane.triggers.learn.about_triggers_url":"https://support.zendesk.com/hc/en-us/articles/203662246","txt.quick_assist.pane.triggers.learn.creating_triggers":"Creating triggers for automatic ticket updates and notifications","txt.quick_assist.pane.triggers.learn.creating_triggers_url":"https://support.zendesk.com/hc/en-us/articles/203662106","txt.quick_assist.pane.triggers.learn.find_out_what":"Find out what else you can do with triggers to make your workflow easier. {{link}}.","txt.quick_assist.pane.triggers.learn.see_triggers_resources":"See all triggers resources","txt.quick_assist.pane.triggers.learn.see_triggers_resources_url":"https://support.zendesk.com/hc/en-us/articles/203662226-Triggers-resources","txt.quick_assist.pane.triggers.how.admin_only":"{{link}} (Admin only)","txt.quick_assist.pane.triggers.how.create_and_edit_your_triggers":"Create and edit your triggers","txt.quick_assist.pane.reporting.title":"Reporting","txt.quick_assist.pane.reporting.what":"What","txt.quick_assist.pane.reporting.what_paragraph":"Get customer analytics and create reports in Explore.","txt.quick_assist.pane.reporting.why":"Why","txt.quick_assist.pane.reporting.why_paragraph":"Reports help you measure and improve your customer experience.","txt.quick_assist.pane.reporting.how.title":"How","txt.quick_assist.pane.reporting.how.admin_only":"{{link}} (Admin only)","txt.quick_assist.pane.reporting.how.get_started_with_explore":"Get started with Explore","txt.quick_assist.pane.reporting.how.search_reporting_recipes":"Search reporting recipes","txt.quick_assist.pane.reporting.how.search_reporting_recipes_url":"https://support.zendesk.com/hc/en-us/sections/360004108713","txt.quick_assist.pane.reporting.how.customise_reports_by_time_or_channel":"Customize reports by time or channel","txt.quick_assist.nav.troubleshooting":"Troubleshooting","txt.quick_assist.nav.performance_issues":"Performance issues","txt.quick_assist.nav.configuration_issues":"Configuration issues","txt.quick_assist.pane.performance_issues.title":"Performance issues","txt.quick_assist.pane.performance_issues.what":"What","txt.quick_assist.pane.performance_issues.what_paragraph":"Diagnose and fix network, browser lag, and other performance issues.","txt.quick_assist.pane.performance_issues.why":"Why","txt.quick_assist.pane.performance_issues.why_paragraph":"These are the most common troubleshooting suggestions when you're having issues with your Zendesk connection.","txt.quick_assist.pane.performance_issues.how.title":"How","txt.quick_assist.pane.performance_issues.how.check_zendesk_status_page":"Check Zendesk status page for known issues","txt.quick_assist.pane.performance_issues.how.check_zendesk_status_page_url":"https://status.zendesk.com","txt.quick_assist.pane.performance_issues.how.clear_cache_and_cookies":"Clear cache and cookies","txt.quick_assist.pane.performance_issues.how.clear_cache_and_cookies_url":"https://support.zendesk.com/hc/en-us/articles/219161157","txt.quick_assist.pane.performance_issues.how.troubleshoot_hardware_software_network":"Troubleshooting hardware, software, and network","txt.quick_assist.pane.performance_issues.how.troubleshoot_hardware_software_network_url":"https://support.zendesk.com/hc/en-us/articles/360046946593","txt.quick_assist.pane.performance_issues.how.get_info_to_contact_support":"Get the information you need before you contact Zendesk Customer Support","txt.quick_assist.pane.performance_issues.how.get_info_to_contact_support_url":"https://support.zendesk.com/hc/en-us/articles/360026614173","txt.quick_assist.pane.configuration_issues.title":"Configuration issues","txt.quick_assist.pane.configuration_issues.what":"What","txt.quick_assist.pane.configuration_issues.what_paragraph":"Diagnose and fix connection issues for email, live chat, and voice.","txt.quick_assist.pane.configuration_issues.why":"Why","txt.quick_assist.pane.configuration_issues.why_paragraph":"Email, live chat, and voice are the ways that customers connect with you. Keep the conversation going smoothly.","txt.quick_assist.pane.configuration_issues.how.title":"How","txt.quick_assist.pane.configuration_issues.how.admin_only":"{{link}} (Admin only)","txt.quick_assist.pane.configuration_issues.how.check_inbound_email":"Check inbound email delivery","txt.quick_assist.pane.configuration_issues.how.check_outbound_email":"Check outbound email delivery","txt.quick_assist.pane.configuration_issues.how.check_chat_connection":"Check live chat connection","txt.quick_assist.pane.configuration_issues.how.test_talk_configuration":"Test your Talk configuration","txt.web_widget.help_center.title":"Get help","txt.web_widget.help_center.search_placeholder.account":"Ask your account question","txt.web_widget.help_center.search_placeholder.support":"Ask your Support question","txt