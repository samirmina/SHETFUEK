  ticketFields {
    id
    title
    rawTitle
    endUserTitle
    rawEndUserTitle
    description
    rawDescription
    agentOnlyDescription
    isActive
    endUserPermission
    isEditableByAgent
    position
    isEditableByEndUser
    isVisibleByEndUser
    isRequiredForAgent
    isRequiredForEndUser
    isSystemField
    isIgnoredByTicketForms
    isAppField
    key
    createdAt
    updatedAt
    createdByType
    creatorAppName
    createdBy {
      id
    }
    ... on DropdownTicketField {
      customFieldOptions {
        id
        name
        rawName
        value
        isDefault
        allowSolving
      }
    }
    ... on MultiselectTicketField {
      customFieldOptions {
        id
        name
        rawName
        value
        isDefault
      }
    }
    ... on RegexTicketField {
      regexpForValidation
    }
    ... on LookupTicketField {
      relationshipTargetType
      relationshipFilter {
        all {
          field
          operator
          value
        }
        any {
          field
          operator
          value
        }
      }
    }
    ... on MultiLookupTicketField {
      relationshipTargetType
      relationshipFilter {
        all {
          field
          operator
          value
        }
        any {
          field
          operator
          value
        }
      }
      maxSelections
    }
    ... on CheckboxTicketField {
      tag
    }
    ... on PriorityTicketField {
      priorityOptionType
      options {
        name
        value
      }
    }
    ... on TicketTypeTicketField {
      options {
        name
        value
      }
    }
    ... on StatusTicketField {
      statusOptionType
    }
    ... on CustomStatusTicketField {
      customStatuses {
        id
        url
        agentLabel
        statusCategory
      }
    }
  }
}
