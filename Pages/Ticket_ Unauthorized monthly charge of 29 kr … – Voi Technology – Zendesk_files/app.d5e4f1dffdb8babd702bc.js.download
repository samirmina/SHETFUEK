ted-setup-refinement.add-team-members-modal.error-message-alert.title":"Error","txt.accelerated-setup-refinement.add-team-members-modal.error-message-alert.description":"An error occurred. Try again later.","txt.accelerated-setup-refinement.add-team-members-modal.remove-row-button-aria-label":"Remove row","txt.accelerated-setup-refinement.add-team-members-modal.success-notification.title":"Team invites sent","txt.accelerated-setup-refinement.add-team-members-modal.success-notification.description":"Upon acceptance, team members can access Zendesk.","txt.accelerated-setup-refinement.add-team-members-modal.input.email-header":"Email address","txt.accelerated-setup-refinement.add-team-members-modal.input.role-header":"Role","txt.accelerated-setup-refinement.add-team-members-modal.input.role.admin":"Admin","txt.accelerated-setup-refinement.add-team-members-modal.input.role.agent":"Agent","txt.accelerated-setup-refinement.add-team-members-modal.input.button.add-another":"Add another","txt.accelerated-setup-refinement.add-team-members-modal.input.limit-reached":"While in trial, you can add up to four team members.","txt.accelerated-setup-refinement.add-team-members-modal.tooltip.header":"What's the difference?","txt.accelerated-setup-refinement.add-team-members-modal.tooltip.bullet-one.header":"Admins","txt.accelerated-setup-refinement.add-team-members-modal.tooltip.bullet-one.content":"{{header}} have full access to set up and manage accounts","txt.accelerated-setup-refinement.add-team-members-modal.tooltip.bullet-two.header":"Agents","txt.accelerated-setup-refinement.add-team-members-modal.tooltip.bullet-two.content":"{{header}} solve tickets but have limited access","txt.accelerated-setup-refinement.duplicate-user-identity-error-modal.header":"Couldn't connect to email because it's already in use","txt.accelerated-setup-refinement.duplicate-user-identity-error-modal.body":"This email address is already used by {{username}} and cannot also be a support address. If you'd like to use that email as your support address, delete it from {{username}}'s profile.","txt.accelerated-setup-refinement.duplicate-user-identity-error-modal.link-address":"https://support.zendesk.com/hc/en-us/articles/4408834337562-Error-This-email-address-is-already-used-by","txt.accelerated-setup-refinement.duplicate-user-identity-error-modal.button-label":"Start over","txt.accelerated-setup-refinement.duplicate-user-identity-error-modal.close-modal":"Close modal","txt.ms_email_connector.error_state.existing_email_error":"{{email}} is already a user identity and cannot also be a support address. If you'd like to use {{email}} as your support address, delete it from the user it is currently associated with.","txt.ms_email_connector.error_state.learn_content":"Learn how to manage user identities","txt.ms_email_connector.error_state.email_mismatch_error":"Connection to Microsoft has failed. Try again later.","txt.ms_email_connector.error_state.permission_error":"Zendesk needs permissions to connect to Microsoft. To connect, try again and {bold_text} permission request.","txt.ms_email_connector.error_state.accept_content":"accept","txt.ms_email_connector.micosoft_option_title":"Microsoft Exchange connector","txt.ms_email_connector.email-options.ms_option_description":"Import email from your Microsoft inbox and automatically convert email messages to tickets.","txt.ms_email_connector.error_modal.general_title":"There was a problem with Microsoft Exchange","txt.ms_email_connector.wizard-flow.subtitle_with_trigger":"This won't disrupt existing systems or workflows. Once you connect, new customer emails will receive the auto-response that you just set up.","txt.ms_email_connector.wizard-flow.subtitle_without_trigger":"This won't disrupt your existing systems or workflows. And if you decide Zendesk isn't for you, your data will be securely deleted.","txt.ms_email_connector.option_list_title":"Do you use any of these providers?","txt.ms_email_connector.no_connector_option.description":"We'll walk you through other options later.","txt.ms_email_connector.no_connector_option.title":"No, I don't use Gmail or Microsoft Exchange","txt.ms_email_connector.no_connector_option.title_v2":"Another email","txt.ms_email_connector.no_connector_option.description_v2":"Other email providers connect in a different way. You'll see those steps later","txt.ms_email_connector.micosoft_option_title_v2":"Microsoft Exchange","txt.ms_email_connector.micosoft_option.modal_subtitle_v2":"Connect the email account that your customers use to contact you, for example {{email}}. Connecting your email won't affect your current systems or workflows. If Zendesk isn't for you, your data is securely deleted.","txt.ms_email_connector.email-options.ms_option_description_v2":"New email sent to your Microsoft address will be automatically converted to tickets.","txt.ms_email_connector.email-options.gmail_option_description_v2":"New email sent to your Gmail inbox will be automatically converted to tickets.","txt.ms_email_connector.email-options.other_provider_title_v2":"Forward from another email","txt.ms_email_connector.email-options.other_provider_description_v2":"Forward email from another external account to be converted into tickets.","txt.ms_email_connector.error_state.permission_error_v2":"Zendesk needs permissions to connect to Microsoft. To connect, try again and {{bold_text}} permission request.","txt.ms_email_connector.error_state.error_user_already_exists_v2":"The email you entered is already a user identity and cannot also be a support address. If you'd like to use that email as your support address, delete it from the user it is currently associated with.","txt.custom-ticket-field-simple-setup.iframe.title":"Interactive setup to customize your ticket info","txt.custom-ticket-field-simple-setup.ingress.badge":"2-minute setup","txt.custom-ticket-field-simple-setup.ingress.header":"Customize your ticket info","txt.custom-ticket-field-simple-setup.ingress.body":"Add your own ticket fields to easily capture important details.","txt.custom-ticket-field-simple-setup.ingress.start-button":"Get started","txt.custom-ticket-field-simple-setup.ingress.dismiss-button":"Dismiss","txt.custom-ticket-field-simple-setup.ticket-field-tooltip.header":"Take it further with ticket forms","txt.custom-ticket-field-simple-setup.ticket-field-tooltip.body":"Preview how customers use these fields on a help center ticket form.","txt.custom-ticket-field-simple-setup.ticket-field-tooltip.link":"Go to customer view","txt.custom-ticket-field-simple-setup.notifications.success.header":"Custom fields added","txt.custom-ticket-field-simple-setup.notifications.success.link":"Manage in Admin center","txt.ai-agent-simple-setup.preview-page.title":"AI agent preview","txt.ai-agent-simple-setup.preview-page.instructions-header":"Use this chat widget to test your AI agent","txt.ai-agent-simple-setup.preview-page.instructions-description":"Your AI agent responds based on knowledge provided by you or your team. Add more knowledge in your Zendesk account to keep improving your AI agent's responses.","txt.ai-agent-simple-setup.preview-page.header-v2":"Test AI agent on this sample website","txt.ai-agent-simple-setup.preview-page.description-v2":"This is what your AI agent looks like in the Web Widget. Ask questions just like a customer would and see how it responds.","txt.ai-agent-simple-setup.preview-page.visibility-note":"Only people with the link can see this page, so feel free to share it with your team and show them what you've created.","txt.ai-agent-simple-setup.preview-page.bullet-title":"Try these to improve the experience:","txt.ai-agent-simple-setup.preview-page.bullet-1":"Update its knowledge sources for more accurate answers.","txt.ai-agent-simple-setup.preview-page.bullet-2":"Decide when it should hand things over to a human.","txt.ai-agent-simple-setup.preview-page.link-2-text":"Manage AI agent settings","txt.ai-agent-simple-setup.preview-page.link-1-text":"Manage knowledge","txt.ai-agent-simple-setup.chat-preview.default-bot-name":"AI agent","txt.ai-agent-simple-setup.help-center.article-title":"AI agent knowledge","txt.ai-agent-simple-setup.help-center.article-title-v2":"About us","txt.ai-agent-simple-setup.help-center.section-title":"Knowledge","txt.ai-agent-simple-setup.help-center.section-title-v2":"Company overview","txt.ai-agent-simple-setup.help-center.category-title":"General","txt.ai-agent-simple-setup.help-center.external-content.source-name":"AI agent external content source","txt.ai-agent-simple-setup.help-center.external-content.type-name":"AI agent external content type","txt.ai-agent-simple-setup.help-center.external-content.record-title":"AI agent external content record","txt.ai-agent-simple-setup.accelerated-setup.welcome-page.badge":"3-minute setup","txt.ai-agent-simple-setup.accelerated-setup.welcome-page.badge_v2":"3-min setup","txt.ai-agent-simple-setup.accelerated-setup.welcome-page.header":"Welcome to your free trial","txt.ai-agent-simple-setup.accelerated-setup.welcome-page.description":"The Zendesk Suite is your all-in-one, complete service solution for the AI era.","txt.ai-agent-simple-setup.accelerated-setup.welcome-page.info-blurb":"Let's get started by showing you how AI agents can automatically resolve 30%+ of your common customer questions.","txt.ai-agent-simple-setup.accelerated-setup.welcome-page.info-blurb-v2":"Let's get started by showing you how AI agents can automatically resolve your common customer questions.","txt.ai-agent-simple-setup.accelerated-setup.welcome-page.button-label":"Get started","txt.ai-agent-simple-setup.accelerated-setup.welcome-page.chat-bubble-1":"When will coffee preorder ship?","txt.ai-agent-simple-setup.accelerated-setup.welcome-page.chat-bubble-2":"Coffee preorders usually ship a day after it's in stock. You'll receive an email confirmation once the shipping label is generated.","txt.ai-agent-simple-setup.accelerated-setup.welcome-page.logo-aria-label":"Zendesk logo","txt.ai-agent-simple-setup.accelerated-setup.welcome-page.ai-icon-aria-label":"AI feature","txt.ai-agent-simple-setup.accelerated-setup.welcome-page.image-aria-label":"Two customers getting questions answered by AI agent","txt.ai-agent-simple-setup.accelerated-setup.add-team-page.header":"But first, invite people to join the AI experience","txt.ai-agent-simple-setup.accelerated-setup.add-team-page.header-v2":"First, invite people to join the AI experience","txt.ai-agent-simple-setup.accelerated-setup.add-team-page.description":"Your team works hand-in-hand with AI to deliver fast, accurate, and personal service to customers. Invite them now.","txt.ai-agent-simple-setup.accelerated-setup.add-team-page.email-field-label":"Send an email invite","txt.ai-agent-simple-setup.accelerated-setup.add-team-page.role-field-label":"Give them a role","txt.ai-agent-simple-setup.accelerated-setup.add-team-page.invite-button-label":"Invite","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.header":"Give your AI agent some brainpower","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.description":"Add your trusted knowledge so your AI agent can answer common customer questions with ease. You can start with the options below and update or expand anytime.","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.description-v2":"Add your trusted knowledge so your AI agent can answer common customer questions with ease.","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.paste-text-form.header":"Paste in knowledge","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.paste-text-form.description":"The more detail, the more specific your AI agent can be.","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.paste-text-form.placeholder":"For example: You can return your unused product within 30 days and choose store credit, an exchange, or a refund to your original payment.","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.paste-text-form.placeholder-v2":"For example: Our clothing is made from eco-friendly materials like organic cotton, recycled fabrics, and low-impact dyes. We also partner with ethical factories to ensure fair working conditions, and our designs focus on durability to reduce waste.","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.paste-text-form.update-button-label":"Update","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.paste-text-form.edit-button-label":"Edit knowledge","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.paste-text-form.empty-field-error":"Enter knowledge to test your AI agent.","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.paste-text-form.insufficient-text-warning":"Try adding more content to really see what your AI agent can do.","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.paste-text-form.sufficient-text-notification":"Great, this is a good amount of knowledge to get started.","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.paste-text-form.update-notification":"Updating AI agent knowledge...","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.paste-text-form.submission-success-notification":"Your AI agent will use this to give customers trusted answers.","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.paste-text-form.submission-error-notification":"Failed to add knowledge","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.footer.not-now-button-label":"Not now","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.footer.test-it-out-button-label":"Test it out","txt.ai-agent-simple-setup.accelerated-setup.add-knowledge-page.you-chat-label":"You","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.done-button-label":"Done","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.header":"Give it some personality","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.description":"Customize your AI agent to sound like it's part of your team.","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.ai-agent-field-label":"AI agent name","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.conversation-style-field-label":"Conversation style","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.informal-style-label":"Informal","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.informal-style-description":"Casual and friendly","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.professional-style-label":"Professional","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.professional-style-description":"Polite and direct","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.enthusiastic-style-label":"Enthusiastic","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.enthusiastic-style-description":"Upbeat and friendly","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.preview-chat.badge":"Ask AI agent questions","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.preview-chat.placeholder":"Ask a question","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.preview-chat.helper-text":"If it can't find an answer, the question goes to your team.","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.preview-chat.submit-button-label":"Send","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.missing-name-error":"Name is required","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.name-updated":"Name updated.","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.tone-updated":"Tone updated. Ask a question to see it in action.","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.characters_remaining.zero":"{{charactersRemaining}} characters remaining","txt.ai-agent-simple-setup.accelerated-setup.personalize-page.characters_remaining.one":"{{charactersRemaining}} charac