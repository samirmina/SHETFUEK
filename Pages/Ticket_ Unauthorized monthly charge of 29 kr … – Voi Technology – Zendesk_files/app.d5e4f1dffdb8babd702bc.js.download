interface CustomerEvent {
  id: ID!
  type: String!
  source: String!
  createdAt: String!
}

type TicketEvent implements CustomerEvent {
  id: ID!
  type: String!
  status: String!
  customStatus: String
  source: String!
  createdAt: String!

  title: String!
  url: String!
  commentCount: Int!
  firstComment: Comment
  lastComment: Comment
}

type OmniEvent implements CustomerEvent {
  id: ID!
  type: String!
  status: String!
  customStatus: String
  source: String!
  createdAt: String!

  title: String!
  url: String!
  firstComment: Comment
  lastComment: Comment
}

type CustomEvent implements CustomerEvent {
  id: ID!
  type: String!
  source: String!
  createdAt: String!

  properties: JSON!
  description: String

  namespace: SunshineProfileNamespace
}

type EventsList {
  count: Int!
  eventList: [CustomerEvent]!
}

type SunshineProfileIdentifier {
  type: String!
  value: String!
}

type SunshineProfileNamespace {
  ref_id: String!
  name: String!
}

type SunshineProfile {
  id: ID!
  source: String!
  type: String!
  identifiers: [SunshineProfileIdentifier]!
  attributes: JSON
  name: String!
  namespace: SunshineProfileNamespace
}

type EventTypePermission {
  role: String!
  read: Boolean
  write: Boolean
}

type SunshineEventType {
  source: String!
  type: String!
  namespace: SunshineProfileNamespace
}

type Profile {
  id: ID!
  user: User!
  language: String
  sharedPhoneNumber: String
  facebookAccounts: [UserIdentity]!
  twitterAccounts: [UserIdentity]!
  emailAccounts: [UserIdentity]!
  phoneNumbers: [UserIdentity]!
  events: EventsList!
  profiles: [SunshineProfile]
  eventTypes: [SunshineEventType]
  tickets: [CustomerEvent]
}

type Sunshine {
  events: [CustomEvent]
}

extend type Query {
  customer(id: ID!, timezoneOffset: String): Profile
  sunshine(userId: ID!, source: String, type: String, namespace: String): Sunshine
}
