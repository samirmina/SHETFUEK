#import './LegacyLocalGraphIntervalFragment.gql'
#import './LegacyLocalGraphTimeZoneFragment.gql'

query editSchedule($scheduleId: ID!) {
  timeZones {
    ...TimeZoneFragment
  }
  schedule(id: $scheduleId) {
    id
    name
    timeZone {
      ...TimeZoneFragment
    }
    intervals {
      ...IntervalFragment
    }
    holidays {
      id
      ...HolidayFragment
    }
    createdAt
    updatedAt
  }
}
