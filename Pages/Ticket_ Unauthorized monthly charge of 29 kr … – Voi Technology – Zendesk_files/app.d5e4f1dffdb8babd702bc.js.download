# TODO: Move this to a more common location if there are more usages outside this file
scalar MultiOrSingleStringInput

input ActionInput {
  field: String!
  value: MultiOrSingleStringInput
}

input MacroActionInput {
  field: String
  value: String
}

input ConditionFieldInput {
  field: String!
  operator: String
  value: String
}

input TriggerMetadataInput {
  temporary_id: ID
  notify_agents_id: ID
  request_received_id: ID
  proactive_id: ID
}

input MacroMetadataInput {
  accelerated_setup_id: ID
  customer_not_responding_id: ID
  downgrade_and_inform_id: ID
}

input MetadataInput {
  """
  for triggers
  """
  temporary_id: ID
  notify_agents_id: ID
  request_received_id: ID
  proactive_id: ID
  """
  for macros
  """
  accelerated_setup_id: ID
  customer_not_responding_id: ID
  downgrade_and_inform_id: ID
}

input CoditionsInput {
  all: [ConditionFieldInput!]
  any: [ConditionFieldInput!]
}

input TicketRequesterInput {
  name: String!
  email: String!
  role: String
}

input TicketCommentInput {
  body: String
  html_body: String
}

input TicketEmailCcsInput {
  user_email: String
  user_id: String
}

input TicketViaInput {
  channel: Int
}

input AcceleratedSetupTicketInput {
  subject: String!
  comment: TicketCommentInput!
  requester: TicketRequesterInput!
  tags: [String!]
  priority: String
  type: String
  email_ccs: [TicketEmailCcsInput!]
  via: TicketViaInput!
}

input AcceleratedSetupTriggerInput {
  title: String
  description: String
  actions: [ActionInput!]
  conditions: CoditionsInput
  category_id: String
  active: Boolean
}

input AcceleratedSetupMacroInput {
  title: String
  actions: [MacroActionInput!]
  active: Boolean
  position: Int
}

type ActionResponse {
  field: String!
  value: MultiOrSingleStringInput
}

type ConditionResponse {
  field: String!
  operator: String!
  value: String
}

type ConditionsResponse {
  all: [ConditionResponse!]!
  any: [ConditionResponse!]!
}

type TriggerObj {
  id: ID!
  category_id: String!
  url: String!
  title: String!
  description: String
  position: Int
  active: Boolean
  actions: [ActionResponse!]!
  conditions: ConditionsResponse!
  updated_at: String!
  created_at: String!
  raw_title: String!
}

type MacroActionObj {
  field: String
  value: String
}

type MacroObj {
  id: ID!
  title: String!
  position: Int!
  active: Boolean!
  actions: [MacroActionObj!]
}

type TicketObj {
  id: ID!
}

type TriggersResponse {
  triggers: [TriggerObj!]
}

type TriggerResponse {
  trigger: TriggerObj!
}

type MacrosResponse {
  macros: [MacroObj!]
}

type MacroResponse {
  macro: MacroObj!
}

type TicketResponse {
  ticket: TicketObj!
}

type FuseResponse {
  id: ID
  account_id: ID!
  user_id: ID!
  fuse_name: String!
  completed: Boolean!
  metadata: JSON
}

extend type Query {
  getActiveTriggers: TriggersResponse
  getTrigger(triggerId: ID!): TriggerResponse
  getMacro(macroId: ID!): MacroResponse
  getActiveMacros: MacrosResponse
  getFuse(namespace: String!, fuseName: String!): FuseResponse
}

extend type Mutation {
  setFuse(namespace: String!, fuseName: String!, metadata: MetadataInput): FuseResponse
  createTrigger(trigger: AcceleratedSetupTriggerInput!): TriggerResponse
  updateTrigger(triggerId: ID!, trigger: AcceleratedSetupTriggerInput!): TriggerResponse
  deleteTrigger(triggerId: ID!): String
  createMacro(macro: AcceleratedSetupMacroInput!): MacroResponse
  updateMacro(macroId: ID!, macro: AcceleratedSetupMacroInput!): MacroResponse
  createOnboardingTicket(ticket: AcceleratedSetupTicketInput!): TicketResponse
}
