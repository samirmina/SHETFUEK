// gets requester ID
(function () {
    var client = ZAFClient.init();
    client.invoke('resize', { height: '600px' });

    var user_email; 
    var user_phone;
    var user_id;
    var externalId;
    var user_name;
    var user_phoneId;
    var ticket_id;
    
    Promise.all([
        client.get('ticket.requester'),
        client.get('ticket.id')
    ]).then(function(results) {
        var requesterData = results[0]['ticket.requester'];
        var ticketData = results[1]; // This will contain the ticket ID

        // Now we can extract the information needed
        user_id = requesterData.id;
        externalId = requesterData.externalId;
        user_name = requesterData.name;
        user_email = requesterData.email;
        ticket_id = ticketData['ticket.id']; // Correctly accessing the ticket ID

        console.log('Requester Email:', user_email);
        console.log('Ticket ID:', ticket_id);

        // Process identities (if needed, similar to your existing code)
        var identities = requesterData.identities;
        if (Array.isArray(identities) && identities.length > 0) {
            console.log('Processing identities...');
            for (var i = 0; i < identities.length; i++) {
                if (identities[i].type === 'phone_number') {
                    user_phone = identities[i].value;
                    user_phoneId = identities[i].id;
                    break; // Found the phone identity, break the loop
                }
            }
        }
            
        	if (user_email || user_phone) {
        	
                var requestBody = {
                    "fields_to_export": [
                        "first_name",
                        "external_id",
                        "phone",
                        "email",
                        "home_city",
                        "country",
                        "email_subscribe",
                        "push_subscribe",
                        "custom_attributes",
                        "custom_events",
                        "devices",
                        "apps"
                    ]
                };
                
                if (user_email) {
                requestBody["email_address"] = user_email;
            	} else 
            	if (user_phone) {
            	requestBody["phone"] = user_phone;
            	}
                
                return requestBrazeUser (client, requestBody, user_id, user_email, externalId, user_name, user_phoneId);
        	} else {
        		console.log('No email or phone available');
                document.getElementById('content').innerHTML = 'No Braze info because no email or phone from Zendesk profile';
                return Promise.resolve(null);
            }
}
    ).then(
        function (brazeUserInfo) {
        	if (!brazeUserInfo) {
        		return;
        	}
        
            if (brazeUserInfo && brazeUserInfo.brazeRider) {
                // Pass both rider and data to showInfo
                return showInfo(brazeUserInfo, client, user_email, user_id, user_name, user_phone, externalId, user_phoneId, ticket_id);
            
            } else {
                console.warn('No rider value. showInfo will not be called.');
                document.getElementById('content').innerHTML = 'No User found in Braze';
            }
        }

    ).catch(
        function (error) {
            console.error(error);
        }
    );
})();

	// Braze query with email or phone
	function requestBrazeUser(client, requestBody, user_id) {
    var settings = {
        url: 'https://rest.fra-01.braze.eu/users/export/ids',
        type: 'POST',
        dataType: 'json',
        headers: {
            'Authorization': 'Bearer {{setting.apiToken}}',
            'Content-Type': 'application/json', // Adjust content type based on your needs
        },
        secure: true,
        data: JSON.stringify(requestBody),
    };

    return client.request(settings).then(
        function (data) {
            // Extract the 'rider' value from the Braze API response
            const brazeUser = data && data.users && data.users.length > 0 ? data.users[0] : null;
            const brazeRider = brazeUser ? brazeUser.external_id || '-' : null;


            // Return the 'rider' value and the entire Braze data
            return { brazeRider: brazeRider, data: data };
        }
    );
}

	// data from Braze for html
	function showInfo(brazeUserInfo, client, user_email, user_id, user_name, user_phone, externalId, user_phoneId, ticket_id) {

        // Initial check for the number of users
    if (brazeUserInfo && brazeUserInfo.data.users) {
        const users = brazeUserInfo.data.users;
        const usersLength = users.length;
        
        if (usersLength > 1) {
            console.warn('Multiple users found.');
            // Build a message string that includes the external_ids
            let message = 'Multiple users found. Please check. <br>User IDs:<br>';
            users.forEach(user => {
                message += `${user.external_id}<br>`; // Append each external_id to the message
            });
            document.getElementById('content').innerHTML = message;
            return; // Exit the function early
        } else if (usersLength === 0) {
            console.warn('No users found.');
            document.getElementById('content').innerHTML = 'No User found in Braze';
            return; // Exit the function early
        }
    }
    
    // Extract user information from the Braze response
    const user = brazeUserInfo && brazeUserInfo.data.users && brazeUserInfo.data.users.length === 1 ? brazeUserInfo.data.users[0] : null;

    if (user) {
        const brazeRider = user.external_id;
        const brazePhone = user.phone;
        const brazeEmail = user.email;
        const brazeName = user.first_name;
        const brazeCity = user.home_city;
        const brazeCountry = user.country;
        const ticketId = ticket_id;
        
        const formatDeviceDetails = (devices) => {
      return devices.map(device => `Model: ${device.model}, OS: ${device.os}`).join('<br>');
    };
    
    	const formatAppDetails = (app) => {
            if (!app) return 'No apps';
              return `${app.name}<br>Platform: ${app.platform}<br>Version: ${app.version}`;
        };

        
        var requester_data = {
      'name': user.first_name || '-',
      'email': user.email || '-',
      'rider': user.external_id,
      'phone': user.phone || '-',
      
      'city': user.home_city || '-',
      'country': user.country || '-',
      'email_sub': user.email_subscribe || '-',
      'push_sub': user.push_subscribe || '-',
      'has_payment': user.custom_attributes.Has_payment !== null && user.custom_attributes.Has_payment !== undefined ? user.custom_attributes.Has_payment : '-',
      'has_debt': user.custom_attributes.has_debt !== null && user.custom_attributes.has_debt !== undefined ? user.custom_attributes.has_debt : '-',
      'customEvent': user.custom_events && getCustomEventByCondition(user.custom_events, event => event.name === 'account_created') || { last: '-' },
      'push_at': user.push_opted_in_at || '-',
      'voi_pass': user.custom_attributes.active_voipass || '-',
      'devices': user.devices ? formatDeviceDetails(user.devices) : 'No devices',
      'apps': user.apps && user.apps.length > 0 ? formatAppDetails(user.apps[0]) : 'No apps',
    };

        var source = document.getElementById("requester-template").innerHTML;
        var template = Handlebars.compile(source);
        var html = template(requester_data);
        document.getElementById("content").innerHTML = html;
        populateEmailSubscriptionSelect(requester_data.email_sub, brazeEmail, client);
        
		var acc = document.getElementsByClassName("accordion");
		var i;

		for (i = 0; i < acc.length; i++) {
		acc[i].addEventListener("click", function() {
		this.classList.toggle("active");
		var panel = this.nextElementSibling;
		if (panel.style.display === "block") {
		panel.style.display = "none";
  } else {
		panel.style.display = "block";
		panel.style.maxHeight = panel.scrollHeight + "px";
    }
  });
}

		function formatCityValue(cityName) {
  		  return cityName.toLowerCase().replace(/\s+/g, '_');
}

		if (brazeCity) {
   			const formattedCity = formatCityValue(brazeCity); // 
    		updateTicketCustomField(client, ticketId, formattedCity, brazeCountry);
}

        // brazePhone has value and user_phone has value and they are different, update identity
        
        if (brazePhone && user_phone && brazePhone !== user_phone.replace(/\D/g, '')) {
        	console.log('Braze phone exists, user_phone is different. updating user phone');

			 const updatedBody = {
        	"identity": {
            "url": "https://voitechnology.zendesk.com/api/v2/users/" + user_id + "/identities/" + user_phoneId + ".json",
            "id": user_phoneId,
            "user_id": user_id,
            "type": "phone_number",
            "value": brazePhone, // Update the value with brazePhone
            "verified": true
        }
    };

        	 const options = {
  				url: '/api/v2/users/' + user_id + '/identities/' + user_phoneId,
  				type: "PUT",
  				contentType: 'application/json',
  				data: JSON.stringify(updatedBody) 
			};

				client.request(options).then((response) => {
 				console.log(response);
 				
			}).catch((error) => {
    		console.error('Error', error);

       		const responseText = error.responseText || 'Unknown error';
   			console.log('Response Text:', responseText);
   			
   			// Check if the error status is 422
    		if (error.status === 422) {
        	// Display an error message in your HTML
        	const errorMessage = 'Info: Phone number already in use, no update to Zendesk customer.';
        	document.getElementById('error-message').innerHTML = errorMessage;
    }


});
        
        // If brazePhone has a value and user_phone does not have a value, create identity
        } else if (brazePhone && !user_phone) {
        	console.log('Braze phone exists, but user_phone does not exist. creating user phone');
        	
        	
            const identityData = {
        	 identity: {
            type: "phone_number",
            value: brazePhone
        }
    };
        	 const options = {
  				url: '/api/v2/users/' + user_id + '/identities',
  				type: "POST",
  				contentType: 'application/json',
  				 data: JSON.stringify(identityData)
			};

				client.request(options).then((response) => {
 				console.log(response);
				    }).catch((error) => {
        console.error('Error', error);

        const responseText = error.responseText || 'Unknown error';
        console.log('Response Text:', responseText);

        // Check if the error status is 422
        if (error.status === 422) {
            // Display an error message in your HTML
            const errorMessage = 'Info: Phone number already in use, no update to Zendesk customer.';
            document.getElementById('error-message').innerHTML = errorMessage;
        }
    });

        
    	// If brazePhone has no value anymore and user_phone does, then delete user_phone number
        } else if (!brazePhone && user_phone) {
            console.log('Braze phone does not exist, but user_phone exists. Deleting user phone');
            console.log('phoneID: ' + user_phoneId);
            
            const options = {
  				url: '/api/v2/users/' + user_id + '/identities/' + user_phoneId,
  				type: "DELETE",
  				contentType: 'application/json',
			};

				client.request(options).then((response) => {
 				console.log(response);
				});
		
} 		else {
    	console.log('No change in phone. No update to Zen user record.');
  }

        // Call processZenUser with the required parameters
		if ((!externalId && brazeUserInfo && brazeUserInfo.brazeRider) || (externalId !== brazeUserInfo.brazeRider)) {
            console.log('ext ID is empty or mismatched. Calling processZenUser...');
            processZenUser(client, user_id, brazeUserInfo, brazeRider, brazeEmail, brazeName);
        } else {
            console.log('Ext ID matched. No update to Zen user record.');
        }
    } else {
        console.warn('No rider value. showInfo will not be called.');
        document.getElementById('content').innerHTML = 'No User found in Braze';
    }
}
	//Email Sub Populate
	function populateEmailSubscriptionSelect(emailSubStatus, brazeEmail, client) {
    const options = ['opted_in', 'subscribed', 'unsubscribed'];
    const select = document.getElementById('emailSubscriptionSelect');
    
    // Ensure the select element exists
    if (select) {
      select.innerHTML = '';
      
        options.forEach((option) => {
            const isSelected = option === emailSubStatus;
            const opt = document.createElement('option');
            opt.value = option;
            opt.textContent = option;
            opt.selected = isSelected; // Make the current status selected by default
            select.appendChild(opt);
        });
        
         select.addEventListener('change', function() {
            const selectedOption = this.value;
            // Call the function to send the REST API request

            updateEmailSubscriptionStatus(client, brazeEmail, selectedOption);
        });
    }
}	

	//Email Sub Update
	function updateEmailSubscriptionStatus(client, brazeEmail, subscriptionState) {
    var settings = {
        url: 'https://rest.fra-01.braze.eu/email/status',
        type: 'POST',
        dataType: 'json',
        headers: {
            'Authorization': "Bearer {{setting.apiToken}}",
            'Content-Type': 'application/json',
        },
        secure: true,
        data: JSON.stringify({
            email: brazeEmail,
            subscription_state: subscriptionState
        }),
    };

    return client.request(settings).then(
        function (data) {
            console.log('Success:', data);
            // Handle success response
        },
        function (error) {
            console.error('Error:', error);
            // Handle error response
        }
    );
}



	// Zendesk Record
	function processZenUser(client, user_id, brazeUserInfo, brazeRider, brazeEmail, brazeName) {
        var url = brazeRider ? 'https://fm.voiapp.io/riders/' + brazeRider : null;

        var requestData = {
            user: {
                "name": brazeName,
                "external_id": brazeRider,
                "email": brazeEmail,
                "user_fields": {
                    "fm_link": url
                }
            }
        };

        var settings = {
            url: `/api/v2/users/${user_id}.json`,
            type: 'PUT',
            contentType: 'application/json',
		    data: JSON.stringify(requestData)
        };

        return client.request(settings)
            .then(response => {
                // Log success message here
                console.log('Success: User data updated successfully for user_id:', user_id);
                return response; // You can return the response if needed
            })
            .catch(error => {
                // Handle errors here
                console.error('Error in processZenUser:', error);
                

        if (error.status === 422) {
            // Display an error message in your HTML
            const errorMessage = 'Info: Email address already in use, no update to Zendesk customer.';
            document.getElementById('error-message').innerHTML = errorMessage;
        }
    });
}

	// Updating City and Country fields
	function updateTicketCustomField(client, ticketId, formattedCity, brazeCountry) {
    client.get(`ticket.customField:custom_field_${17912134696989}`).then(function(customFieldData) {
        const currentCustomFieldValue = customFieldData[`ticket.customField:custom_field_${17912134696989}`];

        // Check if the custom field is currently empty
        if (!currentCustomFieldValue) {
            // If the field is empty, proceed with the update
            const data = {
                "ticket": {
                    "custom_fields": [
                    	{ "id": 17912134696989, "value": formattedCity },
                    	{ "id": 17895789388573, "value": brazeCountry}
                    	]
                }
            };

            client.request({
                url: `/api/v2/tickets/${ticketId}`,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify(data),
            }).then(function(response) {
                console.log('Ticket custom field updated successfully.', response);
            }).catch(function(error) {
                console.error('Error updating ticket custom field:', error);
            });
        } else {
            console.log('Custom field is not empty. No update performed.');
        }
    }).catch(function(error) {
        console.error('Error fetching current custom field value:', error);
    });
}

	// Separate function to get custom events based on a condition
	function getCustomEventByCondition(customEvents, condition) {
    const matchingEvent = customEvents.find(event => condition(event));
    return matchingEvent || null;
}

	function showError(response) {
    var error_data = {
        'status': response.status,
        'statusText': response.statusText
    };

    var source = document.getElementById("error-template").innerHTML;
    var template = Handlebars.compile(source);
    var html = template(error_data);
    document.getElementById("content").innerHTML = html;
}



	// Define the Handlebars helper
	Handlebars.registerHelper('formatDate', function (date) {
    if (!date || date === '-') {
        return '-';
    }

    const formattedDate = new Date(date);
    const options = {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        hour: 'numeric',
        minute: 'numeric',
        second: 'numeric',
        timeZone: 'UTC', 
        timeZoneName: 'short'
    };

    if (isNaN(formattedDate)) {
        return '-';
    }

    return formattedDate.toLocaleString('en-GB', options);
});


