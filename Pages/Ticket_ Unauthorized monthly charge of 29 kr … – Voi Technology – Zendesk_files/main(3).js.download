(function () {
  var client = ZAFClient.init();
  client.invoke('resize', { height: '0px' });

  // Shared / partner-integration mailboxes that legitimately create many
  // parallel open tickets from the same address (B2B MaaS partners, transit
  // operators, etc.). Flagging these as "duplicates" is just noise for
  // agents, so the duplicate search is skipped entirely for these
  // requester emails. Matched case-insensitively.
  var EXCLUDED_REQUESTER_EMAILS = [
    'support@jelbi.de',
    'verkehrsbetriebe@l.de',
    'partnerservice@moovel.com',
    'info@yumuv.ch',
    'cs@splyt.com',
    'support.mvgo@mvg.de',
    'travis@nobina.com',
    'support@urbi.co',
    'help@free-now.com',
    'happytohelp@floya.brussels',
    'info@whimapp.com',
    'servizi.mobilita@telepass.it',
    'support@breezeuk.app',
    'support@rheinbahn.de',
    'support@ruter.no',
    'support-voi@bonjour-ratp.fr',
    'support@meep.me',
    'info@hvv-switch.de',
    'regiomove-support@kvv.karlsruhe.de',
    'info@mova.de',
    'nuernbergmobil@vag.de',
    'assistenza@wetaxi.it',
    'ronja.eid@atb.no'
  ];

  // Internal Voi staff addresses. Distinct from the partner list above —
  // included so the duplicate check doesn't fire on tickets raised by/for
  // staff themselves. Matched case-insensitively.
  var EXCLUDED_INTERNAL_STAFF_EMAILS = [
    'oliver.sharp@voiapp.io',
    'katie.wilson@voiapp.io',
    'kenan.poricanin@voiapp.io',
    'richard.dealmada@voiapp.io',
    'pedro.francisco@voiapp.io',
    'alan.tonello@voiapp.io',
    'valentina.spalla@voiapp.io',
    'paul.vogt@voiapp.io',
    'dhelma.salazar@voiapp.io'
  ];

  function isExcludedRequester(email) {
    if (!email) return false;
    var normalized = email.toLowerCase();
    return EXCLUDED_REQUESTER_EMAILS.indexOf(normalized) !== -1
      || EXCLUDED_INTERNAL_STAFF_EMAILS.indexOf(normalized) !== -1;
  }

  // A native_messaging ticket is treated as "still may have a live chat
  // session" until a Zendesk trigger tags it session_ended (added once the
  // session has actually ended, per the ops team's own trigger). This is
  // the single source of truth — no client-side inference about comment
  // counts or ZAF session flags, both of which turned out unreliable for
  // this channel in real-world testing.
  function isBlockedMessagingTicket(via, tags) {
    return !!(via && via.channel === 'native_messaging'
      && (tags || []).indexOf('session_ended') === -1);
  }

  Promise.all([
    client.get('ticket.requester'),
    client.get('ticket.id'),
    client.get('ticket.assignee'),
    client.get('ticket.status'),
    client.get('ticket.subject'),
    client.get('ticket.createdAt'),
    client.get('ticket.via'),
    client.get('ticket.tags'),
    client.context()
  ]).then(function (results) {
    var requester        = results[0]['ticket.requester'];
    var currentTicketId  = results[1]['ticket.id'];
    var currentAssignee  = results[2]['ticket.assignee'];
    var currentStatus    = results[3]['ticket.status'];
    var currentSubject   = results[4]['ticket.subject'];
    var currentCreatedAt = results[5]['ticket.createdAt'];
    var currentVia       = results[6]['ticket.via'];
    var currentTags      = results[7]['ticket.tags'];
    var subdomain        = results[8].account.subdomain;

    // Don't run on tickets that are already solved/closed — including
    // tickets closed_by_merge. Nothing useful comes from flagging
    // duplicates on a ticket the agent can no longer act on.
    if (currentStatus === 'solved' || currentStatus === 'closed') {
      return;
    }

    if (!requester) { console.warn('[DupAlert] No requester — aborting.'); return; }

    if (isExcludedRequester(requester.email)) {
      console.log('[DupAlert] Requester on exclusion list — skipping duplicate check.');
      return;
    }

    // If the current ticket is a messaging-channel ticket whose session
    // hasn't been marked ended (session_ended tag), don't even run the
    // duplicate check — surfacing a merge prompt for a ticket the agent
    // must not touch has no upside.
    if (isBlockedMessagingTicket(currentVia, currentTags)) {
      console.log('[DupAlert] Current ticket is a messaging ticket without session_ended — skipping duplicate check.');
      return;
    }

    runDuplicateSearch();

    function runDuplicateSearch() {
      var openQuery = requester.email
        ? 'requester:"' + requester.email + '" status<solved type:ticket'
        : 'requester_id:' + requester.id + ' status<solved type:ticket';

      client.request({ url: '/api/v2/search.json?query=' + encodeURIComponent(openQuery), type: 'GET' }).then(function (searchResult) {
        // Excludes tickets already closed by an earlier merge, and tickets an
        // agent has already reviewed and explicitly dismissed as "not a
        // duplicate" via the Keep separate action (tag: dup_dismissed).
        var candidates = (searchResult.results || []).filter(function (t) {
          return t.id !== currentTicketId
            && (t.tags || []).indexOf('closed_by_merge') === -1
            && (t.tags || []).indexOf('dup_dismissed') === -1;
        });

        // Any candidate that's itself a messaging ticket without
        // session_ended needs to be excluded from the merge-target list —
        // otherwise the current ticket could still get merged INTO an
        // active chat, ending it just as surely as merging one away would.
        var openTickets = candidates.filter(function (t) {
          return !isBlockedMessagingTicket(t.via, t.tags);
        });

        showModalIfAny(openTickets);

        function showModalIfAny(openTickets) {
          if (openTickets.length > 0) {
            openModal(openTickets, {
              id:         currentTicketId,
              subject:    currentSubject,
              status:     currentStatus,
              createdAt:  currentCreatedAt,
              assigneeId: (currentAssignee && currentAssignee.user && currentAssignee.user.id) ? currentAssignee.user.id : null
            }, subdomain, client);
          }
        }

      }).catch(function (err) {
        console.error('[DupAlert] Search failed:', err.status, err.responseText);
      });
    }

  }).catch(function (err) {
    console.error('[DupAlert] ZAF client.get failed:', err);
  });


  function openModal(tickets, current, subdomain, client) {
    var ticketData = tickets.slice(0, 10).map(function (t) {
      return { id: t.id, subject: t.subject, status: t.status, assignee: t.assignee_id || null, created_at: t.created_at, updated_at: t.updated_at };
    });

    var hash = 'tickets='            + encodeURIComponent(JSON.stringify(ticketData))
             + '&currentId='         + encodeURIComponent(current.id)
             + '&currentSubject='    + encodeURIComponent(current.subject || '')
             + '&currentStatus='     + encodeURIComponent(current.status || '')
             + '&currentCreatedAt='  + encodeURIComponent(current.createdAt || '')
             + '&subdomain='         + encodeURIComponent(subdomain)
             + '&currentAssigneeId=' + encodeURIComponent(current.assigneeId || '');

    client.invoke('instances.create', {
      location: 'modal',
      url: 'assets/modal.html#' + hash,
      size: { width: '1040px', height: '780px' }
    }).then(function (modalContext) {
      var instanceGuid = modalContext['instances.create'][0].instanceGuid;
      var modalClient  = client.instance(instanceGuid);

      modalClient.on('dup.merge', function (data) {
        mergeTickets(data, client, modalClient);
      });

    }).catch(function (err) {
      console.error('[DupAlert] Failed to open modal:', err);
    });
  }


  // ---------------------------------------------------------------------------
  // mergeTickets — uses the official Zendesk merge endpoint:
  //   POST /api/v2/tickets/{primaryId}/merge
  //
  // The primary (target) ticket ID goes in the URL path.
  // The secondary (source) ticket ID goes in the body as ids: [secondaryId].
  // Returns a job_status object — merge runs as a background job.
  // ---------------------------------------------------------------------------
  function mergeTickets(mergeData, client, modalClient) {
    var primaryId   = mergeData.primaryId;
    var secondaryId = mergeData.secondaryId;

    // Native merge only carries the LAST public comment + a link into the
    // target ticket by default — and since we override target_comment
    // ourselves, even that default is lost unless we build it back in.
    // So: fetch the full comment thread from the secondary ticket first
    // and write it into target_comment as a transcript. Also fetch the
    // primary ticket's current status — Zendesk doesn't change the
    // target's status as a side effect of merging (confirmed: a Pending
    // ticket that absorbs a merge stays Pending), so if the app wants
    // "receiving a merge should surface as needing fresh attention," it
    // has to do that explicitly, as a follow-up step after the merge.
    // Also fetch the current agent's own ID, to detect a self-merge (the
    // agent merging their own assigned ticket) — no notification tag gets
    // added in that case, since there's no one else to notify.
    Promise.all([
      client.request({ url: '/api/v2/tickets/' + secondaryId + '.json', type: 'GET' }),
      client.request({ url: '/api/v2/tickets/' + secondaryId + '/comments?include=users&per_page=100', type: 'GET' }),
      client.get('currentUser'),
      client.request({ url: '/api/v2/tickets/' + primaryId + '.json', type: 'GET' })
    ]).then(function (results) {
      var secondaryTicket = results[0].ticket;
      var commentsRes     = results[1];
      var currentUser     = results[2].currentUser;
      var primaryTicket   = results[3].ticket;

      // Final safety net, re-checked right at merge time rather than only
      // when the sidebar first loaded — e.g. the duplicate modal could
      // have been sitting open while a live chat session started on
      // either ticket in the meantime. Same session_ended-tag rule as the
      // sidebar check and candidate filtering (see isBlockedMessagingTicket).
      if (isBlockedMessagingTicket(secondaryTicket && secondaryTicket.via, secondaryTicket && secondaryTicket.tags)
        || isBlockedMessagingTicket(primaryTicket && primaryTicket.via, primaryTicket && primaryTicket.tags)) {
        var blockedErr = new Error('This merge was blocked: one of these tickets is a messaging ticket whose session hasn\'t ended yet. Wait for the session_ended tag, then try again.');
        blockedErr.isSessionBlock = true;
        throw blockedErr;
      }

      var hasAssignee = secondaryTicket && !!secondaryTicket.assignee_id;
      var isSelfMerge  = hasAssignee && currentUser && secondaryTicket.assignee_id === currentUser.id;
      // If there's no assignee at all, Zendesk's own "auto-assign on solve"
      // rule will assign the merging agent to this ticket the moment it
      // closes — making a "notify the assignee" email a self-notification
      // by the time it lands. So an unassigned ticket is treated the same
      // as a self-merge: no notify tag.
      var shouldNotifyAssignee = hasAssignee && !isSelfMerge;

      // Merging never changes the primary ticket's own status (confirmed
      // Zendesk platform behavior) — so if it isn't already Open, bump it
      // after the merge completes, as a deliberate signal to the assignee
      // that something changed on a ticket they're actively working.
      var needsOpenBump = primaryTicket && primaryTicket.status !== 'open';

      var users = {};
      (commentsRes.users || []).forEach(function (u) { users[u.id] = u.name; });

      var MERGE_MARKER = '🔀 Ticket #';
      var priorMergeCount = 0;

      var transcript = (commentsRes.comments || []).map(function (c) {
        var body = decodeHtmlEntities((c.plain_body || c.body || '').trim());

        // This comment IS one of our own merge notes from an earlier round —
        // collapse it to just its first line instead of re-embedding the
        // full nested transcript it's carrying. The complete history still
        // lives permanently on that linked ticket if anyone needs to dig in.
        if (body.indexOf(MERGE_MARKER) === 0) {
          priorMergeCount++;
          return body.split('\n')[0];
        }

        var author     = users[c.author_id] || ('User #' + c.author_id);
        var date       = new Date(c.created_at).toLocaleString('en-GB', {
          day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
        });
        var visibility = c.public ? 'Public' : 'Internal note';
        return '[' + visibility + ' — ' + author + ' — ' + date + ']\n' + body;
      }).join('\n\n---\n\n');

      // Ticket comment bodies are capped at 64kB by Zendesk, and anything
      // over that is silently truncated with NO error reported — meaning a
      // custom comment that's too large can just quietly not appear as
      // expected. Cap well under that ourselves, with a clear note and a
      // link back to the source ticket, so we never depend on Zendesk's
      // silent behavior for something this size-sensitive.
      var TRANSCRIPT_MAX_CHARS = 40000;
      var wasTranscriptTruncated = transcript.length > TRANSCRIPT_MAX_CHARS;
      if (wasTranscriptTruncated) {
        transcript = transcript.slice(0, TRANSCRIPT_MAX_CHARS);
      }

      var priorMergeNote = priorMergeCount > 0
        ? '(This ticket had already absorbed ' + priorMergeCount + ' earlier merged ticket' + (priorMergeCount > 1 ? 's' : '') + ' — see the linked ticket numbers below for full history.)'
        : '';

      var dateOnly = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      var timeOnly = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });

      // The merge endpoint's target_comment/source_comment are plain-text
      // only — there's no html_body equivalent for this specific endpoint,
      // unlike the general ticket-comment endpoint. So this stays short and
      // plain; the full transcript goes in a follow-up note instead (built
      // below), which uses the general endpoint's real html_body support
      // for readable formatting (see NOTE below on why it's plain <p>/<br>
      // rather than a collapsible block).
      var targetComment =
        '🔀 Ticket #' + secondaryId + ' merged into this case by '
        + (mergeData.mergedByName || 'Agent') + ' on ' + dateOnly + ' at ' + timeOnly + '. Full transcript added as a follow-up note below.';

      var sourceComment = 'This ticket has been merged into #' + primaryId + '. Please continue the conversation there.';

      // NOTE: <details>/<summary> were tried here for a genuine click-to-
      // expand experience, but real-world testing confirmed Zendesk's
      // html_body sanitizer strips those specific tags — it keeps their
      // text content but drops the interactive behavior, which left a
      // misleading "click to expand" label sitting above content that was
      // already fully shown. Reverted to a plain header — no false promise
      // of interactivity, same reliable rendering this app used before.
      var followUpHtmlBody =
        (priorMergeNote ? '<p>' + escapeHtml(priorMergeNote) + '</p>' : '')
        + '<p><strong>── Transcript of merged ticket #' + secondaryId + ' ──</strong></p>'
        + '<p>' + escapeHtml(transcript || '(no comments on merged ticket)').replace(/\n/g, '<br>') + '</p>'
        + (wasTranscriptTruncated ? '<p><em>Transcript truncated — see ticket #' + secondaryId + ' for full history.</em></p>' : '');

      var requestBody = {
        ids:                      [secondaryId],
        target_comment:           targetComment,
        source_comment:           sourceComment,
        target_comment_is_public: false,
        source_comment_is_public: false
      };

      // Add the "merge_notify_assignee" tag before merging — but only if
      // there's an assignee who isn't the merging agent themselves. A
      // Zendesk trigger (Tags contains merge_notify_assignee) is what
      // actually sends the email; the app just decides whether that email
      // is warranted, since it's the only side that knows both the current
      // agent's ID and the (pre-merge) assignee's ID at this point. Must
      // happen before the merge call — Zendesk blocks tag changes on
      // already-closed tickets, and the source closes immediately on merge.
      var prep = Promise.resolve();

      if (shouldNotifyAssignee) {
        prep = prep.then(function () {
          return client.request({
            url:         '/api/v2/tickets/' + secondaryId + '/tags',
            type:        'PUT',
            contentType: 'application/json',
            data:        JSON.stringify({ tags: ['merge_notify_assignee'] })
          });
        });
      }

      return prep.then(function () {
        // Correct endpoint: POST /api/v2/tickets/{target_ticket_id}/merge
        // source_comment_is_public is always false — the requester is never
        // notified. Assignee notification (if any) is handled entirely by
        // the merge_notify_assignee tag + Zendesk trigger set up above.
        return client.request({
          url:         '/api/v2/tickets/' + primaryId + '/merge',
          type:        'POST',
          contentType: 'application/json',
          data:        JSON.stringify(requestBody)
        });
      }).then(function (response) {
        return { response: response, followUp: { needsOpenBump: needsOpenBump, htmlBody: followUpHtmlBody } };
      });

    }).then(function (result) {
      var response  = result.response;
      var followUp   = result.followUp;
      // Response is a job_status object — poll until complete
      var jobUrl = response.job_status && response.job_status.url;
      if (jobUrl) {
        pollJobStatus(jobUrl, client, modalClient, primaryId, followUp);
      } else {
        finalizeMergeSuccess(followUp, primaryId, client, modalClient);
      }

    }).catch(function (err) {
      console.error('[DupAlert] Merge failed:', err && err.status, err && err.responseText);
      var message = (err && err.isSessionBlock)
        ? err.message
        : ((err && err.responseText) || (err && err.message) || 'Merge failed.');
      modalClient.trigger('dup.mergeResult', { success: false, error: message });
    });
  }


  // Always posts the follow-up transcript note (via html_body — the merge endpoint itself can't render HTML).
  // Also bumps the primary ticket to Open in the same call, if it wasn't
  // already. A failure here shouldn't be reported as a merge failure — the
  // merge itself already succeeded — so it's logged and success is still
  // reported either way.
  function finalizeMergeSuccess(followUp, primaryId, client, modalClient) {
    var ticketUpdate = {
      comment: { html_body: followUp.htmlBody, public: false }
    };
    if (followUp.needsOpenBump) {
      ticketUpdate.status = 'open';
    }

    client.request({
      url:         '/api/v2/tickets/' + primaryId + '.json',
      type:        'PUT',
      contentType: 'application/json',
      data:        JSON.stringify({ ticket: ticketUpdate })
    }).then(function () {
      modalClient.trigger('dup.mergeResult', { success: true, targetId: primaryId });
    }).catch(function (err) {
      console.error('[DupAlert] Failed to post follow-up transcript note on primary ticket:', err.status, err.responseText);
      modalClient.trigger('dup.mergeResult', { success: true, targetId: primaryId });
    });
  }


  function pollJobStatus(jobUrl, client, modalClient, primaryId, followUp) {
    var attempts = 0;
    var maxAttempts = 10;

    function check() {
      attempts++;
      client.request({ url: jobUrl, type: 'GET' }).then(function (res) {
        var status = res.job_status && res.job_status.status;

        if (status === 'completed') {
          finalizeMergeSuccess(followUp, primaryId, client, modalClient);
        } else if (status === 'failed' || status === 'killed') {
          modalClient.trigger('dup.mergeResult', { success: false, error: 'Merge job ' + status });
        } else if (attempts < maxAttempts) {
          setTimeout(check, 1500);
        } else {
          // Timed out polling — likely still succeeded, report success
          finalizeMergeSuccess(followUp, primaryId, client, modalClient);
        }
      }).catch(function (err) {
        console.error('[DupAlert] Job poll failed:', err.status);
        modalClient.trigger('dup.mergeResult', { success: false, error: 'Could not verify merge status.' });
      });
    }

    setTimeout(check, 1000);
  }

  function decodeHtmlEntities(str) {
    // Kindly transcript comments sometimes leave literal entities
    // (e.g. "&nbsp;") behind even after tag-stripping. Decode them
    // safely — this sets str as text content, never HTML, so nothing
    // in it can execute.
    var el = document.createElement('textarea');
    el.innerHTML = str;
    return el.value;
  }

  function escapeHtml(str) {
    // Used when building the html_body follow-up note — the transcript
    // contains real conversation text that must not be interpreted as
    // HTML markup itself (only our own <p>/<br> tags should be).
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

})();
