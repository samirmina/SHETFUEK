json":79,"./mt.json":4066,"./my.json":8673,"./nl-be.json":6629,"./nl.json":4905,"./no.json":476,"./pl.json":7627,"./pt-br.json":3162,"./pt.json":6147,"./ro.json":5696,"./ru.json":442,"./sk.json":8041,"./sl.json":5760,"./sq.json":3095,"./sr-me.json":4487,"./sr.json":9734,"./sv.json":7402,"./th.json":4211,"./tr.json":9029,"./uk.json":1039,"./ur.json":8980,"./vi.json":7354,"./zh-cn.json":1345,"./zh-tw.json":9581};function s(e){var t=o(e);return a(t)}function o(e){if(!a.o(i,e)){var t=new Error("Cannot find module '"+e+"'");throw t.code="MODULE_NOT_FOUND",t}return i[e]}s.keys=function(){return Object.keys(i)},s.resolve=o,e.exports=s,s.id=9533},5940(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},8760(e){e.exports={"app.installation_instructions":'### لبدء استخدام تطبيق Time Tracking اتبع الخطوات التالية:\n\n1. سجل الدخول إلى حسابك في Zendesk Support، ثم انقر فوق أيقونة الإدارة في العمود الجانبي.\n2. حدد **تطبيقات > السوق**، ثم ابحث عن تطبيق تتبع الوقت وانقر فوق المربع.‏\n3. على صفحة تطبيق تتبع الوقت، انقر فوق **تثبيت التطبيق** في الزاوية العلوية اليمنى. هذا التطبيق متاح فقط لعملاء خطتي Professional وEnterprise.\n‏4. أدخِل اسمًا للتطبيق، ثم حدد التكوينات التي تريدها، ثم انقر فوق **تثبيت**.‏\n5. إذا كنت تستخدم نماذج التذاكر (جزء من المكون الإضافي Productivity Pack)، انتقل إلى **إدارة > إدارة > نماذج التذاكر** ثم أضِف حقليّ التذكرة "Total time spent" و"Time spent last update" لكل نموذج من نماذج تذاكرك.',"app.long_description":"* تتبع تلقائيًا الوقت الذي يُستغرق في كل من تذاكرك فيZendesk Support‏\n* تخصيص التطبيق ليتضمن الوظائف التي يحتاجها فريقك بالتحديد\n* الاستفادة من Insights لإجراء تقارير مفصلة بواسطة بيانات تتبع الوقت\n\nيسهل تطبيق تتبع الوقت إدارة أداء فريقك وإدارة عمليات الدعم بأكملها. تعرف بسهولة على العملاء الذين يرسلون التذاكر الأكثر تعقيدًا أو أي أنواع المشكلات هي التي تستغرق من فريقك وقتًا أطول في الحل. نقب في تذاكر الوكلاء لاكتشاف ما يستغرق وقتهم وأي المشكلات هم خبراء فيها.\n\n### اعلم بالتحديد كيف وأين ينفق فريقك وقته\n\nاحتفظ بسجل متجدد لوكلاء الدعم الذين عملوا على تذكرة معينة ومدة كل تفاعل. سجل تلقائيًا الوقت الإجمالي الذي مضى منذ اللحظة التي قام فيها وكيلك بتحديث تذكرة ما أو اجعله يدخل الوقت يدويًا.\n\n### سهولة في الإعداد والتخصيص والاستخدام\n\nلا يحتاج تطبيق تتبع الوقت أي إعداد أو تسجيل دخول خارجيين. خصص ببساطة أسلوب عرض تطبيق تتبع الوقت وطريقة عمله بواسطة فريق الدعم من أجل ملاءمة سلسة مع سير العمل الحالي لفريقك. \n\n### أعد تقارير عن سجلات الوقت التي لديك واتخذ الإجراءات المناسبة\n\nابدأ في إعداد التقارير على الفور من خلال تقارير تتبع الوقت المخصصة وسهلة الإنشاء بواسطة Insights. تعرف بالتحديد على ما يستنفد موارد فريق الدعم واكتشف أفضل المجالات للتحسين والتطوير.‏\n\n‏بموجب تمكين هذا التطبيق، أنت توافق على [شروط استخدام Built by Zendesk](https://www.zendesk.com/company/built-by-zendesk-agmt/‎).","app.name":"تتبع الوقت","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"يتوقف عداد الوقت مؤقتًا حين ينتقل الوكيل أثناء تصفحه بعيدًا عن التذكرة ثم يُستأنف العداد عند رجوع الوكيل إلى التذكرة.","app.parameters.auto_pause_resume.label":"توقف مؤقت تلقائي","app.parameters.debug_prevent_huge_times.helpText":"يمنع إرسال التذكرة إذا كانت قيمة الوقت المستغرق في التذكرة التي يحاول الوكيل إرسالها تزيد عن 1209600 ثانية (أسبوعين).","app.parameters.debug_prevent_huge_times.label":"كشف وتصحيح الأخطاء: منع إرسال قِيَم الوقت المستغرق الكبيرة","app.parameters.display_timelogs.helpText":"بإمكان الوكلاء الاطلاع على نشاط سجل الوقت على التذاكر.","app.parameters.display_timelogs.label":"عرض سجلات الوقت على الوكلاء","app.parameters.hide_from_agents.helpText":'لن يظهر هذا التطبيق للوكلاء الذين ليس لديهم دور "المدير". كما يمنعهم ذلك من رؤية الوقت وتحريره بعد الإرسال.',"app.parameters.hide_from_agents.label":"إخفاء التطبيق من الوكلاء","app.parameters.manual_pause_resume.helpText":"بإمكان الوكلاء إيقاف عداد الوقت مؤقتًا أو إعادة تعيينه يدويًا.","app.parameters.manual_pause_resume.label":"عرض عناصر التحكم في عداد الوقت","app.parameters.reset.helpText":"يمكن للوكلاء إعادة تعيين الوقت الحالي الذي يُنفق على التذكرة.","app.parameters.reset.label":"إعادة تعيين الوقت الحالي","app.parameters.resume_on_changes.helpText":"عند إدخال تعديل على أي حقل، سيظهر مربع حوار يسأل إن كان ينبغي استئناف عداد الوقت.","app.parameters.resume_on_changes.label":"الاستئناف إثر التعديل","app.parameters.simple_submission.helpText":"مطالبة الوكلاء بإدخال قيمة بدلالة الدقائق قبل إرسال التذكرة","app.parameters.simple_submission.label":"إرسال الوقت المبسط","app.parameters.time_field_id.helpText":"معرّف الحقل الرقمي المخصص الذي سيحتوي على الوقت الإجمالي.","app.parameters.time_field_id.label":"معرّف حقل الوقت","app.parameters.time_object_field_id.helpText":"معرّف الحقل الرقمي المخصص الذي سيحتوي الوقت الذي أنفِق على التذكرة.","app.parameters.time_object_field_id.label":"معرّف حقل التكوين","app.parameters.time_submission.helpText":"بإمكان الوكلاء مراجعة الوقت الذي أنفقوه وتحريره قبل إرسال التذكرة.","app.parameters.time_submission.label":"تحرير الوقت المُرسل","app.short_description":"لمساعدتك على تتبع الوقت الذي يُستغرق في التذاكر.","errors.bad_time_with_format":"تنسيق الوقت غير صالح، المتوقع هو {{time_format}}.","errors.negative_time":"كان الوقت سالبًا. سيُعاد تعيين الوقت إلى الصفر.","errors.no_answer":"لم يُرسَل أي وقت","errors.save_hook":"يجب عليك إرسال الوقت الذي أنفقته على هذه التذكرة.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"هل اتبعت تعليمات الثبيت لهذا التطبيق وقمت بتكوين حقلي التذكرة المطلوبَين ليظهرا في كل نماذج التذاكر؟","errors.setup.solution":'إن لم تفعل، فراجع <a href="{{url}}" target="_blank">هذه التعليمات</a> وانتقل إلى صفحة إدارة نماذج التذاكر لإتمام الإعداد.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"الزمن المُرسَل أطول مما ينبغي.","statuses.closed":"غ","statuses.hold":"ع","statuses.new":"ج","statuses.open":"ف","statuses.pending":"ق","statuses.solved":"ح",time_format_hms:"HH:mm:ss",time_format_minutes:"دقائق","views.main.pause":"إيقاف مؤقت","views.main.play":"تشغيل","views.main.reset":"إعادة تعيين","views.main.timelogs":"سجل الوقت","views.main.timelogs_table.agent":"وكيل","views.main.timelogs_table.status":"الحالة","views.main.timelogs_table.time":"الوقت","views.main.total_time_spent":"الوقت الإجمالي","views.modal.body_with_format":'هذا هو مقدار الوقت ({{time_format}}) الذي استغرقته في هذه التذكرة. حرِّر الوقت، إذا لزم الأمر، ثم انقر فوق " إرسال الوقت" .',"views.modal.close":"إلغاء","views.modal.count_down":"سوف تُغلق هذه النافذة تلقائيًا بعد {{time}} ثانية.","views.modal.save":"إرسال الوقت","views.resume_modal.body":"هل ترغب في استئناف عداد الوقت؟","views.resume_modal.no":"لا","views.resume_modal.yes":"نعم","views.timelogs.csv_export":"تصدير إلى ملف CSV","views.timelogs.empty":"لا توجد سجلات وقت للعرض","views.timelogs.error":"لقد تعذر علينا تحميل أي سجلات الوقت.","views.timelogs.hide_timelogs":"إخفاء سجلات الوقت","views.timelogs.show_timelogs":"إظهار سجلات الوقت","views.timelogs.title":"سجلات الوقت"}},2032(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},8682(e){e.exports={"app.installation_instructions":"### Основы работы с приложением «Учет времени»:\n\n1. Войдите в аккаунт Zendesk Support и щелкните значок «Администратор» на боковой панели.\n2. Выберите команды **Приложения > Marketplace**, затем найдите приложение «Учет времени» и щелкните его плитку.\n3. На странице приложения щелкните ссылку **Установить приложение** в верхнем правом углу. Это приложение доступно только пользователям тарифных пакетов Professional и Enterprise.\n4. Введите название приложения и задайте настройки, затем нажмите кнопку **Установить**.\n5. Если вы используете формы тикетов (из дополнения Productivity Pack), выберите меню **Администратор > Управление > Формы тикетов** и добавьте поля тикетов «Total time spent (Общее затраченное время)» и «Time spent last update (Длительность последнего обновления)» в каждую форму тикетов.","app.long_description":"* Автоматический учет времени, затраченного на каждый из тикетов Zendesk Support\n* Настройте в приложении использование именно тех функций, которые нужны вашей службе\n* Используйте Insights для составления подробных отчетов с данными учета времени\n\nПриложение «Учет времени» облегчает контроль производительности вашего коллектива и управление услугами поддержки в целом. С его помощью можно определить, какие клиенты отправляют самые трудные тикеты или проблемы каких типов отнимают у ваших сотрудников больше всего времени. Узнайте, на что уходит время ваших агентов и в решении каких проблем они достигли совершенства.\n\n### Получите точную информацию о том, как и где расходуется рабочее время ваших сотрудников\n\nВедите журнал работы агентов поддержки, которые занимались данным тикетом, и записывайте, как долго проводилась каждая операция. Общее затраченное время автоматически регистрируется в ту же секунду, когда агент обновляет тикет. Также агент может задать это время вручную.\n\n### Удобство в установке, настройке и использовании\n\nПриложение «Учет времени» не требует установки каких-либо сторонних программ или входа в какой-либо сторонний сервис. Просто укажите, как должно отображаться и работать приложение «Учет времени», чтобы оно идеально вписалось в существующий рабочий процесс вашей службы поддержки.\n\n### Составьте отчет по использованию времени и примите соответствующие меры\n\nПриложение Insights позволяет с удобством создавать специализированные отчеты о затраченном времени. Из них вы точно узнаете, на что расходуются ресурсы вашей службы поддержки и где есть потенциал для оптимизации и совершенствования.\n\nАктивируя это приложение, вы принимаете [Условия пользования продуктами Zendesk](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Учет времени","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Таймер останавливается, когда агент уходит от тикета, и возобновляет отсчет времени, когда агент возвращается к тикету.","app.parameters.auto_pause_resume.label":"Автопауза","app.parameters.debug_prevent_huge_times.helpText":"Блокировать отправку тикета, если агент потратил на это более 1209600 с (двух недель).","app.parameters.debug_prevent_huge_times.label":"Отладка: блокировать тикеты, на отправку которых затрачено много времени","app.parameters.display_timelogs.helpText":"Агенты могут следить за ходом действий с тикетами.","app.parameters.display_timelogs.label":"Показывать журналы агентам","app.parameters.hide_from_agents.helpText":"Приложение не будет доступно для агентов, которые не имеют роли «Администратор». Кроме того, они не смогут узнавать и изменять время до отправки тикета.","app.parameters.hide_from_agents.label":"Скрыть приложение от агентов","app.parameters.manual_pause_resume.helpText":"Агенты могут вручную останавливать или сбрасывать таймер.","app.parameters.manual_pause_resume.label":"Показывать органы управления таймеров","app.parameters.reset.helpText":"Агенты могут обнулить текущее время, затраченное на работу с тикетом.","app.parameters.reset.label":"Обнулить текущее время","app.parameters.resume_on_changes.helpText":"При внесении изменений в любые поля появляется окно с предложением запустить таймер снова.","app.parameters.resume_on_changes.label":"Продолжить с изменениями","app.parameters.simple_submission.helpText":"Предлагать агентам ввести значение в минутах до отправки тикета.","app.parameters.simple_submission.label":"Упрощенное указание времени","app.parameters.time_field_id.helpText":"ID специального числового поля, в котором записано полное время.","app.parameters.time_field_id.label":"ID поля времени","app.parameters.time_object_field_id.helpText":"ID специального числового поля, в котором записано время, затраченное на работу с тикетом.","app.parameters.time_object_field_id.label":"ID поля настройки","app.parameters.time_submission.helpText":"Агенты могут просматривать и редактировать сведения о затраченном времени перед отправкой тикета.","app.parameters.time_submission.label":"Редактировать время","app.short_description":"Помогает контролировать время, затраченное на работу с тикетами.","errors.bad_time_with_format":"Неправильный формат времени, ожидалось {{time_format}}.","errors.negative_time":"Отрицательное время. Изменено на 0.","errors.no_answer":"Время не зафиксировано","errors.save_hook":"Вы должны сообщить время, затраченное на этот тикет.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Вы выполнили инструкции по установке этого приложения и настроили отображение обоих обязательных полей тикета в каждой форме тикета?","errors.setup.solution":'Если нет, обратитесь к <a href="{{url}}" target="_blank">этим инструкциям</a> и перейдите на страницу управления формами тикетов для завершения настройки.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"Указано слишком длительное время.","statuses.closed":"з","statuses.hold":"у","statuses.new":"н","statuses.open":"о","statuses.pending":"ж","statuses.solved":"в",time_format_hms:"HH:mm:ss",time_format_minutes:"мин.","views.main.pause":"Пауза","views.main.play":"Воспроизвести","views.main.reset":"Сброс","views.main.timelogs":"Журнал","views.main.timelogs_table.agent":"Агент","views.main.timelogs_table.status":"Статус","views.main.timelogs_table.time":"Время","views.main.total_time_spent":"Полное время","views.modal.body_with_format":"Это суммарное время ({{time_format}}), затраченное вами на работу с данным тикетом. При необходимости измените время, затем нажмите кнопку «Сообщить время».","views.modal.close":"Отмена","views.modal.count_down":"Это окно автоматически закроется через {{time}} с.","views.modal.save":"Сообщить время","views.resume_modal.body":"Хотите запустить таймер снова?","views.resume_modal.no":"Нет","views.resume_modal.yes":"Да","views.timelogs.csv_export":"Экспортировать в CSV","views.timelogs.empty":"Нет журналов для отображения","views.timelogs.error":"Не удается загрузить журналы.","views.timelogs.hide_timelogs":"Скрыть журналы","views.timelogs.show_timelogs":"Показать журналы","views.timelogs.title":"Журнал"}},9448(e){e.exports={"app.installation_instructions":"### Първи стъпки с приложението „Хронометър“:\n\n1. Влезте в акаунта си в Zendesk Support и кликнете върху иконата „Админ“ в страничния панел.\n2. Изберете **Приложения > Магазин**, намерете приложението „Хронометър“ и кликнете върху плочката.\n3. На страницата на приложението кликнете върху **Инсталиране** в горния десен ъгъл. Това приложение е достъпно само за клиенти с тарифни планове Professional и Enterprise.\n4. Въведете име на приложението, задайте желаните настройки и кликнете върху **Инсталиране**.\n5. Ако използвате „Формуляри за казуси“ (част от добавката „Пакет Productivity“), изберете **Администратор > Управление > Формуляри за казуси** и добавете полетата „Total time spent“ (Общо изразходвано време) и „Time spent last update“ (Време, изразходвано за последното обновяване) във всеки от вашите формуляри за казуси.","app.long_description":"* Следете автоматично времето, изразходвано за всеки от вашите казуси в Zendesk Support\n* Персонализирайте приложението с включване на тези функции, от които вашият екип се нуждае\n* Използвайте Insights за създаване на подробни отчети с данните от хронометъра\n\nПриложението „Хронометър“ улеснява управлението на работата на вашия екип и операциите по поддръжката като цяло. Лесно определяйте кои клиенти изпращат най-сложните казуси или кои типове проблеми отнемат на екипа ви най-дълго време за решаване. Разберете какво отнема времето на вашите консултанти и при кои проблеми те се изявяват като експерти.\n\n### Научете точно как и къде вашият екип изразходва времето си\n\nПоддържайте журнал, отбелязващ кои консултанти са работили по даден казус и каква е била продължителността на всяко взаимодействие. Автоматично регистрирайте общото изразходвано време в момента, в който консултантът обновява казуса, или позволете на консултанта да въвежда времето ръчно.\n\n### Лесно конфигуриране, персонализиране и използване\n\nПриложението „Хронометър“ не изисква конфигуриране или вход през трета страна. Просто настройте какво да показва и как да работи приложението за вашия екип по поддръжката, за да се впише безпроблемно в работния процес.\n\n### Създавайте отчети за използването на времето и при нужда вземайте мерки\n\nЗапочнете отчитането веднага с лесните за създаване персонализирани времеви отчети чрез Insights. Разберете точно кое изразходва ресурсите на вашия екип за поддръжка и къде има потенциал за оптимизация и усъвършенстване.\n\nАктивирайки това приложение, вие приемате [Условията за ползване на приложения, създадени от Zendesk](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Отчитане на времето","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Таймерът прави пауза, когато консултантът излиза извън казусите и започва отново да отчита, когато консултантът се върне при казусите.","app.parameters.auto_pause_resume.label":"Автоматична пауза","app.parameters.debug_prevent_huge_times.helpText":"Блокира подаването на казус, ако консултант се опитва да направи това при стойност на изразходваното време (в секунди), по-голяма от 1 209 600 сек (две седмици).","app.parameters.debug_prevent_huge_times.label":"Отстраняване на грешки: Блокиране на подаването на казуси при голяма стойност на изразходваното време","app.parameters.display_timelogs.helpText":"Консултантите могат да следят времето на действията по казусите.","app.parameters.display_timelogs.label":"Показване на времето на действия на консултанти","app.parameters.hide_from_agents.helpText":"Приложението няма да се показва на консултанти без ролята на администратори. Освен това, те няма да могат да виждат и редактират часа на подаване на казуса.","app.parameters.hide_from_agents.label":"Скриване на приложението от консултанти","app.parameters.manual_pause_resume.helpText":"Консултантите могат ръчно да включват пауза или да нулират таймера.","app.parameters.manual_pause_resume.label":"Показване на органите за управление на таймера","app.parameters.reset.helpText":"Консултантите могат да нулират текущото време, отделено за даден казус.","app.parameters.reset.label":"Нулиране на текущото време","app.parameters.resume_on_changes.helpText":"Когато в някое поле се извършат промени, се появява прозорец с въпрос дали таймерът да продължи да отчита времето, без да се нулира.","app.parameters.resume_on_changes.label":"Пускане пак след промени","app.parameters.simple_submission.helpText":"Указание за консултантите да въведат стойност в минути преди да подадат казуса","app.parameters.simple_submission.label":"Подаване на опростено време","app.parameters.time_field_id.helpText":"Идентификаторът на специално цифрово поле за общото време.","app.parameters.time_field_id.label":"Идентификатор на полето за време","app.parameters.time_object_field_id.helpText":"Идентификаторът на специално цифрово поле за времето, отделено за казус.","app.parameters.time_object_field_id.label":"Идентификатор на поле за конфигурация","app.parameters.time_submission.helpText":"Консултантите могат да прегледат и редактират своето време преди да подадат казуса.","app.parameters.time_submission.label":"Редактиране на времето за подаване","app.short_description":"Помага ви да следите времето, изразходвано за казуси.","errors.bad_time_with_format":"Невалиден формат; трябва да бъде {{time_format}}.","errors.negative_time":"Времето беше с отрицателна стойност. Сега е нулирано.","errors.no_answer":"Няма подадено време","errors.save_hook":"Трябва да подадете вашето време за този казус.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Спазихте ли инструкциите за инсталиране на това приложение и конфигурирахте ли появата и на двете задължителни полета за казуса във всеки формуляр за казус?","errors.setup.solution":'Ако не, вижте <a href="{{url}}" target="_blank">тези инструкции</a> и преминете към страницата за управление на вашите формуляри за казуси, за да финализирате настройката.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"Задали сте твърде дълго време.","statuses.closed":"з","statuses.hold":"с","statuses.new":"н","statuses.open":"о","statuses.pending":"ч","statuses.solved":"б",time_format_hms:"HH:mm:ss",time_format_minutes:"минути","views.main.pause":"Пауза","views.main.play":"Възпроизвеждане","views.main.reset":"Нулиране","views.main.timelogs":"Журнал","views.main.timelogs_table.agent":"Консултант","views.main.timelogs_table.status":"Статус","views.main.timelogs_table.time":"Време","views.main.total_time_spent":"Общо време","views.modal.body_with_format":"Това е времето ({{time_format}}), което сте изразходвали за този казус. Ако е нужно, редактирайте стойността и кликнете върху „Подаване на време“.","views.modal.close":"Отмяна","views.modal.count_down":"Този модален прозорец ще се затвори автоматично след {{time}} секунди.","views.modal.save":"Подаване на време","views.resume_modal.body":"Искате ли таймерът да се пусне пак (от пауза)?","views.resume_modal.no":"Не","views.resume_modal.yes":"Да","views.timelogs.csv_export":"Експорт в CSV","views.timelogs.empty":"Няма журнали за показване","views.timelogs.error":"Не можем да заредим никакви журнали.","views.timelogs.hide_timelogs":"Скриване на журналите","views.timelogs.show_timelogs":"Показване на журналите","views.timelogs.title":"Журнали"}},3891(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},276(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},1943(e){e.exports={"app.installation_instructions":"###Primeros pasos con la aplicación Seguimiento del tiempo:\n\n1. Inicie sesión en su cuenta de Zendesk Support y luego haga clic en el icono Administrador en la barra lateral.\n2. Seleccione **Aplicaciones > Marketplace**, busque la aplicación Seguimiento del tiempo y haga clic en el mosaico.\n3. En la página de la aplicación Seguimiento del tiempo, haga clic en **Instalar aplicación** en la esquina superior derecha. Esta aplicación está disponible solo para los clientes que tienen los planes Professional y Enterprise.\n4. Ingrese un nombre para la aplicación, seleccione la configuración que desea y luego haga clic en **Instalar**.\n5. Si usa formularios de ticket (parte del complemento Paquete de productividad), vaya a **Administrador > Administrar > Formularios de ticket** y agregue los campos de ticket Total time spent (Tiempo total transcurrido) y Time spent last update (Tiempo transcurrido última actualización) a cada uno de los formularios de ticket.","app.long_description":"* Haga un seguimiento automático del tiempo dedicado a cada ticket en su cuenta de Zendesk Support.\n* Personalice la aplicación para incluir la funcionalidad exacta que necesita su equipo\n* Aproveche Insights para crear informes detallados con los datos de seguimiento del tiempo\n\nLa aplicación Seguimiento del tiempo hace que sea fácil administrar el rendimiento de su equipo y las operaciones de soporte en general. Identifique fácilmente a los clientes que envían los tickets más complicados o los problemas que toman más tiempo en resolver. Analice los tickets de un agente para ver qué le está tomando más tiempo y en qué tipo de problemas se especializa.\n\n### Conozca exactamente cómo y en qué pasan el tiempo los integrantes de su equipo\n\nMantenga un registro de los agentes de soporte que han trabajado en un ticket y cuánto duró cada interacción. Registre automáticamente el total de tiempo transcurrido desde el mismo momento en que un agente actualiza un ticket o permítale que ingrese su tiempo manualmente.\n\n### Fácil de configurar, personalizar y usar\n\nLa aplicación Seguimiento del tiempo no requiere un inicio de sesión o una configuración de parte de terceros. Lo único que tiene que hacer es personalizar cómo se muestra y cómo funciona la aplicación Seguimiento del tiempo para su equipo de soporte, para que se adapte perfectamente al flujo de trabajo actual de su equipo.\n\n### Cree informes sobre sus registros de tiempo y tome las medidas necesarias\n\nComience a crear informes de inmediato con los informes personalizados de fácil creación para el seguimiento del tiempo mediante Insights. Sepa exactamente en qué se gastan los recursos de su equipo de soporte e identifique las áreas idóneas para realizar optimizaciones y mejoras.\n\nAl activar esta aplicación, usted acepta los [Términos de uso de Creadas por Zendesk](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Seguimiento del tiempo","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"El temporizador se detiene cuando el agente abandona el ticket y vuelve a comenzar cuando regresa al ticket.","app.parameters.auto_pause_resume.label":"Pausa automática","app.parameters.debug_prevent_huge_times.helpText":"Bloquea el envío de un ticket si un agente está intentando enviar un ticket con un valor de tiempo transcurrido (en segundos) mayor que 1209600s (dos semanas).","app.parameters.debug_prevent_huge_times.label":"Depurar: bloquear envíos con mucho tiempo transcurrido","app.parameters.display_timelogs.helpText":"Los agentes pueden ver la actividad del registro de tiempo en los tickets.","app.parameters.display_timelogs.label":"Mostrar registros de tiempo a los agentes","app.parameters.hide_from_agents.helpText":'Los agentes que no tengan el rol de "Administrador" no verán la aplicación. Esto también evita que puedan ver y editar el tiempo durante el envío.',"app.parameters.hide_from_agents.label":"Ocultar la aplicación para que no la vean los agentes","app.parameters.manual_pause_resume.helpText":"Los agentes pueden detener o restablecer manualmente el temporizador.","app.parameters.manual_pause_resume.label":"Mostrar controles del temporizador","app.parameters.reset.helpText":"Los agentes pueden restablecer el tiempo actual dedicado al ticket.","app.parameters.reset.label":"Restablecer tiempo actual","app.parameters.resume_on_changes.helpText":"Si se hacen cambios en los campos, aparecerá una ventana modal para preguntar si se desea reanudar el temporizador.","app.parameters.resume_on_changes.label":"Reanudar después de cambios","app.parameters.simple_submission.helpText":"Los agentes pueden ingresar un valor en minutos antes de enviar el ticket.","app.parameters.simple_submission.label":"Envío de tiempo simplificado","app.parameters.time_field_id.helpText":"La ID de un campo numérico personalizado que muestra el tiempo total.","app.parameters.time_field_id.label":"ID de campo de tiempo","app.parameters.time_object_field_id.helpText":"La ID de un campo numérico personalizado que muestra el tiempo dedicado al ticket.","app.parameters.time_object_field_id.label":"ID de campo de configuración","app.parameters.time_submission.helpText":"Los agentes pueden revisar y editar su tiempo antes de enviar el ticket.","app.parameters.time_submission.label":"Editar envío de tiempo","app.short_description":"Le ayuda a llevar un registro del tiempo que se dedica a los tickets.","errors.bad_time_with_format":"Formato de hora no válido, se esperaba {{time_format}}.","errors.negative_time":"El tiempo era negativo. Se restablecerá en 0.","errors.no_answer":"No se envió una cantidad de tiempo","errors.save_hook":"Tiene que enviar su tiempo para este ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"¿Siguió las instrucciones de instalación para esta aplicación y configuró los dos campos de ticket requeridos para que aparezcan en todos los formularios de ticket?","errors.setup.solution":'De no ser así, consulte <a href="{{url}}" target="_blank">estas instrucciones</a> y vaya a la página de administración de sus formularios de ticket para finalizar la configuración.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"El tiempo remitido es muy largo.","statuses.closed":"c","statuses.hold":"e","statuses.new":"n","statuses.open":"a","statuses.pending":"p","statuses.solved":"r",time_format_hms:"HH:mm:ss",time_format_minutes:"minutos","views.main.pause":"Detener","views.main.play":"Reproducir","views.main.reset":"Restablecer","views.main.timelogs":"Registros de tiempo","views.main.timelogs_table.agent":"Agente","views.main.timelogs_table.status":"Estado","views.main.timelogs_table.time":"Tiempo","views.main.total_time_spent":"Tiempo total","views.modal.body_with_format":'La cantidad de tiempo ({{time_format}}) que se dedicó a este ticket. Edite el tiempo, si es necesario, y luego haga clic en " Enviar tiempo" .',"views.modal.close":"Cancelar","views.modal.count_down":"Esta ventana modal se cerrará automáticamente en {{time}} segundos.","views.modal.save":"Enviar tiempo","views.resume_modal.body":"¿Desea reanudar el temporizador?","views.resume_modal.no":"No","views.resume_modal.yes":"Sí","views.timelogs.csv_export":"Exportar como CSV","views.timelogs.empty":"No hay registros de tiempo para mostrar","views.timelogs.error":"No podemos cargar ningún registro de tiempo.","views.timelogs.hide_timelogs":"Ocultar registros de tiempo","views.timelogs.show_timelogs":"Mostrar registros de tiempo","views.timelogs.title":"Registros de tiempo"}},4225(e){e.exports={"app.installation_instructions":"### Začínáme s aplikací Sledování doby:\n\n1. Přihlaste se do svého účtu Zendesk Supportu a klikněte na ikonu administrátora v postranním panelu.\n2. Vyberte **Aplikace > Marketplace**, pak najděte aplikaci Sledování doby a klikněte na její dlaždici.\n3. V pravém horním rohu stránky aplikace Sledování doby klikněte na **Nainstalovat aplikaci**. Tato aplikace je dostupná pouze pro zákazníky s tarify Professional a Enterprise.\n4. Zadejte název aplikace, nakonfigurujte požadované nastavení a potom klikněte na tlačítko **Nainstalovat**.\n5. Pokud používáte Formuláře tiketů (součást doplňku Balík produktivity), přejděte na **Administrátor > Správa > Formuláře tiketů** a přidejte pole tiketu Total time spent (Celková strávená doba) a Time spent last update (Doba strávená od poslední aktualizace) do každého ze svých formulářů tiketů.","app.long_description":"* Automaticky sledujte dobu strávenou na každém z vašich tiketů Zendesk Supportu.\n* Přizpůsobte aplikaci tak, aby obsahovala přesně ty funkce, které váš tým potřebuje.\n* Využijte software Insights k vytvoření podrobných výkazů s daty sledování doby.\n\nAplikace Sledování doby usnadňuje řízení výkonu vašeho týmu i celou činnost podpory. Snadno rozpoznáte, kteří zákazníci odesílají ty nejsložitější tikety, nebo zjistíte typy problémů, k jejichž vyřešení potřebuje váš tým nejdelší dobu. Prozkoumejte tikety agentů a zjistěte, co jim zabírá čas a na které problémy jsou odborníky.\n\n### Přesně poznejte, jak a kde váš tým tráví svůj čas\n\nVeďte průběžný protokol, který ukazuje, kteří agenti podpory na tiketu pracovali a jak dlouho každá komunikace trvala. Automaticky evidujte celkovou strávenou dobu v okamžiku, kdy váš agent aktualizuje tiket, nebo je nechte svoji dobu zadávat ručně.\n\n### Snadné nastavení, přizpůsobení a použití\n\nAplikace Sledování doby nevyžaduje žádnou instalaci třetích stran ani přihlášení. Jednoduše přizpůsobte, jak se má aplikace Sledování doby zobrazovat a pomáhat vašemu týmu podpory, a můžete ji bez problémů integrovat do aktuálního pracovního postupu vašeho týmu.\n\n### Vytvořte výkaz ze svých časových protokolů a přijměte potřebná opatření\n\nZačněte hned teď snadno vytvářet vlastní výkazy s daty sledování doby pomocí softwaru Insights. Získejte přesnou představu o tom, co nadměrně zatěžuje zdroje vašeho týmu podpory, a najděte nejvhodnější oblasti pro optimalizaci a zlepšení.\n\nTím, že zapnete tuto aplikaci, souhlasíte s [Podmínkami používání služby Vytvořeno společností Zendesk](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Sledování doby","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Časovač se pozastaví, když agent odejde od tiketu, a obnoví se, když se agent k tiketu vrátí.","app.parameters.auto_pause_resume.label":"Automatická pauza","app.parameters.debug_prevent_huge_times.helpText":"Zablokuje odeslání tiketu, pokud agent zkouší odeslat tiket s větší hodnotou strávené doby (v sekundách) než 1209600 (dva týdny).","app.parameters.debug_prevent_huge_times.label":"Ladění: Blokovat odeslání s velkou strávenou dobou","app.parameters.display_timelogs.helpText":"Agenti mohou zobrazit aktivitu časového záznamu na tiketech.","app.parameters.display_timelogs.label":"Zobrazit časové záznamy agentům","app.parameters.hide_from_agents.helpText":"Aplikace se nezobrazí agentům, kteří nemají roli „Administrátor“. Tito agenti také neuvidí a nebudou moci změnit čas příspěvku.","app.parameters.hide_from_agents.label":"Skrýt tuto aplikaci pro agenty","app.parameters.manual_pause_resume.helpText":"Agenti mohou časovač ručně pozastavit nebo vynulovat.","app.parameters.manual_pause_resume.label":"Zobrazit ovládací prvky časovače","app.parameters.reset.helpText":"Agenti mohou vynulovat aktuální dobu strávenou na tiketu.","app.parameters.reset.label":"Vynulovat aktuální dobu","app.parameters.resume_on_changes.helpText":"Pokud dojde ke změně některých polí, zobrazí se modální okno s dotazem, zda se má restartovat časovač.","app.parameters.resume_on_changes.label":"Restartovat při změnách","app.parameters.simple_submission.helpText":"Agenti budou vyzváni, aby před odesláním tiketu zadali hodnotu v minutách.","app.parameters.simple_submission.label":"Zjednodušené odesílání doby","app.parameters.time_field_id.helpText":"ID vlastního číselného pole, které bude obsahovat celkovou dobu.","app.parameters.time_field_id.label":"ID pole doby","app.parameters.time_object_field_id.helpText":"ID vlastního číselného pole, které bude obsahovat celkovou dobu strávenou na tiketu.","app.parameters.time_object_field_id.label":"ID pole konfigurace","app.parameters.time_submission.helpText":"Agenti mohou před odesláním tiketu svoji dobu zkontrolovat a upravit.","app.parameters.time_submission.label":"Upravit odesílání doby","app.short_description":"Pomáhá sledovat dobu strávenou na tiketech.","errors.bad_time_with_format":"Neplatný formát času, byl očekáván formát {{time_format}}.","errors.negative_time":"Doba byla záporná. Nastavena na 0.","errors.no_answer":"Nebyla odeslána žádná doba","errors.save_hook":"Musíte odeslat dobu, kterou jste strávili na tomto tiketu.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Postupovali jste podle pokynů pro tuto aplikaci a nakonfigurovali jste obě povinná pole tiketu tak, aby se zobrazovala na všech formulářích tiketu?","errors.setup.solution":'Pokud tomu tak není, prostudujte si prosím <a href="{{url}}" target="_blank">tyto pokyny</a>, přejděte na stránku správy formulářů tiketů a instalaci dokončete.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"Odeslaná doba byla příliš dlouhá.","statuses.closed":"u","statuses.hold":"p","statuses.new":"n","statuses.open":"o","statuses.pending":"č","statuses.solved":"v",time_format_hms:"HH:mm:ss",time_format_minutes:"minuty","views.main.pause":"Pozastavit","views.main.play":"Přehrát","views.main.reset":"Obnovit","views.main.timelogs":"Časový  záznam","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Stav","views.main.timelogs_table.time":"Doba trvání","views.main.total_time_spent":"Celková doba","views.modal.body_with_format":"Toto je doba ({{time_format}}), kterou jste strávili na tomto tiketu. Upravte tuto dobu, pokud je to potřeba, a pak klikněte na „Odeslat dobu“.","views.modal.close":"Zrušit","views.modal.count_down":"Toto modální okno se automaticky zavře za {{time}} sekund.","views.modal.save":"Odeslat dobu","views.resume_modal.body":"Chcete restartovat časovač?","views.resume_modal.no":"Ne","views.resume_modal.yes":"Ano","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"Neexistují žádné časové záznamy k zobrazení","views.timelogs.error":"Nepodařilo se načíst žádné časové záznamy.","views.timelogs.hide_timelogs":"Skrýt časové záznamy","views.timelogs.show_timelogs":"Zobrazit časové záznamy","views.timelogs.title":"Časové záznamy"}},8687(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},3640(e){e.exports={"app.installation_instructions":"### Kom godt i gang med appen Tidsregistrering:\n\n1. Log ind på din Zendesk Support-konto, og klik derefter på Admin-ikonet på sidepanelet.\n2. Vælg **Apps > Markedsplads**, find derefter appen Tidsregistrering, og klik på ruden.\n3. Klik på **Installer app** i det øverste højre hjørne på siden Tidsregistrering-appen. Denne app er kun tilgængelig for kunder, der har Plus- eller Enterprise-planerne.\n4. Indtast et navn til appen, vælg de ønskede konfigurationer, og klik derefter på **Installer**.\n5. Hvis du bruger Ticket-formularer (en del af Produktivitetspakke-tilføjelsesprogrammet), går du til **Admin > Administrer > Ticket-formularer** og føjer ticketfelterne ‘Total time spent’ (Tid brugt i alt) og ‘Time spent last update’ (Tid brugt sidste opdatering) til hver af dine ticket-formularer.","app.long_description":"* Hold automatisk styr på den tid, som er blevet brugt på hver af dine Zendesk Support-tickets\n* Brugerdefiner appen for at inkludere den nøjagtige funktionalitet, som dit team har behov for\n* Gør brug af Insights til at oprette detaljerede rapporter med dine tidsregistreringsdata\n\nAppen Tidsregistrering gør det nemmere at administrere dit teams performance og generelle supportarbejdsprocesser. Identificer nemt, hvilke kunder, der indsender de mest komplicerede tickets, eller hvilke problemtyper, det tager længst tid for dit team at løse. Kig nærmere på agenters tickets for at finde ud af, hvad de bruger tid på, og hvilke problemer, de er eksperter i.\n\n### Find ud af helt nøjagtigt hvordan og hvor dit team bruger deres tid\n\nFør en løbende log på de supportagenter, som har arbejdet på en ticket, og hvor længe hver udveksling varede. Log automatisk den samlede tid, der blev brugt, så snart din agent opdaterer en ticket, eller lad dem indtaste deres tid manuelt.\n\n### Nem at installere, tilpasse og bruge\n\nTidsregistrering-appen kræver ikke nogen tredjepartsinstallation eller login. Du skal blot tilpasse, hvordan Tidsregistrering-appen skal vises og fungere for dit supportteam, så den passer ind i dit teams aktuelle arbejdsgang uden besvær. \n\n### Rapportér på dine tidslogger og skrid til handling\n\nBegynd at rapportere med det samme gennem Insights med brugerdefinerede tidsregistreringsrapporter, som er nemme at konstruere. Find ud af helt nøjagtigt hvad det er, der tapper dit supportteams ressourcer, og find de bedste områder for optimering og forbedring.\n\nVed at aktivere denne app accepterer du [Brugsbetingelser for Bygget af Zendesk](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Tidsregistrering","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Timeren standser midlertidigt, når agenten navigerer væk fra ticketen, og går i gang igen, når agenten er vendt tilbage til ticketen.","app.parameters.auto_pause_resume.label":"Auto-pause","app.parameters.debug_prevent_huge_times.helpText":"Blokerer indsendelse af en ticket, hvis en agent forsøger at indsende en ticket med en værdi for tidsforbrug (i sekunder), som er større end 1209600s (to uger).","app.parameters.debug_prevent_huge_times.label":"Fejlretning: Bloker indsendelser af stort tidsforbrug","app.parameters.display_timelogs.helpText":"Agenter kan se tidslog-aktiviteter for tickets.","app.parameters.display_timelogs.label":"Vis agenter tidslogge","app.parameters.hide_from_agents.helpText":"Appen vil ikke blive vist for agenter, som ikke har 'Admin'-rollen. Dette forhindrer dem også i at kunne se og redigere tiden ved indsending.","app.parameters.hide_from_agents.label":"Skjul appen fra agenter","app.parameters.manual_pause_resume.helpText":"Agenter kan standse timeren midlertidigt eller nulstille den manuelt.","app.parameters.manual_pause_resume.label":"Vis kontrolelementer for timeren","app.parameters.reset.helpText":"Agenter kan nulstille den aktuelle tid brugt på en ticket.","app.parameters.reset.label":"Nulstil aktuel tid","app.parameters.resume_on_changes.helpText":"Når der foretages ændringer til et felt, vil et modal spørge, om timeren skal startes igen.","app.parameters.resume_on_changes.label":"Start igen ved ændringer","app.parameters.simple_submission.helpText":"Agenter kan indtaste en værdi i minutter, inden ticket indsendes","app.parameters.simple_submission.label":"Forenklet indsending af tid","app.parameters.time_field_id.helpText":"Id'et til et brugerdefineret numerisk felt, der vil indeholde samlet tid.","app.parameters.time_field_id.label":"Tidsfelt-id","app.parameters.time_object_field_id.helpText":"Id'et til et brugerdefineret numerisk felt, der vil indeholde tid brugt på ticket.","app.parameters.time_object_field_id.label":"Konfig felt-id","app.parameters.time_submission.helpText":"Agenter kan gennemse og redigere deres tid, inden ticket indsendes","app.parameters.time_submission.label":"Rediger indsendt tid","app.short_description":"Hjælper dig med at registrere den tid, der bliver brugt på tickets.","errors.bad_time_with_format":"Ugyldigt tidsformat, forventede {{time_format}}.","errors.negative_time":"Tid var negativ. Nulstiller til 0.","errors.no_answer":"Der blev ikke indsent nogen tid","errors.save_hook":"Du skal indsende din tid for denne ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Fulgte du installationsvejledningen for denne app, og konfigurerede du begge påkrævede ticket-felter til at blive vist på alle ticket-formularer?","errors.setup.solution":'Hvis ikke, henvises du til <a href="{{url}}" target="_blank">disse instruktioner,</a> og du skal åbne siden til administration af ticket-formularer for at afslutte installationen.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"Den indsendte tid var for lang.","statuses.closed":"l","statuses.hold":"b","statuses.new":"n","statuses.open":"å","statuses.pending":"v","statuses.solved":"ø",time_format_hms:"HH:mm:ss",time_format_minutes:"minutter","views.main.pause":"Pause","views.main.play":"Afspil","views.main.reset":"Nulstil","views.main.timelogs":"Tidslog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Tid","views.main.total_time_spent":"Samlet tid","views.modal.body_with_format":'Dette er den tid ({{time_format}}), som du har brugt på denne ticket. Rediger tiden, hvis det er nødvendigt, og klik derefter på "Indsend tid" .',"views.modal.close":"Annuller","views.modal.count_down":"Denne modal lukker automatisk om {{time}} sekunder.","views.modal.save":"Indsend tid","views.resume_modal.body":"Vil du starte timeren igen?","views.resume_modal.no":"Nej","views.resume_modal.yes":"Ja","views.timelogs.csv_export":"Eksporter som CSV","views.timelogs.empty":"Ingen tidslogge at vise","views.timelogs.error":"Vi kan ikke indlæse nogen tidslogge.","views.timelogs.hide_timelogs":"Skjul tidslog","views.timelogs.show_timelogs":"Vis tidslog","views.timelogs.title":"Tidslog"}},7972(e){e.exports={"app.installation_instructions":"### Erste Schritte mit der App „Zeiterfassung“:\r\n\r\n1. Melden Sie sich bei Ihrem Zendesk Support-Konto an und klicken Sie in der Seitenleiste auf das Admin-Symbol.\r\n2. Klicken Sie auf **Apps > Marketplace**, machen Sie die App „Zeiterfassung“ ausfindig und klicken Sie auf die Kachel.\r\n3. Klicken Sie oben rechts auf der Seite für die App „Zeiterfassung“ auf **App installieren**. Diese App ist nur für Kunden mit Professional- oder Enterprise-Plan verfügbar.\r\n4. Geben Sie einen Namen für die App ein, wählen Sie die gewünschten Konfigurationen aus und klicken Sie dann auf **Installieren**.\r\n5. Wenn Sie Ticketformulare verwenden (Teil des Add-ons „Productivity Pack“), gehen Sie zu **Admin“ > Verwalten > Ticketformulare** und fügen Sie die Ticketfelder „Total time spent“ (Verbrachte Zeit gesamt) und „Time spent last update“ (Verbrachte Zeit letzter Aktualisierung) zu allen Ihren Ticketformularen hinzu.","app.long_description":"* Automatische Erfassung der Zeit für die Bearbeitung von Zendesk Support-Tickets\n* Anpassen der App, damit genau die von Ihrem Team benötigten Funktionen verfügbar sind\n* Erstellen von detaillierten Berichten in Insights, die auf Ihren Zeiterfassungsdaten basieren \n\nMit der App „Zeiterfassung“ lassen sich die Leistung Ihres Teams und die allgemeinen Supportabläufe wesentlich einfacher managen. Sie können gezielt erkennen, welche Kunden die kompliziertesten Tickets einreichen oder für welche Art von Problemen Ihr Team am meisten Zeit benötigt. Durch nähere Untersuchung der von einem Agenten bearbeiteten Tickets können Sie herausfinden, womit er seine Zeit verbringt und in welchen Bereichen er sich besonders gut auskennt.\n\n### Genau wissen, wie und womit Ihr Team seine Zeit verbringt\n\nLaufend aktualisiertes Protokoll der Supportagenten, die an einem Ticket gearbeitet haben, sowie der Dauer der einzelnen Interaktionen. Automatische Erfassung der insgesamt verbrachten Zeit, wenn ein Agent ein Ticket aktualisiert, oder manuelle Eingabe der Zeit durch den Agenten.\n\n### Einfache Einrichtung, Anpassung und Verwendung\n\nFür die App „Zeiterfassung“ ist weder eine Konfiguration durch Dritte noch eine Anmeldung erforderlich. Legen Sie einfach fest, wie die App „Zeiterfassung“ aussehen soll und welche Funktionen für Ihr Supportteam erforderlich sind. Auf diese Weise passt sich die App nahtlos in den Workflow Ihres Teams ein. \n\n### Erstellen von Zeiterfassungsberichten und Ergreifen von Maßnahmen\n\nIn Insights lassen sich schnell und einfach angepasste Zeiterfassungsberichte erstellen. So wissen Sie genau, wie die Ressourcen Ihres Supportteams genutzt werden, und können verbesserungsbedürftige Bereiche erkennen.\n\nDurch Aktivierung dieser App akzeptieren Sie die [Nutzungsbedingungen für von Zendesk erstellte Apps](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Zeiterfassung","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Der Timer wird angehalten, wenn der Agent vom Ticket zu einem anderen Bereich wechselt, und läuft automatisch weiter, wenn der Agent zum Ticket zurückkehrt.","app.parameters.auto_pause_resume.label":"Automatisch anhalten","app.parameters.debug_prevent_huge_times.helpText":"Blockiert Versuche, ein Ticket einzureichen, bei dem der Wert für die benötigte Zeit größer ist als 1209600 Sekunden (zwei Wochen).","app.parameters.debug_prevent_huge_times.label":"Debugging: Einreichen von Tickets mit übermäßig langer benötigter Zeit verhindern","app.parameters.display_timelogs.helpText":"Agenten können die Zeitprotokollaktivitäten in Tickets sehen.","app.parameters.display_timelogs.label":"Zeitprotokolle für Agenten anzeigen","app.parameters.hide_from_agents.helpText":"Für Agenten, die keine Administratoren sind, ist diese App nicht sichtbar. Dadurch wird verhindert, dass sie beim Einreichen die Zeit sehen und ändern können.","app.parameters.hide_from_agents.label":"App für Agenten ausblenden","app.parameters.manual_pause_resume.helpText":"Agenten können den Timer manuell anhalten oder zurücksetzen.","app.parameters.manual_pause_resume.label":"Timerfunktionen anzeigen","app.parameters.reset.helpText":"Agenten können die aktuelle mit der Bearbeitung eines Tickets verbrachte Zeit zurücksetzen.","app.parameters.reset.label":"Aktuelle Zeit zurücksetzen","app.parameters.resume_on_changes.helpText":"Wenn Feldänderungen vorgenommen werden, werden Sie in einem Modaldialogfeld gefragt, ob der Timer weiterlaufen soll.","app.parameters.resume_on_changes.label":"Bei Änderungen weiterlaufen","app.parameters.simple_submission.helpText":"Agenten können vor Einreichen des Tickets einen Wert in Minuten eingeben.","app.parameters.simple_submission.label":"Vereinfachte Zeiterfassung","app.parameters.time_field_id.helpText":"Die ID eines angepassten numerischen Felds für die Gesamtzeit.","app.parameters.time_field_id.label":"ID des Zeitfelds","app.parameters.time_object_field_id.helpText":"Die ID eines angepassten numerischen Felds für die mit der Bearbeitung des Tickets verbrachte Zeit.","app.parameters.time_object_field_id.label":"ID des Konfigurationsfelds","app.parameters.time_submission.helpText":"Agenten können die verbrachte Zeit vor dem Einreichen des Tickets überprüfen und bearbeiten","app.parameters.time_submission.label":"Eingereichte Zeit bearbeiten","app.short_description":"Erfasst die mit der Bearbeitung von Tickets verbrachte Zeit.","errors.bad_time_with_format":"Ungültiges Zeitformat, erwartet: {{time_format}}.","errors.negative_time":"Die eingegebene Zeit war ein negativer Wert. Der Wert wird auf 0 zurückgesetzt.","errors.no_answer":"Keine Zeit eingereicht","errors.save_hook":"Sie müssen die mit der Bearbeitung dieses Tickets verbrachte Zeit einreichen.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Haben Sie die Installationsanweisungen für diese App befolgt und beide erforderliche Ticketfelder so konfiguriert, dass sie in jedem Ticketformular erscheinen?","errors.setup.solution":'Wenn nicht, lesen Sie <a href="{{url}}" target="_blank">diese Anweisungen</a> und stellen Sie die Einrichtung auf der Seite zur Verwaltung von Ticketformularen fertig.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"Die angegebene Zeitdauer ist zu lang.","statuses.closed":"s","statuses.hold":"a","statuses.new":"n","statuses.open":"o","statuses.pending":"w","statuses.solved":"l",time_format_hms:"HH:mm:ss",time_format_minutes:"Minuten","views.main.pause":"Anhalten","views.main.play":"Wiedergeben","views.main.reset":"Zurücksetzen","views.main.timelogs":"Zeitprotokolle","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Zeit","views.main.total_time_spent":"Gesamtzeit","views.modal.body_with_format":"Dies ist die Zeit ({{time_format}}), die Sie mit der Bearbeitung dieses Tickets verbracht haben. Nehmen Sie ggf. Änderungen vor und klicken Sie dann auf „Zeit einreichen“.","views.modal.close":"Abbrechen","views.modal.count_down":"Dieses Modalfenster wird in {{time}} Sekunden automatisch geschlossen.","views.modal.save":"Zeit einreichen","views.resume_modal.body":"Soll der Timer weiterlaufen?","views.resume_modal.no":"Nein","views.resume_modal.yes":"Ja","views.timelogs.csv_export":"CSV exportieren","views.timelogs.empty":"Keine Zeitprotokolle zur Anzeige verfügbar","views.timelogs.error":"Es können keine Zeitprotokolle geladen werden.","views.timelogs.hide_timelogs":"Zeitprotokolle ausblenden","views.timelogs.show_timelogs":"Zeitprotokolle einblenden","views.timelogs.title":"Zeitprotokolle"}},2370(e){e.exports={"app.installation_instructions":'### Έναρξη με την εφαρμογή "Παρακολούθηση χρόνου":\n\n1. Εισέλθετε στον λογαριασμό σας Zendesk Support και, στη συνέχεια, κάντε κλικ στο εικονίδιο "Διαχειριστής" στην πλευρική εργαλειοθήκη.\n2. Επιλέξτε **Εφαρμογές > Marketplace** και, στη συνέχεια, βρείτε την εφαρμογή "Παρακολούθηση χρόνου" και κάντε κλικ στο πλακίδιο.\n3. Στη σελίδα της εφαρμογής "Παρακολούθηση χρόνου", κάντε κλικ στην επιλογή **Εγκατάσταση εφαρμογής** στην επάνω δεξιά γωνία. Αυτή η εφαρμογή είναι διαθέσιμη μόνο σε πελάτες με προγράμματα Professional και Enterprise.\n4. Εισαγάγετε ένα όνομα για την εφαρμογή, επιλέξτε τις ρυθμίσεις που θέλετε και κάντε κλικ στο κουμπί **Εγκατάσταση**.\n5. Αν χρησιμοποιείτε τις Φόρμες δελτίων (μέρος του πρόσθετου Πακέτου παραγωγικότητας), επιλέξτε **Διαχειριστής > Διαχείριση > Φόρμες δελτίων** και προσθέστε τα πεδία δελτίων "Total time spent" και "Time spent last update" σε κάθε φόρμα δελτίου.',"app.long_description":"* Παρακολουθήστε αυτόματα τον χρόνο που δαπανήθηκε σε καθένα από τα δελτία σας Zendesk Support\n* Εξατομικεύστε την εφαρμογή για να συμπεριληφθεί η ακριβής λειτουργία που χρειάζεται η ομάδα σας\n* Χρησιμοποιήστε το Insights για να δημιουργήσετε λεπτομερείς αναφορές με τα δεδομένα παρακολούθησης χρόνου\n\nΗ εφαρμογή Παρακολούθησης χρόνου κάνει τη διαχείριση της απόδοσης της ομάδας σας και τις συνολικές λειτουργίες υποστήριξης ευκολότερες. Εντοπίστε ποιοι πελάτες στέλνουν τα πιο περίπλοκα δελτία ή ποια είδη προβλημάτων απαιτούν τον περισσότερο χρόνο για να επιλυθούν από την ομάδα σας. Πραγματοποιήστε αναζήτηση στα δελτία ενός εκπροσώπου για να ανακαλύψετε σε τι αφιερώνει τον χρόνο του και σε ποια προβλήματα ειδικεύεται.\n\n### Μάθετε ακριβώς πώς και πάνω σε τι αφιερώνει το χρόνο της η ομάδα σας\n\nΔιατηρήστε μια τρέχουσα καταγραφή αναφορικά με το ποιοι εκπρόσωποι υποστήριξης έχουν εργαστεί σε ένα δελτίο και πόση ώρα διήρκεσε η κάθε αλληλεπίδραση. Καταγράψτε αυτόματα τον συνολικό χρόνο που δαπανήθηκε αμέσως μόλις ο εκπρόσωπός σας ενημερώσει ένα δελτίο ή ζητήστε του να εισαγάγει μη αυτόματα τον χρόνο που δαπάνησε.\n\n### Η εφαρμογή Παρακολούθησης χρόνου είναι εύκολο να εγκατασταθεί, να εξατομικευθεί και να χρησιμοποιηθεί\n\nΔεν απαιτείται εγκατάσταση ή σύνδεση τρίτων μερών. Απλώς εξατομικεύστε τον τρόπο που εμφανίζεται και λειτουργεί για την ομάδα υποστήριξής σας η εφαρμογή Παρακολούθησης χρόνου για απρόσκοπτη ενσωμάτωση στην τρέχουσα ροή εργασιών της ομάδας σας.\n\n### Δημιουργήστε αναφορά με τις καταγραφές χρόνου σας και αναλάβετε δράση\n\nΑρχίστε να δημιουργείτε αναφορές άμεσα με τις εξατομικευμένες αναφορές παρακολούθησης χρόνου που δημιουργούνται εύκολα με τη βοήθεια του Insights. Μάθετε ακριβώς τι στραγγίζει τους πόρους της ομάδας σας υποστήριξης και εντοπίστε τους ιδανικούς τομείς για βελτιστοποίηση και βελτίωση.\n\nΕνεργοποιώντας αυτήν την εφαρμογή, αποδέχεστε τους [Όρους χρήσης του Zendesk](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Παρακολούθηση χρόνου","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Ο χρονοδιακόπτης πραγματοποιεί παύση, όταν ο εκπρόσωπος πραγματοποιεί έξοδο από το δελτίο και συνεχίζει να μετρά, όταν ο εκπρόσωπος επιστρέφει στο δελτίο.","app.parameters.auto_pause_resume.label":"Αυτόματη παύση","app.parameters.debug_prevent_huge_times.helpText":"Αποκλείει την υποβολή ενός δελτίου αν ένας εκπρόσωπος προσπαθεί να υποβάλει ένα δελτίο με μια τιμή χρόνου που δαπανήθηκε (σε δευτερόλεπτα), η οποία είναι μεγαλύτερη από 1209600 δ. (δύο εβδομάδες).","app.parameters.debug_prevent_huge_times.label":"Εντοπισμός σφαλμάτων: Αποκλεισμός υποβολών μεγάλων χρόνων που δαπανήθηκαν","app.parameters.display_timelogs.helpText":"Οι εκπρόσωποι μπορούν να δουν τη δραστηριότητα καταγραφής χρόνου στα δελτία.","app.parameters.display_timelogs.label":"Εμφάνιση καταγραφής χρόνου στους εκπροσώπους","app.parameters.hide_from_agents.helpText":'Η εφαρμογή δεν θα εμφανίζεται στους εκπροσώπους που δεν έχουν ρόλο "Διαχειριστή". Αυτό τους εμποδίζει επίσης να βλέπουν και να επεξεργάζονται τον χρόνο μετά από την υποβολή.',"app.parameters.hide_from_agents.label":"Απόκρυψη της εφαρμογής από τους εκπροσώπους","app.parameters.manual_pause_resume.helpText":"Οι εκπρόσωποι μπορούν να θέσουν σε παύση ή να επαναφέρουν τον χρονοδιακόπτη μη αυτόματα.","app.parameters.manual_pause_resume.label":"Εμφάνιση των στοιχείων ελέγχου του χρονοδιακόπτη","app.parameters.reset.helpText":"Οι εκπρόσωποι μπορούν να επαναφέρουν τον τρέχοντα χρόνο που δαπανήθηκε σε ένα δελτίο.","app.parameters.reset.label":"Επαναφορά τρέχοντα χρόνου","app.parameters.resume_on_changes.helpText":"Όταν γίνονται αλλαγές σε οποιοδήποτε πεδίο, ένα αποκλειστικό παράθυρο διαλόγου θα ρωτήσει αν ο χρονοδιακόπτης πρέπει να συνεχίσει.","app.parameters.resume_on_changes.label":"Συνέχιση αλλαγών","app.parameters.simple_submission.helpText":"Θα ζητηθεί από τους εκπροσώπους να εισαγάγουν μια τιμή σε λεπτά πριν υποβάλουν το δελτίο","app.parameters.simple_submission.label":"Απλοποιημένη υποβολή χρόνου","app.parameters.time_field_id.helpText":"Το αναγνωριστικό ενός προσαρμοσμένου αριθμητικού πεδίου που θα περιλαμβάνει τον συνολικό χρόνο.","app.parameters.time_field_id.label":"Αναγνωριστικό πεδίου χρόνου","app.parameters.time_object_field_id.helpText":"Το αναγνωριστικό ενός προσαρμοσμένου αριθμητικού πεδίου που θα περιλαμβάνει τον χρόνο που δαπανήθηκε σε ένα δελτίο.","app.parameters.time_object_field_id.label":"Διαμόρφωση αναγνωριστικού πεδίου","app.parameters.time_submission.helpText":"Οι εκπρόσωποι μπορούν να ελέγξουν και να επεξεργαστούν τον χρόνο τους πριν από την υποβολή του δελτίου.","app.parameters.time_submission.label":"Επεξεργασία υποβολής χρόνου","app.short_description":"Σας βοηθά να παρακολουθείτε τον χρόνο που δαπανήθηκε στα δελτία.","errors.bad_time_with_format":"Μη έγκυρη μορφή χρόνου, αναμενόμενη {{time_format}}.","errors.negative_time":"Ο χρόνος ήταν αρνητικός. Επαναφορά σε 0.","errors.no_answer":"Δεν υποβλήθηκε χρόνος","errors.save_hook":"Πρέπει να υποβάλετε τον χρόνο σας σε αυτό το δελτίο.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Ακολουθήσατε τις οδηγίες εγκατάστασης γι' αυτήν την εφαρμογή και διαμορφώσατε και τα δύο απαιτούμενα πεδία δελτίων, ώστε να εμφανίζονται σε κάθε φόρμα δελτίου;","errors.setup.solution":'Σε αντίθετη περίπτωση, δείτε <a href="{{url}}" target="_blank">αυτές τις οδηγίες</a> και μεταβείτε στη σελίδα με τις φόρμες δελτίων σας για να ολοκληρώσετε τη ρύθμιση.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"Ο χρόνος υποβολής ήταν υπερβολικά μεγάλος.","statuses.closed":"κ","statuses.hold":"α","statuses.new":"ν","statuses.open":"α","statuses.pending":"ε","statuses.solved":"ε",time_format_hms:"HH:mm:ss",time_format_minutes:"λεπτά","views.main.pause":"Παύση","views.main.play":"Play","views.main.reset":"Επαναφορά","views.main.timelogs":"Καταγραφή χρόνου","views.main.timelogs_table.agent":"Εκπρόσωπος","views.main.timelogs_table.status":"Κατάσταση","views.main.timelogs_table.time":"Χρόνος","views.main.total_time_spent":"Συνολικός χρόνος","views.modal.body_with_format":'Αυτός είναι ο χρόνος ({{time_format}}) που δαπανήσατε στο συγκεκριμένο δελτίο. Επεξεργαστείτε τον χρόνο, εφόσον χρειάζεται, και κατόπιν κάντε κλικ στην επιλογή " Υποβολή χρόνου" .',"views.modal.close":"Ακύρωση","views.modal.count_down":"Αυτό το αποκλειστικό παράθυρο διαλόγου θα κλείσει σε {{time}} δευτερόλεπτα.","views.modal.save":"Υποβολή χρόνου","views.resume_modal.body":"Θέλετε να συνεχίσει ο χρονοδιακόπτης;","views.resume_modal.no":"Όχι","views.resume_modal.yes":"Ναι","views.timelogs.csv_export":"Εξαγωγή CSV","views.timelogs.empty":"Δεν υπάρχει καταγραφή χρόνου για εμφάνιση","views.timelogs.error":"Δεν είναι δυνατή η φόρτωση καμίας καταγραφής χρόνου.","views.timelogs.hide_timelogs":"Απόκρυψη καταγραφών χρόνου","views.timelogs.show_timelogs":"Εμφάνιση καταγραφών χρόνου","views.timelogs.title":"Καταγραφές χρόνου"}},2710(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\r\n\r\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\r\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\r\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\r\n4. Enter a name for the app, select the configurations you want, then click **Install**.\r\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields ‘Total time spent’ and ‘Time spent last update’ to each of your Ticket Forms.","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customise the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team’s performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent’s tickets to discover what’s taking up their time and which issues they’re experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customise, and use\n\nThe Time Tracking App doesn’t require any third party setup or login. Simply customise how the Time Tracking app displays and works for your support team, for a seamless fit into your team’s current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what’s draining your support team’s resources and find the best areas for optimisation and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalise the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},2647(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\r\n\r\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\r\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\r\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\r\n4. Enter a name for the app, select the configurations you want, then click **Install**.\r\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields ‘Total time spent’ and ‘Time spent last update’ to each of your Ticket Forms.","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customise the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team’s performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent’s tickets to discover what’s taking up their time and which issues they’re experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customise, and use\n\nThe Time Tracking App doesn’t require any third party setup or login. Simply customise how the Time Tracking app displays and works for your support team, for a seamless fit into your team’s current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what’s draining your support team’s resources and find the best areas for optimisation and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_re