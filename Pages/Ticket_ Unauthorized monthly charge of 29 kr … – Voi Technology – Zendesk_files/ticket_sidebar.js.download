e are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},5330(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},2394(e){e.exports={"app.installation_instructions":'### Ajankäytön seuranta -sovelluksen käytön aloittaminen:\r\n\r\n1. Kirjaudu sisään Zendesk Support -tilille ja napsauta sitten sivupalkin Järjestelmänvalvoja-kuvaketta.\r\n2. Valitse **Sovellukset > Sovelluskauppa**, etsi Ajankäytön seuranta -sovellus ja napsauta ruutua.\r\n3. Napsauta Ajankäytön seuranta -sovelluksen sivun oikeassa yläkulmassa **Asenna sovellus**. Tämä sovellus on käytettävissä vain Professional- ja Enterprise-tilauksille.\r\n4. Kirjoita sovelluksen nimi, valitse haluamasi määritykset ja napsauta sitten **Asenna**.\r\n5. Jos käytät tikettilomakkeita (osa tuottavuuspakettia), siirry kohtaan **Järjestelmänvalvoja > Hallitse > Tikettilomakkeet** ja lisää tikettikentät "Total time spent" ja "Time spent last update" jokaiseen tikettilomakkeeseen.',"app.long_description":"* Seuraa automaattisesti jokaiseen Zendesk Support -tikettiin käytettyä aikaa\n* Mukauta sovellus sisältämään tarkat toiminnot, joita tiimisi tarvitsee\n* Käytä hyväksi Insightsia luodaksesi tarkkoja raportteja, joissa on ajankäytön seurantatiedot\n\nAjankäytön seuranta -sovellus helpottaa tiimin suorituskyvyn hallintaa ja tukitoimintoja yleisesti ottaen. Tunnista helposti, mitkä asiakkaat lähettävät kaikkein monimutkaisimpia tikettejä tai minkä tyyppisten ongelmien ratkaiseminen vie kaikkein kauimmin. Poraudu tukihenkilön tiketteihin saadaksesi selville, mihin he käyttävät aikaansa ja missä ongelmissa he ovat asiantuntijoita.\n\n### Tiedä täsmälleen, mihin tiimisi käyttää aikaa\n\nSeuraa jatkuvasti, mitkä tukihenkilöt ovat työskennelleet tiketin parissa ja miten kauan kukin vuorovaikutus kesti. Kirjaa automaattisesti käytetty kokonaisaika välittömästi, kun tukihenkilö päivittää tiketin tai anna hänen kirjata aika manuaalisesti.\n\n### Helppo asentaa, mukauttaa ja käyttää\n\nAjankäytön seuranta -sovellus ei vaadi kolmannen osapuolen asennustoimia tai sisäänkirjautumista. Mukauta yksinkertaisesti, miten Ajankäytön seuranta -sovellus esittää tiedot ja toimii tukitiimillesi, jotta se sopisi saumattomasti tiimin nykyiseen työnkulkuun.\n\n### Raportoi ajankäyttö ja ryhdy toimiin\n\nAloita raportointi välittömästi helposti laadittavilla mukautetuilla ajankäytön seurantaraporteilla Insightsin kautta. Tiedät täsmälleen, mikä vie tukitiimin resursseja, ja löydät parhaat optimointia ja parannuksia vaativat alueet.\n\nOttamalla tämän sovelluksen käyttöön hyväksyt [Zendeskin kehittämä -käyttöehdot](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Ajankäytön seuranta","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Ajastin pysähtyy, kun tukihenkilö siirtyy pois tiketistä, ja jatkaa, kun tukihenkilö palaa takaisin tikettiin.","app.parameters.auto_pause_resume.label":"Automaattinen tauko","app.parameters.debug_prevent_huge_times.helpText":"Estää tiketin lähettämisen, jos tukihenkilö yrittää lähettää tiketin sen käsittelyaika-arvolla (sekunneissa), joka on suurempi kuin 1 209 600 s (kaksi viikkoa).","app.parameters.debug_prevent_huge_times.label":"Virheenkorjaus: Estä pitkän käsittelyajan tikettien lähettämiset","app.parameters.display_timelogs.helpText":"Tukihenkilöt voivat nähdä ajankäytön tiketeissä.","app.parameters.display_timelogs.label":"Näytä aikalokit tukihenkilöille","app.parameters.hide_from_agents.helpText":"Sovellusta ei näy tukihenkilöille, joilla ei ole Järjestelmänvalvoja-roolia. Tämä estää myös heitä näkemästä ja muokkaamasta aikaa lähetyksen yhteydessä.","app.parameters.hide_from_agents.label":"Piilota sovellus tukihenkilöiltä","app.parameters.manual_pause_resume.helpText":"Tukihenkilöt voivat pysäyttää tai palauttaa ajastimen manuaalisesti.","app.parameters.manual_pause_resume.label":"Näytä ajastimen ohjaimet","app.parameters.reset.helpText":"Tukihenkilöt voivat nollata tikettiin tällä hetkellä käytetyn ajan.","app.parameters.reset.label":"Nollaa nykyinen aika","app.parameters.resume_on_changes.helpText":"Kun kenttiin tehdään muutoksia, ohjelma kysyy, haluatko jatkaa ajanottoa.","app.parameters.resume_on_changes.label":"Jatka muutosten yhteydessä","app.parameters.simple_submission.helpText":"Tukihenkilöt voivat antaa arvon minuuteissa ennen tiketin lähettämistä.","app.parameters.simple_submission.label":"Yksinkertaistettu aikalähetys","app.parameters.time_field_id.helpText":"Tunnus mukautetulle numerokentälle, joka sisältää kokonaisajan.","app.parameters.time_field_id.label":"Aikakentän tunnus","app.parameters.time_object_field_id.helpText":"Tunnus mukautetulle numerokentälle, joka sisältää tikettiin käytetyn ajan.","app.parameters.time_object_field_id.label":"Kokoonpanokentän tunnus","app.parameters.time_submission.helpText":"Tukihenkilöt voivat tarkastaa ja muokata aikaa ennen tiketin lähettämistä.","app.parameters.time_submission.label":"Muokkaa aikalähetystä","app.short_description":"Auttaa pitämään kirjaa tiketteihin käytetystä ajasta.","errors.bad_time_with_format":"Virheellinen aikamuoto. Aika pitää ilmoittaa muodossa {{time_format}}.","errors.negative_time":"Aika oli negatiivinen. Nollataan.","errors.no_answer":"Aikaa ei ole lähetetty","errors.save_hook":"Sinun pitää lähettää tähän tikettiin käytetty aika.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Noudatitko tämän sovelluksen asennusohjeita ja määrititkö molemmat pakolliset tikettikentät, jotta ne näkyvät kaikissa tikettilomakkeissa?","errors.setup.solution":'Jos et, lue <a href="{{url}}" target="_blank">nämä ohjeet</a> ja suorita asennus loppuun tikettilomakkeiden hallintasivulla.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"Annettu aika oli liian pitkä.","statuses.closed":"s","statuses.hold":"p","statuses.new":"u","statuses.open":"a","statuses.pending":"o","statuses.solved":"r",time_format_hms:"HH:mm:ss",time_format_minutes:"minuuttia","views.main.pause":"Tauko","views.main.play":"Toista","views.main.reset":"Palauta","views.main.timelogs":"Aikaloki","views.main.timelogs_table.agent":"Tukihenkilö","views.main.timelogs_table.status":"Tila","views.main.timelogs_table.time":"Aika","views.main.total_time_spent":"Kokonaisaika","views.modal.body_with_format":'Tämä on aika ({{time_format}}), jonka kulutit tämän tiketin kanssa. Muokkaa aikaa tarvittaessa ja napsauta sitten " Lähetä aika" .',"views.modal.close":"Peruuta","views.modal.count_down":"Tämä modaali sulkeutuu automaattisesti {{time}} sekunnin kuluttua.","views.modal.save":"Lähetä aika","views.resume_modal.body":"Haluatko jatkaa ajanottoa?","views.resume_modal.no":"Ei","views.resume_modal.yes":"Kyllä","views.timelogs.csv_export":"Vie CSV","views.timelogs.empty":"Ei esitettäviä aikalokeja","views.timelogs.error":"Emme pystyneet lataamaan aikalokeja.","views.timelogs.hide_timelogs":"Piilota aikalokit","views.timelogs.show_timelogs":"Näytä aikalokit","views.timelogs.title":"Aikalokit"}},7300(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},5562(e){e.exports={"app.installation_instructions":"### Commencer à utiliser l’application Suivi du temps :\n\n1. Connectez-vous à votre compte Zendesk Support, puis cliquez sur l’icône Admin dans la barre latérale.\n2. Sélectionnez **Applications > Marketplace**, puis recherchez l’application Suivi du temps et cliquez sur la mosaïque.\n3. À la page de l’application Suivi du temps, cliquez sur Installer l’application en haut à droite. Cette application est disponible pour les clients disposant d’une édition Professional ou Enterprise uniquement.\n4. Saisissez un nom pour l’application et configurez les paramètres, puis cliquez sur **Installer**.\n5. Si vous utilisez les formulaires de ticket (qui font partie du module supplémentaire Pack de productivité), allez à **Admin > Gérer > Formulaires de ticket** et ajoutez les champs de ticket « Total time spent » (Temps total passé) et « Time spent last update » (Temps passé pendant la dernière mise à jour) à chacun de vos formulaires de tickets.","app.long_description":"Suivez automatiquement le temps consacré à chacun de vos tickets Zendesk Support\n* Personnalisez l’application pour inclure les fonctionnalités exactes dont votre équipe a besoin\n* Utilisez Insights pour créer des rapports détaillés avec vos données de suivi du temps\n\nL’application Suivi du temps facilite la gestion des performances de votre équipe et de l’ensemble des opérations d’assistance. Identifiez facilement les clients qui envoient les tickets les plus compliqués ou les problèmes les plus longs à résoudre pour votre équipe. Regardez de près les tickets d’un agent pour découvrir ce qui lui prend du temps et de quels problèmes il est expert.\n\n### Découvrez exactement où et à quoi votre équipe passe son temps\n\nConservez un journal des agents d’assistance qui ont travaillé sur un ticket et de la durée de chaque interaction. Enregistrez automatiquement le temps total passé dès que vos agents mettent un ticket à jour ou permettez-leur de saisir leur temps manuellement.\n\n### Facile à configurer, personnaliser et utiliser\n\nL’application Suivi du temps ne nécessite pas de configuration ni de connexion tierce. Il vous suffit de personnaliser l’affichage et le fonctionnement de l’application Suivi du temps pour qu’elle soit parfaitement adaptée au workflow actuel de votre équipe.\n\n### Créez des rapports à partir de vos journaux horaires et prenez les mesures nécessaires\n\nCommencez à créer des rapports immédiatement grâce aux rapports de suivi du temps personnalisés faciles à générer par le biais d’Insights. Découvrez avec précision ce qui draine les ressources de votre équipe d’assistance et identifiez les points à optimiser et améliorer.\n\nEn activant cette application, vous acceptez les [conditions d’utilisation Créées par Zendesk](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Suivi du temps","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Le minuteur s’arrête quand l’agent quitte le ticket et reprend quand l’agent revient au ticket.","app.parameters.auto_pause_resume.label":"Pause automatique","app.parameters.debug_prevent_huge_times.helpText":"Bloque l’envoi d’un ticket si un agent essaie d’envoyer un ticket avec une valeur de temps passé (en secondes) supérieure à 1 209 600 (deux semaines).","app.parameters.debug_prevent_huge_times.label":"Débogage : bloquez les envois avec valeur de temps passé élevée","app.parameters.display_timelogs.helpText":"Les agents peuvent voir l’activité des journaux horaires.","app.parameters.display_timelogs.label":"Afficher les journaux horaires pour les agents","app.parameters.hide_from_agents.helpText":"Les agents ne disposant pas du rôle d’administrateur ne verront pas cette application. Cela les empêche également de voir et de modifier les données de temps au moment de l’envoi.","app.parameters.hide_from_agents.label":"Masquer l’application pour les agents","app.parameters.manual_pause_resume.helpText":"Les agents peuvent arrêter ou réinitialiser le minuteur manuellement.","app.parameters.manual_pause_resume.label":"Afficher les contrôles du minuteur","app.parameters.reset.helpText":"Les agents peuvent réinitialiser le temps actuel consacré à un ticket.","app.parameters.reset.label":"Réinitialiser le temps actuel","app.parameters.resume_on_changes.helpText":"Quand des modifications sont apportées à un champ, vous serez invité à indiquer si vous voulez relancer le chronomètre.","app.parameters.resume_on_changes.label":"Relancer en cas de modifications","app.parameters.simple_submission.helpText":"Les agents peuvent saisir une valeur en minutes avant d’envoyer le ticket.","app.parameters.simple_submission.label":"Envoi du temps simplifié","app.parameters.time_field_id.helpText":"L’identifiant d’un champ numérique personnalisé qui contiendra le temps total.","app.parameters.time_field_id.label":"Identifiant du champ de temps","app.parameters.time_object_field_id.helpText":"L’identifiant d’un champ numérique personnalisé qui contiendra le temps consacré au ticket.","app.parameters.time_object_field_id.label":"Identifiant du champ de configuration","app.parameters.time_submission.helpText":"Les agents peuvent consulter et modifier leur temps avant d’envoyer le ticket.","app.parameters.time_submission.label":"Modifier l’envoi du temps","app.short_description":"Vous aide à suivre le temps consacré aux tickets.","errors.bad_time_with_format":"Format d’heure non valide, format attendu {{time_format}}.","errors.negative_time":"Le temps était négatif. Réinitialisation à 0.","errors.no_answer":"Aucun temps envoyé","errors.save_hook":"Vous devez envoyer votre temps pour ce ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Avez-vous suivi les instructions d’installation pour cette application et configuré les deux champs de tickets obligatoires pour qu’ils s’affichent sur chaque formulaire de ticket?","errors.setup.solution":'Si ce n’est pas le cas, consultez <a href="{{url}}" target="_blank">ces instructions</a> et allez à votre page de gestion des formulaires de tickets pour finaliser la configuration.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"Le temps de saisie était trop long.","statuses.closed":"c","statuses.hold":"p","statuses.new":"n","statuses.open":"o","statuses.pending":"a","statuses.solved":"r",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Lire","views.main.reset":"Réinitialiser","views.main.timelogs":"Journal horaire","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Statut","views.main.timelogs_table.time":"Temps","views.main.total_time_spent":"Temps total ","views.modal.body_with_format":"C’est le temps ({{time_format}}) que vous avez consacré à ce ticket. Modifiez le temps si nécessaire, puis cliquez sur Envoyer le temps.","views.modal.close":"Annuler","views.modal.count_down":"Cette fenêtre se fermera automatiquement dans {{time}} secondes.","views.modal.save":"Envoyer le temps","views.resume_modal.body":"Voulez-vous relancer le chronomètre?","views.resume_modal.no":"Non","views.resume_modal.yes":"Oui","views.timelogs.csv_export":"Exporter au format CSV","views.timelogs.empty":"Aucun journal horaire à afficher","views.timelogs.error":"Échec du chargement des journaux horaires.","views.timelogs.hide_timelogs":"Masquer les journaux horaires","views.timelogs.show_timelogs":"Afficher les journaux horaires","views.timelogs.title":"Journal horaire"}},8339(e){e.exports={"app.installation_instructions":"### Commencer à utiliser l’application Suivi du temps :\n\n1. Connectez-vous à votre compte Zendesk Support, puis cliquez sur l’icône Admin dans la barre latérale.\n2. Sélectionnez **Applications > Marketplace**, puis recherchez l’application Suivi du temps et cliquez sur la mosaïque.\n3. À la page de l’application Suivi du temps, cliquez sur Installer l’application en haut à droite. Cette application est disponible pour les clients disposant d’une édition Professional ou Enterprise uniquement.\n4. Saisissez un nom pour l’application et configurez les paramètres, puis cliquez sur **Installer**.\n5. Si vous utilisez les formulaires de ticket (qui font partie du module supplémentaire Pack de productivité), allez à **Admin > Gérer > Formulaires de ticket** et ajoutez les champs de ticket « Total time spent » (Temps total passé) et « Time spent last update » (Temps passé pendant la dernière mise à jour) à chacun de vos formulaires de tickets.","app.long_description":"Suivez automatiquement le temps consacré à chacun de vos tickets Zendesk Support\n* Personnalisez l’application pour inclure les fonctionnalités exactes dont votre équipe a besoin\n* Utilisez Insights pour créer des rapports détaillés avec vos données de suivi du temps\n\nL’application Suivi du temps facilite la gestion des performances de votre équipe et de l’ensemble des opérations d’assistance. Identifiez facilement les clients qui envoient les tickets les plus compliqués ou les problèmes les plus longs à résoudre pour votre équipe. Regardez de près les tickets d’un agent pour découvrir ce qui lui prend du temps et de quels problèmes il est expert.\n\n### Découvrez exactement où et à quoi votre équipe passe son temps\n\nConservez un journal des agents d’assistance qui ont travaillé sur un ticket et de la durée de chaque interaction. Enregistrez automatiquement le temps total passé dès que vos agents mettent un ticket à jour ou permettez-leur de saisir leur temps manuellement.\n\n### Facile à configurer, personnaliser et utiliser\n\nL’application Suivi du temps ne nécessite pas de configuration ni de connexion tierce. Il vous suffit de personnaliser l’affichage et le fonctionnement de l’application Suivi du temps pour qu’elle soit parfaitement adaptée au workflow actuel de votre équipe.\n\n### Créez des rapports à partir de vos journaux horaires et prenez les mesures nécessaires\n\nCommencez à créer des rapports immédiatement grâce aux rapports de suivi du temps personnalisés faciles à générer par le biais d’Insights. Découvrez avec précision ce qui draine les ressources de votre équipe d’assistance et identifiez les points à optimiser et améliorer.\n\nEn activant cette application, vous acceptez les [conditions d’utilisation Créées par Zendesk](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Suivi du temps","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Le minuteur s’arrête quand l’agent quitte le ticket et reprend quand l’agent revient au ticket.","app.parameters.auto_pause_resume.label":"Pause automatique","app.parameters.debug_prevent_huge_times.helpText":"Bloque l’envoi d’un ticket si un agent essaie d’envoyer un ticket avec une valeur de temps passé (en secondes) supérieure à 1 209 600 (deux semaines).","app.parameters.debug_prevent_huge_times.label":"Débogage : bloquez les envois avec valeur de temps passé élevée","app.parameters.display_timelogs.helpText":"Les agents peuvent voir l’activité des journaux horaires.","app.parameters.display_timelogs.label":"Afficher les journaux horaires pour les agents","app.parameters.hide_from_agents.helpText":"Les agents ne disposant pas du rôle d’administrateur ne verront pas cette application. Cela les empêche également de voir et de modifier les données de temps au moment de l’envoi.","app.parameters.hide_from_agents.label":"Masquer l’application pour les agents","app.parameters.manual_pause_resume.helpText":"Les agents peuvent arrêter ou réinitialiser le minuteur manuellement.","app.parameters.manual_pause_resume.label":"Afficher les contrôles du minuteur","app.parameters.reset.helpText":"Les agents peuvent réinitialiser le temps actuel consacré à un ticket.","app.parameters.reset.label":"Réinitialiser le temps actuel","app.parameters.resume_on_changes.helpText":"Quand des modifications sont apportées à un champ, vous serez invité à indiquer si vous voulez relancer le chronomètre.","app.parameters.resume_on_changes.label":"Relancer en cas de modifications","app.parameters.simple_submission.helpText":"Les agents peuvent saisir une valeur en minutes avant d’envoyer le ticket.","app.parameters.simple_submission.label":"Envoi du temps simplifié","app.parameters.time_field_id.helpText":"L’ID d’un champ numérique personnalisé qui contiendra le temps total.","app.parameters.time_field_id.label":"ID du champ de temps","app.parameters.time_object_field_id.helpText":"L’ID d’un champ numérique personnalisé qui contiendra le temps consacré au ticket.","app.parameters.time_object_field_id.label":"ID du champ de configuration","app.parameters.time_submission.helpText":"Les agents peuvent consulter et modifier leur temps avant d’envoyer le ticket.","app.parameters.time_submission.label":"Modifier l’envoi du temps","app.short_description":"Vous aide à suivre le temps consacré aux tickets.","errors.bad_time_with_format":"Format d’heure non valide, format attendu {{time_format}}.","errors.negative_time":"Le temps était négatif. Réinitialisation à 0.","errors.no_answer":"Aucun temps envoyé","errors.save_hook":"Vous devez envoyer votre temps pour ce ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Avez-vous suivi les instructions d’installation pour cette application et configuré les deux champs de tickets obligatoires pour qu’ils s’affichent sur chaque formulaire de ticket ?","errors.setup.solution":'Si ce n’est pas le cas, consultez <a href="{{url}}" target="_blank">ces instructions</a> et allez à votre page de gestion des formulaires de tickets pour finaliser la configuration.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"Le temps de saisie était trop long.","statuses.closed":"c","statuses.hold":"p","statuses.new":"n","statuses.open":"o","statuses.pending":"a","statuses.solved":"r",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Lire","views.main.reset":"Réinitialiser","views.main.timelogs":"Journal horaire","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Statut","views.main.timelogs_table.time":"Temps","views.main.total_time_spent":"Temps total ","views.modal.body_with_format":"C’est le temps ({{time_format}}) que vous avez consacré à ce ticket. Modifiez le temps si nécessaire, puis cliquez sur Envoyer le temps.","views.modal.close":"Annuler","views.modal.count_down":"Cette fenêtre se fermera automatiquement dans {{time}} secondes.","views.modal.save":"Envoyer le temps","views.resume_modal.body":"Voulez-vous relancer le chronomètre ?","views.resume_modal.no":"Non","views.resume_modal.yes":"Oui","views.timelogs.csv_export":"Exporter au format CSV","views.timelogs.empty":"Aucun journal horaire à afficher","views.timelogs.error":"Échec du chargement des journaux horaires.","views.timelogs.hide_timelogs":"Masquer les journaux horaires","views.timelogs.show_timelogs":"Afficher les journaux horaires","views.timelogs.title":"Journal horaire"}},9027(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},1160(e){e.exports={"app.installation_instructions":"### תחילת העבודה עם האפליקציה 'טיימר':\n\n1. היכנס לחשבון Zendesk Support ולחץ על האייקון של ניהול המערכת בסרגל הצידי.\n2. בחר **'אפליקציות' > 'שוק'**, מצא את האפליקציה 'טיימר' ולחץ על האריח.\n3. בדף של האפליקציה 'טיימר', לחץ על **'התקן אפליקציה'** בפינה הימנית העליונה. אפליקציה זו זמינה רק ללקוחות בתוכניות Professional ו-Enterprise‏.\n4. הזן שם בשביל האפליקציה, קבע הגדרות כרצונך ולחץ על **'התקן'**.\n5. אם אתה משתמש בטופסי פנייה (חלק מההרחבה 'חבילת יעילות'), עבור אל **'ניהול המערכת' > 'נהל' > 'טופסי פנייה'** והוסף לכל טופסי הפנייה את השדות 'Total time spent' ו-'Time spent last update'.","app.long_description":"*רשום אוטומטית את הזמן שהוקדש לכל אחת מהפניות ב-Zendesk Support\n* התאם את האפליקציה כדי שתכלול בדיוק את הפונקציונליות שהצוות שלך צריך\n* מנף את Insights ליצירת דוחות מפורטים על סמך הנתונים של 'טיימר'\n\nעם האפליקציה 'טיימר' קל יותר לנהל את הביצועים של הצוות ואת התמיכה בכלל. זהה בקלות את הלקוחות ששולחים את הפניות הכי מסובכות או את סוגי הבעיות שהצוות מתקשה לפתור. חקור לעומק את הפניות של כל נציג וגלה אילו נושאים מעכבים אותו ובאילו נושאים הוא מומחה./n/n### דע תמיד איך ואיפה הנציגים מנצלים את זמנם\n\nנהל רישום רצוף של כל נציגי התמיכה שעבדו על פנייה ושל אורך כל אינטראקציה. שמור אוטומטית את זמן הטיפול הכולל בפנייה ברגע שהנציג מעדכן אותה או תן לנציגים להזין את משך הזמן ידנית.\n\n### קל להגדיר, להתאים ולהשתמש\n\nכדי להשתמש באפליקציה 'טיימר' אין צורך בהגדרות או בכניסה לחשבון של צד שלישי. צריך רק להתאים את התצוגה והתפקוד של האפליקציה 'טיימר' לצוות התמיכה, לשילוב חלק שלה בזרימת העבודה הנוכחית של הצוות.\n\n###צור דוחות לפי רישומי הטיימר ופעל בהתאם\n\nבנה ב-Insights בקלות דוחות מותאמים ל'טיימר' והתחל ליהנות מיד מהדיווחים. גלה מה גוזל את משאבי צוות התמיכה ובאילו אזורים כדאי להתייעל ולהשתפר.\n\nבהפעלת האפליקציה אתה מסכים ל[תנאי השימוש של 'נבנה באמצעות Zendesk'‏](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"טיימר","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"הטיימר עוצר כשהנציג עוזב את דף הפנייה וממשיך כשהנציג חוזר לדף הפנייה.","app.parameters.auto_pause_resume.label":"השהיה אוטומטית","app.parameters.debug_prevent_huge_times.helpText":"חוסם שליחה של פנייה אם הנציג מנסה לשלוח פנייה עם ערך שגדול מ-1,209,600 שניות (שבועיים) בשדה 'הזמן שהושקע'.","app.parameters.debug_prevent_huge_times.label":"דיבאג: חסום שליחות עם ערך גדול בזמן שהושקע","app.parameters.display_timelogs.helpText":"הנציגים יכולים לראות את רישומי הטיימר בפניות.","app.parameters.display_timelogs.label":"הצג לנציגים את רישומי הטיימר","app.parameters.hide_from_agents.helpText":"האפליקציה לא תוצג לנציגים שאינם בתפקיד 'מנהל מערכת'. הם גם לא יוכלו לראות ולערוך את הזמן כשהם שולחים פנייה.","app.parameters.hide_from_agents.label":"הסתר את האפליקציה מנציגים","app.parameters.manual_pause_resume.helpText":"הנציגים יכולים להשהות או לאפס את הטיימר ידנית.","app.parameters.manual_pause_resume.label":"הצג את פקדי הטיימר","app.parameters.reset.helpText":"הנציגים יכולים לאפס את זמן הטיפול הנוכחי בפנייה.","app.parameters.reset.label":"אפס את הזמן הנוכחי","app.parameters.resume_on_changes.helpText":"כשנעשים שינויים בשדות כלשהם, מופיע חלון עם השאלה אם להמשיך את הטיימר.","app.parameters.resume_on_changes.label":"המשך כשנעשים שינויים","app.parameters.simple_submission.helpText":"בקש מהנציגים להזין ערך בדקות לפני שליחת הפנייה","app.parameters.simple_submission.label":"שליחת זמן פשוטה","app.parameters.time_field_id.helpText":"המזהה של שדה מספרי מותאם שיכיל את הזמן הכולל.","app.parameters.time_field_id.label":"מזהה שדה זמן","app.parameters.time_object_field_id.helpText":"המזהה של שדה מספרי מותאם שיכיל את זמן הטיפול בפנייה.","app.parameters.time_object_field_id.label":"מזהה שדה הגדרת תצורה","app.parameters.time_submission.helpText":"הנציגים יכולים להציג ולערוך את הזמן לפני שהם שולחים פנייה.","app.parameters.time_submission.label":"עריכת הזמן בשליחה","app.short_description":"עוזר לעקוב אחרי זמני הטיפול בפניות.","errors.bad_time_with_format":"פורמט זמן לא חוקי, הפורמט המצופה: {{time_format}}.","errors.negative_time":"הזמן היה שלילי. מאפס ל-0.","errors.no_answer":"לא נשלח זמן","errors.save_hook":"חובה לציין את הזמן בפנייה.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"האם פעלת לפי הוראות ההתקנה של אפליקציה זו ובחרת ששני שדות החובה בפנייה יופיעו בכל טופסי הפנייה?","errors.setup.solution":'אם לא, עיין <a href="{{url}}" target="_blank">בהוראות אלה</a> ועבור לדף ניהול טופסי הפנייה להשלמת ההתקנה.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"הזמן שנשלח היה ארוך מדי.","statuses.closed":"ס","statuses.hold":"מ","statuses.new":"ח","statuses.open":"פ","statuses.pending":"ב","statuses.solved":"ת",time_format_hms:"HH:mm:ss",time_format_minutes:"דקות","views.main.pause":"השהה","views.main.play":"הפעל","views.main.reset":"איפוס","views.main.timelogs":"רישומי הטיימר","views.main.timelogs_table.agent":"נציג","views.main.timelogs_table.status":"סטטוס","views.main.timelogs_table.time":"זמן","views.main.total_time_spent":"הזמן הכולל","views.modal.body_with_format":"זהו משך הזמן ({{time_format}}) שהקדשת לפנייה הזאת. ערוך את הזמן, אם יש צורך בכך, ולאחר מכן לחץ על 'שלח אותי'.","views.modal.close":"בטל","views.modal.count_down":"החלון המודאלי הזה ייסגר אוטומטית בעוד {{time}} שניות.","views.modal.save":"שלח זמן","views.resume_modal.body":"האם אתה רוצה להמשיך את הטיימר?","views.resume_modal.no":"לא","views.resume_modal.yes":"כן","views.timelogs.csv_export":"יצא CSV","views.timelogs.empty":"אין רישומי טיימר להצגה","views.timelogs.error":"לא נטענו רישומי טיימר.","views.timelogs.hide_timelogs":"הסתר את רישומי הטיימר","views.timelogs.show_timelogs":"הצג את רישומי הטיימר","views.timelogs.title":"רישומי הטיימר"}},716(e){e.exports={"app.installation_instructions":"### टाइम ट्रैकिंग ऐप के साथ आरंभ करना:\r\n\r\n1. अपने Zendesk Support खाते में साइन इन करें, फिर साइडबार में व्यवस्थापक आइकन पर क्लिक करें.\r\n2. **ऐप्स > मार्केटप्लेस** का चयन करें, फिर टाइम ट्रैकिंग ऐप ढूंढें और टाइल पर क्लिक करें.\r\n3. टाइम ट्रैकिंग ऐप पृष्ठ पर, ऊपर-दाएं कोने में **ऐप स्थापित करें** पर क्लिक करें. यह ऐप केवल Professional और Enterprise योजना पर ग्राहकों के लिए उपलब्ध है.\r\n4. ऐप के लिए नाम दर्ज करें, अपने इच्छित कॉन्फ़िगरेशन का चयन करें फिर **स्थापित करें** क्लिक करें.\r\n5. अगर आप टिकट फ़ॉर्म (प्रोडक्टिविटी पैक एड-ऑन का भाग) का उपयोग करते हैं तो **व्यवस्थापक > प्रबंधित करें > टिकट फ़ॉर्म** पर जाएं और टिकट फ़ील्ड ‘Total time spent’ और आपके प्रत्येक टिकट फ़ॉर्म के ‘Time spent last update’ जोड़ें.","app.long_description":"* अपने प्रत्येक Zendesk Support टिकट में बिताए गए समय को स्वचालित रूप से ट्रैक करें\n* अपनी टीम के लिए आवश्यक वास्तविक कार्यक्षमता शामिल करने के लिए ऐप को कस्टमाइज़ करें\n* अपने टाइम ट्रैकिंग डेटा के साथ विस्तृत रिपोर्ट बनाने के लिए Insights का लाभ उठाएं\n\nटाइम ट्रैकिंग ऐप आपकी टीम के प्रदर्शन और कुल सहायता संचालनों को अधिक आसानी से प्रबंधित करने देता है. आसानी से पहचान करें कि कौन-से ग्राहकों को सर्वाधिक जटिंग टिकट भेजे गए हैं या आपकी टीम को किस समस्या का समाधान करने में सबसे अधिक समय लगता है. यह खोजने के लिए एजेंट के टिकट पर जाएं कि किस चीज़ में उनका समय लग रहा है और वे किस समस्या पर विशेषज्ञ हैं.\n\n### जानें कि आपकी टीम वाकई कैसे और कहां अपना समय व्यतीत कर रही है\n\nइसका जारी लॉग रखें कि किस सहायता एजेंट ने टिकट पर कार्य किया और प्रत्येक सहभागिता कितने समय तक चली. आपके एजेंट द्वारा टिकट को अपडेट करने वाले दूसरे समय को स्वचालित रूप से लॉग इन करें या उन्हें अपना समय मैन्युअल रूप से दर्ज करने दें.\n\n### सेट करने, कस्टमाइज़ और उपयोग करने में आसान\n\nटाइम ट्रैकिंग ऐप के लिए किसी तृतीय पक्ष सेटअप या लॉगिन की आवश्यकता नहीं है. आपकी टीम के वर्तमान कार्यप्रवाह में बाधारहित उपयुक्तता के लिए बस कस्टमाइज़ करें कि टाइम ट्रैकिंग ऐप कैसा दिखाई देता है और आपकी सहायता टीम के लिए कैसे कार्य करता है.\n\n### अपने समय लॉग पर रिपोर्ट करें और कार्रवाई करें\n\nInsights के माध्यम से आसानी से बनाए गए कस्टम टाइम ट्रैकिंग रिपोर्ट्स के साथ तुरंत रिपोर्टिंग आरंभ करें. जाने की आपकी सहायता टीम के संसाधनों में वाकई क्या कमी है और ऑप्टिमाइज़ेशन और सुधार के सर्वश्रेष्ठ क्षेत्रों को ढूंढें.\n\nइस ऐप को सक्षम करके, आप [Zendesk उपयोग की शर्तों द्वारा निर्मित](https://www.zendesk.com/company/built-by-zendesk-agmt/) से सहमत होते हैं.","app.name":"टाइम ट्रैकिंग","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"जब एजेंट टिकट से दूर नेविगेट करता है तब टाइमर रुक जाता है और जब एजेंट टिकट पर वापस आ जाता है तो फिर से शुरू हो जाता है.","app.parameters.auto_pause_resume.label":"स्वतः विराम दें","app.parameters.debug_prevent_huge_times.helpText":"यदि कोई एजेंट टिकट सबमिट करने के लिएें 1209600s मूल्य (सेकेंड में) (दो सप्ताह) से अधिक समय की अवधि से प्रयास कर रहा है तो टिकट का सबमिशन ब्लॉक करता है.","app.parameters.debug_prevent_huge_times.label":"डीबग: सबमिशन करने मे अधिक समय लगने पर ब्लॉक करें","app.parameters.display_timelogs.helpText":"एजेंट टिकट पर टाइमलॉग गतिविधि देख सकते हैं.","app.parameters.display_timelogs.label":"एजेंट को टाइमलॉग प्रदर्शित करें","app.parameters.hide_from_agents.helpText":"ऐप उन एजेंट को नहीं दिखाई देगा जिनकी 'व्यवस्थापक' भूमिका नहीं है. यह उन्हें सबमिशन पर समय को देखने और संपादित करने से भी रोकता है.","app.parameters.hide_from_agents.label":"एजेंट से ऐप को छिपाएं","app.parameters.manual_pause_resume.helpText":"एजेंट मैन्युअल रूप से टाइमर को विराम दे सकते हैं या रीसेट कर सकते हैं.","app.parameters.manual_pause_resume.label":"टाइमर नियंत्रण प्रदर्शित करें","app.parameters.reset.helpText":"एजेंट टिकट पर वर्तमान में बिताए गए समय को रीसेट कर सकते हैं.","app.parameters.reset.label":"वर्तमान समय रीसेट करें","app.parameters.resume_on_changes.helpText":"जब किसी फ़ील्ड पर बदलाव किए जाते हैं, तब मॉडल पूछेगा कि क्या टाइमर फिर से शुरू किया जाना चाहिए.","app.parameters.resume_on_changes.label":"बदलावों पर फिर से शुरू करें","app.parameters.simple_submission.helpText":"टिकट सबमिट करने से पहले एजेंट को मिनटों में एक मान दर्ज करने का संकेत दें","app.parameters.simple_submission.label":"सरलीकृत समय सबमिशन","app.parameters.time_field_id.helpText":"कस्टम सांख्यिक फ़ील्ड की आईडी जो कुल समय को रोकेगी.","app.parameters.time_field_id.label":"समय फ़ील्ड आईडी","app.parameters.time_object_field_id.helpText":"कस्टम सांख्यिक फ़ील्ड की आईडी जो टिकट पर बिताए गए समय को समय को रोकेगी.","app.parameters.time_object_field_id.label":"कॉन्फ़िगरेशन फ़ील्ड आईडी","app.parameters.time_submission.helpText":"एजेंट टिकट सबमिट करने से पहले अपने समय की समीक्षा और संपादित कर सकते हैं.","app.parameters.time_submission.label":"समय सबमिशन संपादित करें","app.short_description":"टिकट पर बिताए गए समय को ट्रैक करने में आपकी सहायता करता है.","errors.bad_time_with_format":"अमान्य समय प्रारूप, {{time_format}} अपेक्षित.","errors.negative_time":"समय ऋणात्मक था. 0 पर रीसेट किया जा रहा है.","errors.no_answer":"कोई समय सबमिट नहीं किया गया","errors.save_hook":"आपको इस टिकट पर अपने समय को सबमिट करने की आवश्यकता है.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"क्या आपने इस ऐप के लिए स्थापना निर्देशों का अनुसरण किया है और प्रत्येक टिकट फ़ॉर्म पर दिखाई देने के लिए दोनों आवश्यक फ़ील्ड को कॉन्फ़िगर किया है?","errors.setup.solution":'यदि नहीं, तो कृपया <a href="{{url}}" target="_blank">इन निर्देशों</a> को देखें और सेटअप को अंतिम रूप देने के लिए अपने टिकट फ़ॉर्म प्रबंधन पेज पर जाएं.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"सबमिट किया गया समय बहुत लंबा था.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"मिनट","views.main.pause":"विराम दें","views.main.play":"चलाएं","views.main.reset":"रीसेट करें","views.main.timelogs":"टाइमलॉग","views.main.timelogs_table.agent":"एजेंट","views.main.timelogs_table.status":"स्थिति","views.main.timelogs_table.time":"समय","views.main.total_time_spent":"कुल समय","views.modal.body_with_format":'यह आपके द्वारा इस टिकट पर बिताया गया समय ({{time_format}}) है. यदि आवश्यक हो तो, समय को संपादित करें, फिर " समय भेजें"  पर क्लिक करें.',"views.modal.close":"रद्द करें","views.modal.count_down":"यह मॉडल स्वचालित रूप से सेकंड {{time}} में बंद हो जाएगा.","views.modal.save":"समय सबमिट करें","views.resume_modal.body":"क्या आप समय को फिर से शुरू करना चाहेंगे?","views.resume_modal.no":"नहीं","views.resume_modal.yes":"हाँ","views.timelogs.csv_export":"CSV निर्यात करें","views.timelogs.empty":"प्रदर्शित करने के लिए कोई टाइमलॉग नहीं है","views.timelogs.error":"हम किसी भी टाइमलॉग को लोड करने में असमर्थ हैं.","views.timelogs.hide_timelogs":"टाइमलॉग छिपाएं","views.timelogs.show_timelogs":"टाइमलॉग दिखाएं","views.timelogs.title":"टाइमलॉग"}},4305(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},648(e){e.exports={"app.installation_instructions":"### Az Időnyilvántartás alkalmazás használatának első lépései:\r\n\r\n1. Jelentkezzen be a Zendesk Support-fiókjába, majd kattintson az oldalsávon található Rendszergazda ikonra.\r\n2. Válassza az **Alkalmazások > Piactér** lehetőséget, keresse meg az Időnyilvántartás alkalmazást, majd kattintson az alkalmazást jelölő téglalapra.\r\n3. Az Időnyilvántartás alkalmazás oldalán a jobb felső sarokban kattintson az **Alkalmazás telepítése** gombra. Az alkalmazás csak Professional vagy Enterprise csomagok ügyfeleinek érhető el.\r\n4. Adjon egy nevet az alkalmazásnak, adja meg a kívánt beállításokat, majd kattintson a **Telepítés** gombra.\r\n5. Ha jegybejelentőket használ (amelyek a Productivity Pack bővítmény részei), nyissa meg a **Rendszergazda > Kezelés > Jegybejelentők** menüpontot, majd adja hozzá a „Total time spent” és a „Time spent last update” mezőket az összes jegybejelentőjéhez.","app.long_description":"* Minden Zendesk Support-jegyhez automatikusan nyilvántarthatja a vele eltöltött időt\n* Testreszabhatja az alkalmazást, hogy tartalmazza a csapata számára szükséges funkciókat\n* Kihasználhatja az Insightsban rejlő lehetőségeket, és részletes jelentéseket készíthet az időnyilvántartási adatain\n\nA Time Tracking alkalmazással könnyebben tarthatja kézben csapata teljesítményét és az egész támogatási folyamatot. Egyszerűen azonosíthatja, hogy mely ügyfelek küldik be a legbonyolultabb jegyeket, vagy hogy mely típusú jegyek megoldása tart a legtovább csapatának. A munkatársak jegyeinek mélyére ásva felfedezheti, hogy mi tart nekik tovább, és mely problémák szakértői.\n\n### Pontosan tudhatja, hogyan és hol töltik a munkatársai az idejüket\n\nFolyamatosan naplózhatja, mely támogató munkatársak dolgoztak egy jegyen, és hogy mennyi időt vettek igénybe az egyes interakciók. A jegy frissítésének pillanatában automatikusan naplózhatja, hogy összesen mennyi időt töltött a jeggyel a munkatárs, vagy engedélyezheti, hogy saját maguk írják be ezt az időt.\n\n### Egyszerű beállítás, testreszabás és használat\n\nA Time Tracking alkalmazás nem igényli semmilyen, más gyártótól származó termék beállítását vagy bejelentkezési adatainak megadását. Egyszerűen testreszabhatja csapata számára a Time Tracking alkalmazás megjelenését és működését, hogy zökkenőmentesen illeszkedhessen a csapata jelenlegi munkafolyamataiba.\n\n###Jelentéseket készíthet az idővel kapcsolatos naplóiból, és azoknak megfelelően cselekedhet\n\nAz Insightson keresztül azonnal nekiláthat az egyszerűen összeállítható, egyéni időnyilvántartási jelentések készítésének. Megtudhatja, pontosan mi emészti fel a támogatócsapata erőforrásait, és hogy mely területeken lehet optimalizálni vagy javítani a hatékonyságot.\n\nAz alkalmazás engedélyezésével elfogadja a [Built by Zendesk felhasználási feltételeit](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Időnyilvántartás","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Az időmérő szünetel, amikor a munkatárs elnavigál a jegyről és újraindul, amikor visszatér a jegyre.","app.parameters.auto_pause_resume.label":"Automatikus szüneteltetés","app.parameters.debug_prevent_huge_times.helpText":"Letiltja a jegy beküldését, ha a munkatárs egy olyan jegyet próbál beküldeni, amelynél a ráfordított idő (másodpercekben kifejezett) értéke meghaladja az 1 209 600 másodpercet (két hetet).","app.parameters.debug_prevent_huge_times.label":"Hibakeresés: Nagy időigényű bejegyzések küldésének tiltása","app.parameters.display_timelogs.helpText":"A munkatársak megtekinthetik az időnaplókat a jegyeken.","app.parameters.display_timelogs.label":"Időnaplók megjelenítése a munkatársaknak","app.parameters.hide_from_agents.helpText":"Az alkalmazás nem jelenik meg azoknak a munkatársaknak, akik nem rendelkeznek Rendszergazda szereppel. Ez azt is megakadályozza, hogy megtekintsék és szerkesszék az időt beküldéskor.","app.parameters.hide_from_agents.label":"Alkalmazás elrejtése a munkatársak elől","app.parameters.manual_pause_resume.helpText":"A munkatársak manuálisan szüneteltethetik és visszaállíthatják a számlálót.","app.parameters.manual_pause_resume.label":"Számlálókezelési lehetőségek megjelenítése","app.parameters.reset.helpText":"A munkatársak visszaállíthatják az aktuális eltelt időt a jegyeknél.","app.parameters.reset.label":"Aktuális idő visszaállítása","app.parameters.resume_on_changes.helpText":"Mezők módosításakor a rendszer rákérdez, hogy folytatódjon-e az idő mérése.","app.parameters.resume_on_changes.label":"Folytatás módosítások esetén","app.parameters.simple_submission.helpText":"Kérje fel a munkatársakat, hogy adjanak meg egy percben megadott értéket, mielőtt beküldik a jegyet","app.parameters.simple_submission.label":"Egyszerűsített időbeküldés","app.parameters.time_field_id.helpText":"A teljes időt rögzítő egyéni számmező azonosítója.","app.parameters.time_field_id.label":"Időmező azonosítója","app.parameters.time_object_field_id.helpText":"A jegyen töltött időt rögzítő egyéni számmező azonosítója.","app.parameters.time_object_field_id.label":"Konfigurációs mező azonosítója","app.parameters.time_submission.helpText":"A munkatársak megtekinthetik és szerkeszthetik az időt a jegy beküldése előtt.","app.parameters.time_submission.label":"Beküldési idő szerkesztése","app.short_description":"Segít nyilvántartani a jegyekkel töltött időt.","errors.bad_time_with_format":"Érvénytelen időformátum. A várt formátum: {{time_format}}.","errors.negative_time":"Az idő negatív volt. Visszaállítás 0-ra.","errors.no_answer":"Nincs idő megadva","errors.save_hook":"Be kell küldenie a jegyen töltött időt.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Követte a telepítési utasításokat ehhez az alkalmazáshoz, és beállította a kötelező jegymezőket, hogy minden jegyűrlapon megjelenjenek?","errors.setup.solution":'Ha nem, kövesse <a href="{{url}}" target="_blank">ezeket az utasításokat</a>, és lépjen a jegyűrlapkezelő oldalra a beállítások befejezéséhez.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"A beküldött időtartam túl hosszú volt.","statuses.closed":"l","statuses.hold":"v","statuses.new":"ú","statuses.open":"n","statuses.pending":"f","statuses.solved":"m",time_format_hms:"HH:mm:ss",time_format_minutes:"perc","views.main.pause":"Szünet","views.main.play":"Lejátszás","views.main.reset":"Visszaállítás","views.main.timelogs":"Időnapló","views.main.timelogs_table.agent":"Munkatárs","views.main.timelogs_table.status":"Állapot","views.main.timelogs_table.time":"Idő","views.main.total_time_spent":"Teljes idő","views.modal.body_with_format":"Ennyi időt ({{time_format}}) töltött a jeggyel. Ha szükséges, szerkessze az időt, majd kattintson az Idő beküldése gombra.","views.modal.close":"Mégse","views.modal.count_down":"Ez a modális ablak {{time}} másodperc múlva automatikusan bezáródik.","views.modal.save":"Idő beküldése","views.resume_modal.body":"Szeretné folytatni az idő mérését?","views.resume_modal.no":"Nem","views.resume_modal.yes":"Igen","views.timelogs.csv_export":"CSV exportálása","views.timelogs.empty":"Nincsenek megjeleníthető időnaplók","views.timelogs.error":"Az időnaplók betöltése sikertelen volt.","views.timelogs.hide_timelogs":"Időnaplók elrejtése","views.timelogs.show_timelogs":"Időnaplók megjelenítése","views.timelogs.title":"Időnaplók"}},7804(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},62(e){e.exports={"app.installation_instructions":"### Memulai dengan aplikasi Pelacakan Waktu:\n\n1. Masuk ke akun Zendesk Support Anda, lalu klik ikon Admin yang ada di bilah samping.\n2. Pilih **Aplikasi > Marketplace**, lalu temukan aplikasi Pelacakan Waktu dan klik ubin.\n3. Pada halaman aplikasi Pelacakan Waktu, klik **Instal aplikasi** di pojok kanan atas. Aplikasi ini hanya tersedia untuk pelanggan pada paket Professional dan Enterprise.\n4. Masukkan nama untuk aplikasi, pilih konfigurasi yang Anda inginkan, lalu klik **Instal**.\n5. Jika Anda menggunakan Formulir Tiket (bagian dari tambahan Paket Produktivitas), buka **Admin > Kelola > Formulir Tiket** dan tambahkan petak tiket ‘Total time spent’ (Total waktu yang dihabiskan) dan ‘Time spent last update’ (Waktu yang dihabiskan sejak pembaruan terakhir) pada setiap Formulir Tiket Anda.","app.long_description":"*Secara otomatis melacak waktu yang dihabiskan pada setiap tiket Zendesk Support Anda\n* Sesuaikan aplikasi untuk memasukkan fungsionalitas yang tepat dibutuhkan oleh tim Anda\n* Manfaatkan insights untuk membuat laporan terperinci dengan data pelacakan waktu\n\nAplikasi Pelacakan Waktu mempermudah Anda dalam mengelola kinerja dan keseluruhan operasi dukungan tim Anda. Dengan mudah mengidentifikasi pelanggan mana yang mengirim tiket tersulit, atau jenis masalah mana yang membutuhkan waktu terlama bagi tim Anda untuk menyelesaikannya. Galilah ke tiket agen untuk menemukan mengapa mereka membutuhkan waktu lama dan masalah apa yang menjadi keahlian mereka.\n\n### Ketahui dengan tepat bagaimana dan di mana tim Anda menghabiskan waktu mereka\n\nJalankan log yang mendukung agen mengerjakan tiket dan seberapa lama setiap interaksi berlangsung. Secara otomatis mencatat waktu total yang dihabiskan begitu agen Anda memperbarui tiket atau biarkan mereka memasukkan waktu tersebut secara manual.\n\n### Mudah untuk disiapkan, dikustomisasi, dan digunakan\n\nAplikasi Pelacakan Waktu tidak membutuhkan penyiapan pihak ketiga atau login. Cukup kustomisasikan bagaimana aplikasi Pelacakan Waktu ditampilkan dan berfungsi untuk tim dukungan Anda, agar sesuai dengan alur kerja tim Anda saat ini.\n\n###Laporkan log waktu Anda serta ambil tindakan\n\nMulailah segera melaporkan dengan laporan pelacakan waktu khusus yang mudah diintegrasikan Insights. Ketahui dengan tepat apa yang menghabiskan sumber daya tim dukungan Anda dan temukan area terbaik untuk pengoptimalan dan peningkatan.\n\nDengan mengaktifkan aplikasi ini, Anda setuju terhadap [Persyaratan Penggunaan Built by Zendesk] (https://www.sendesk.com/company/built-by-zendesk-agmt/).","app.name":"Pelacakan Waktu","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Pengatur waktu berhenti sebentar ketika agen menjauh dari tiket dan melanjutkan kembali ketika agen kembali ke tiket tersebut.","app.parameters.auto_pause_resume.label":"Jeda otomatis","app.parameters.debug_prevent_huge_times.helpText":"Blokir pengiriman tiket jika agen mencoba mengirimkan tiket dengan nilai waktu yang dihabiskan (dalam detik) lebih besar daripada 1209600 detik (dua minggu).","app.parameters.debug_prevent_huge_times.label":"Debug: Blokir pengiriman waktu yang dihabiskan dalam jumlah besar","app.parameters.display_timelogs.helpText":"Agen dapat melihat aktivitas timelog pada tiket,","app.parameters.display_timelogs.label":"Tampilkan timelog kepada agen","app.parameters.hide_from_agents.helpText":"Aplikasi ini tidak akan ditunjukkan kepada agen yang tidak memiliki peran ‘Admin’. Hal ini juga mencegah mereka untuk dapat melihat & mengedit waktu setelah pengiriman.","app.parameters.hide_from_agents.label":"Sembunyikan aplikasi dari agen","app.parameters.manual_pause_resume.helpText":"Agen dapat secara manual berhenti sebentar atau menyetel ulang pengatur waktu.","app.parameters.manual_pause_resume.label":"Tampilkan kontrol pengatur waktu","app.parameters.reset.helpText":"Agen dapat menyetel ulang waktu saat ini yang dihabiskan pada tiket.","app.parameters.reset.label":"Setel ulang waktu saat ini","app.parameters.resume_on_changes.helpText":"Ketika perubahan dibuat pada petak apa pun, modal akan bertanya apakah pengatur waktu sebaiknya dilanjutkan.","app.parameters.resume_on_changes.label":"Lanjutkan pada perubahan","app.parameters.simple_submission.helpText":"Meminta agen untuk memasukkan nilai dalam satuan menit sebelum mengirimkan tiket","app.parameters.simple_submission.label":"Pengiriman waktu yang disederhanakan","app.parameters.time_field_id.helpText":"ID petak numerik kustom yang akan menyimpan waktu total.","app.parameters.time_field_id.label":"ID Petak Waktu","app.parameters.time_object_field_id.helpText":"ID petak numerik kustom yang akan menyimpan waktu total yang dihabiskan pada tiket.","app.parameters.time_object_field_id.label":"ID Petak Konfigurasi","app.parameters.time_submission.helpText":"Agen dapat meninjau dan mengedit waktu mereka sebelum menyerahkan tiket.","app.parameters.time_submission.label":"Edit penyerahan waktu","app.short_description":"Membantu Anda melacak waktu yang dihabiskan pada tiket.","errors.bad_time_with_format":"Format waktu tidak valid, seharusnya {{time_format}}.","errors.negative_time":"Waktu negatif. Menyetel ulang ke 0.","errors.no_answer":"Tidak ada waktu yang dikirimkan","errors.save_hook":"Anda perlu mengirimkan waktu Anda pada tiket ini.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Apakah Anda mengikuti instruksi instalasi untuk aplikasi ini dan mengonfigurasi kedua petak tiket yang dibutuhkan agar muncul di setiap formulir tiket?","errors.setup.solution":'Bila tidak, silakan lihat <a href="{{url}}" target="_blank">instruksi ini</a> dan buka halaman pengelolaan formulir tiket untuk melakukan finalisasi penyiapan.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"Waktu yang diajukan terlalu lama.","statuses.closed":"t","statuses.hold":"h","statuses.new":"b","statuses.open":"u","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"menit","views.main.pause":"Jeda","views.main.play":"Putar","views.main.reset":"Setel ulang","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agen","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Waktu","views.main.total_time_spent":"Total waktu","views.modal.body_with_format":"Ini adalah jumlah waktu ({{time_format}}) yang Anda habiskan pada tiket ini. Edit waktu ini, bila diperlukan, lalu klik “Kirim waktu”.","views.modal.close":"Batal","views.modal.count_down":"Pemodelan ini akan secara otomatis ditutup dalam {{time}} detik.","views.modal.save":"Kirim waktu","views.resume_modal.body":"Anda ingin melanjutkan pengatur waktu?","views.resume_modal.no":"Tidak","views.resume_modal.yes":"Ya","views.timelogs.csv_export":"Ekspor CSV","views.timelogs.empty":"Tidak ada timelog untuk ditampilkan","views.timelogs.error":"Kami tidak dapat memuat timelog.","views.timelogs.hide_timelogs":"Sembunyikan timelog","views.timelogs.show_timelogs":"Tunjukkan timelog","views.timelogs.title":"Timelog"}},8515(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},4746(e){e.exports={"app.installation_instructions":"### Operazioni preliminari per l’app Cronometro\n\n1. Accedi all’account Zendesk Support e fai clic sull’icona Amministratore nella barra laterale.\n2. Seleziona **App > Marketplace**, quindi trova l’app Cronometro e fai clic sulla tile.\n3. Nella pagina dell’app Cronometro, fai clic su **Installa app** nell’angolo in alto a destra. Questa app è disponibile solo per i clienti con i piani Professional ed Enterprise.\n4. Inserisci il nome dell’app, seleziona le configurazioni che preferisci, quindi fai clic su **Installa**.\n5. Se stai usando i moduli ticket (parte del componente aggiuntivo Pacchetto produttività), seleziona **Amministratore > Gestisci > Moduli ticket** e aggiungi i campi ticket “Total time spent” (Tempo totale impiegato) e “Time spent last update” (Tempo impiegato dall’ultimo aggiornamento) su ciascun modulo ticket.","app.long_description":"* Monitoraggio automatico del tempo dedicato a ciascuno dei ticket Zendesk Support\n* Personalizza l’app per includere funzionalità specifiche per le esigenze del tuo team.\n* Utilizza Insights per creare rapporti dettagliati contenenti i dati raccolti dall’app Cronometro.\n\nCon l’app Cronometro puoi gestire più facilmente le prestazioni del tuo team e le attività di assistenza in generale. Identifica facilmente quali clienti inviano i ticket più complessi o quali tipi di problemi richiedono più tempo per la risoluzione. Analizza in dettaglio i ticket di un agente specifico per identificare le attività che lo tengono più occupato e i problemi che risolve con maggiore competenza.\n\n### Identifica in dettaglio in che modo opera il tuo team e di quali attività si occupa.\n\nMantieni un elenco aggiornato degli agenti dell’assistenza che hanno lavorato a un ticket e della durata di ciascuna interazione. Registra automaticamente il tempo totale impiegato, non appena un agente aggiorna un ticket, oppure permetti agli agenti di inserire manualmente il tempo dedicato alle diverse attività.\n\n### Facile da impostare, da personalizzare e da usare\n\nL’app Cronometro non richiede l’impostazione o l’accesso tramite siti di terzi. Basta personalizzare il modo in cui viene visualizzata e configurata per garantire un’integrazione perfetta nel workflow corrente del tuo team dell’assistenza.\n\n### Crea rapporti sui registri temporali e prendi decisioni mirate.\n\nInizia immediatamente a redigere rapporti sull’impiego dei tempi di lavoro personalizzati e facili da creare, tramite Insights. Scopri esattamente in che modo vengono utilizzate le risorse del team dell’assistenza e quali sono gli aspetti da ottimizzare e migliorare.\n\nAttivando l’app, accetti i [Termini di utilizzo per le app create da Zendesk](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Cronometro","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Il timer viene fermato quando l’agente esce dal ticket e riavviato quando torna sul ticket.","app.parameters.auto_pause_resume.label":"Pausa automatica","app.parameters.debug_prevent_huge_times.helpText":"Se un agente tenta di inviare un ticket su cui ha trascorso una quantità di tempo superiore a 1209600 secondi (due settimane), l’invio viene bloccato.","app.parameters.debug_prevent_huge_times.label":"Debug: blocca invii con eccessivo impiego di tempo","app.parameters.display_timelogs.helpText":"Gli agenti possono vedere le attività nel registro temporale per i ticket.","app.parameters.display_timelogs.label":"Mostra registro temporale agli agenti","app.parameters.hide_from_agents.helpText":"L’app non sarà visibile agli agenti il cui ruolo non è di “Amministratore”. In questo modo non potranno vedere né modificare il tempo trascorso al momento dell’inoltro del ticket.","app.parameters.hide_from_agents.label":"Nascondi app agli agenti","app.parameters.manual_pause_resume.helpText":"Gli agenti possono avviare o fermare il timer manualmente.","app.parameters.manual_pause_resume.label":"Mostra controlli timer","app.parameters.reset.helpText":"Gli agenti possono azzerare il conteggio del tempo trascorso su un ticket.","app.parameters.reset.label":"Azzera conteggio del tempo","app.parameters.resume_on_changes.helpText":"Quando vengono apportate modifiche ai campi, una finestra modale chiede se riavviare il timer.","app.parameters.resume_on_changes.label":"Riavvia in presenza di modifiche","app.parameters.simple_submission.helpText":"Gli agenti possono inserire un valore in minuti prima di inviare il ticket.","app.parameters.simple_submission.label":"Inoltro del tempo in formato semplificato","app.parameters.time_field_id.helpText":"ID di un campo numerico personalizzato che conterrà il tempo totale.","app.parameters.time_field_id.label":"ID campo temporale","app.parameters.time_object_field_id.helpText":"ID di un campo numerico personalizzato che conterrà il tempo passato su un ticket.","app.parameters.time_object_field_id.label":"ID campo configurazione","app.parameters.time_submission.helpText":"Gli agenti possono rivedere e modificare il proprio tempo prima di inviare il ticket.","app.parameters.time_submission.label":"Modifica tempo al momento dell’invio","app.short_description":"Aiuta a tenere traccia del tempo passato sui ticket.","errors.bad_time_with_format":"Formato orario non valido. Formato previsto: {{time_format}}.","errors.negative_time":"Il tempo ha un valore negativo. Verrà reimpostato a 0.","errors.no_answer":"Tempo non inviato","errors.save_hook":"Devi indicare il tempo trascorso su questo ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Hai seguito le istruzioni per l’installazione dell’app e configurato entrambi i campi ticket obbligatori per la visualizzazione su ogni modulo ticket?","errors.setup.solution":'In caso contrario, consulta <a href="{{url}}" target="_blank">queste istruzioni</a> e visita la pagina di gestione dei moduli ticket per finalizzare l’impostazione.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"Il tempo inserito è eccessivo.","statuses.closed":"c","statuses.hold":"s","statuses.new":"n","statuses.open":"a","statuses.pending":"i","statuses.solved":"r",time_format_hms:"HH:mm:ss",time_format_minutes:"minuti","views.main.pause":"In pausa","views.main.play":"Riproduci","views.main.reset":"Azzera","views.main.timelogs":"Registro temporale","views.main.timelogs_table.agent":"Agente","views.main.timelogs_table.status":"Stato","views.main.timelogs_table.time":"Tempo","views.main.total_time_spent":"Tempo totale","views.modal.body_with_format":"Di seguito è indicata la quantità di tempo dedicata a questo ticket ({{time_format}}). Puoi modificare questo valore, se necessario, e quindi fare clic su “Invia tempo”.","views.modal.close":"Annulla","views.modal.count_down":"Questa finestra di dialogo si chiuderà automaticamente fra {{time}} secondi.","views.modal.save":"Invia tempo","views.resume_modal.body":"Vuoi riavviare il timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Sì","views.timelogs.csv_export":"Esporta CSV","views.timelogs.empty":"Nessun registro temporale da visualizzare","views.timelogs.error":"Impossibile caricare i registri temporali.","views.timelogs.hide_timelogs":"Nascondi registri temporali","views.timelogs.show_timelogs":"Mostra registri temporali","views.timelogs.title":"Registro temporale"}},4702(e){e.exports={"app.installation_instructions":"### Operazioni preliminari per l’app Cronometro\n\n1. Accedi all’account Zendesk Support e fai clic sull’icona Amministratore nella barra laterale.\n2. Seleziona **App > Marketplace**, quindi trova l’app Cronometro e fai clic sulla tile.\n3. Nella pagina dell’app Cronometro, fai clic su **Installa app** nell’angolo in alto a destra. Questa app è disponibile solo per i clienti con i piani Professional ed Enterprise.\n4. Inserisci il nome dell’app, seleziona le configurazioni che preferisci, quindi fai clic su **Installa**.\n5. Se stai usando i moduli ticket (parte del componente aggiuntivo Pacchetto produttività), seleziona **Amministratore > Gestisci > Moduli ticket** e aggiungi i campi ticket “Total time spent” (Tempo totale impiegato) e “Time spent last update” (Tempo impiegato dall’ultimo aggiornamento) su ciascun modulo ticket.","app.long_description":"* Monitoraggio automatico del tempo dedicato a ciascuno dei ticket Zendesk Support\n* Personalizza l’app per includere funzionalità specifiche per le esigenze del tuo team.\n* Utilizza Insights per creare rapporti dettagliati contenenti i dati raccolti dall’app Cronometro.\n\nCon l’app Cronometro puoi gestire più facilmente le prestazioni del tuo team e le attività di assistenza in generale. Identifica facilmente quali clienti inviano i ticket più complessi o quali tipi di problemi richiedono più tempo per la risoluzione. Analizza in dettaglio i ticket di un agente specifico per identificare le attività che lo tengono più occupato e i problemi che risolve con maggiore competenza.\n\n### Identifica in dettaglio in che modo opera il tuo team e di quali attività si occupa.\n\nMantieni un elenco aggiornato degli agenti dell’assistenza che hanno lavorato a un ticket e della durata di ciascuna interazione. Registra automaticamente il tempo totale impiegato, non appena un agente aggiorna un ticket, oppure permetti agli agenti di inserire manualmente il tempo dedicato alle diverse attività.\n\n### Facile da impostare, da personalizzare e da usare\n\nL’app Cronometro non richiede l’impostazione o l’accesso tramite siti di terzi. Basta personalizzare il modo in cui viene visualizzata e configurata per garantire un’integrazione perfetta nel workflow corrente del tuo team dell’assistenza.\n\n### Crea rapporti sui registri temporali e prendi decisioni mirate.\n\nInizia immediatamente a redigere rapporti sull’impiego dei tempi di lavoro personalizzati e facili da creare, tramite Insights. Scopri esattamente in che modo vengono utilizzate le risorse del team dell’assistenza e quali sono gli aspetti da ottimizzare e migliorare.\n\nAttivando l’app, accetti i [Termini di utilizzo per le app create da Zendesk](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Cronometro","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"Il timer viene fermato quando l’agente esce dal ticket e riavviato quando torna sul ticket.","app.parameters.auto_pause_resume.label":"Pausa automatica","app.parameters.debug_prevent_huge_times.helpText":"Se un agente tenta di inviare un ticket su cui ha trascorso una quantità di tempo superiore a 1209600 secondi (due settimane), l’invio viene bloccato.","app.parameters.debug_prevent_huge_times.label":"Debug: blocca invii con eccessivo impiego di tempo","app.parameters.display_timelogs.helpText":"Gli agenti possono vedere le attività nel registro temporale per i ticket.","app.parameters.display_timelogs.label":"Mostra registro temporale agli agenti","app.parameters.hide_from_agents.helpText":"L’app non sarà visibile agli agenti il cui ruolo non è di “Amministratore”. In questo modo non potranno vedere né modificare il tempo trascorso al momento dell’inoltro del ticket.","app.parameters.hide_from_agents.label":"Nascondi app agli agenti","app.parameters.manual_pause_resume.helpText":"Gli agenti possono avviare o fermare il timer manualmente.","app.parameters.manual_pause_resume.label":"Mostra controlli timer","app.parameters.reset.helpText":"Gli agenti possono azzerare il conteggio del tempo trascorso su un ticket.","app.parameters.reset.label":"Azzera conteggio del tempo","app.parameters.resume_on_changes.helpText":"Quando vengono apportate modifiche ai campi, una finestra modale chiede se riavviare il timer.","app.parameters.resume_on_changes.label":"Riavvia in presenza di modifiche","app.parameters.simple_submission.helpText":"Gli agenti possono inserire un valore in minuti prima di inviare il ticket.","app.parameters.simple_submission.label":"Inoltro del tempo in formato semplificato","app.parameters.time_field_id.helpText":"ID di un campo numerico personalizzato che conterrà il tempo totale.","app.parameters.time_field_id.label":"ID campo temporale","app.parameters.time_object_field_id.helpText":"ID di un campo numerico personalizzato che conterrà il tempo passato su un ticket.","app.parameters.time_object_field_id.label":"ID campo configurazione","app.parameters.time_submission.helpText":"Gli agenti possono rivedere e modificare il proprio tempo prima di inviare il ticket.","app.parameters.time_submission.label":"Modifica tempo al momento dell’invio","app.short_description":"Aiuta a tenere traccia del tempo passato sui ticket.","errors.bad_time_with_format":"Formato orario non valido. Formato previsto: {{time_format}}.","errors.negative_time":"Il tempo ha un valore negativo. Verrà reimpostato a 0.","errors.no_answer":"Tempo non inviato","errors.save_hook":"Devi indicare il tempo trascorso su questo ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Hai seguito le istruzioni per l’installazione dell’app e configurato entrambi i campi ticket obbligatori per la visualizzazione su ogni modulo ticket?","errors.setup.solution":'In caso contrario, consulta <a href="{{url}}" target="_blank">queste istruzioni</a> e visita la pagina di gestione dei moduli ticket per finalizzare l’impostazione.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"Il tempo inserito è eccessivo.","statuses.closed":"c","statuses.hold":"s","statuses.new":"n","statuses.open":"a","statuses.pending":"i","statuses.solved":"r",time_format_hms:"HH:mm:ss",time_format_minutes:"minuti","views.main.pause":"In pausa","views.main.play":"Riproduci","views.main.reset":"Azzera","views.main.timelogs":"Registro temporale","views.main.timelogs_table.agent":"Agente","views.main.timelogs_table.status":"Stato","views.main.timelogs_table.time":"Tempo","views.main.total_time_spent":"Tempo totale","views.modal.body_with_format":"Di seguito è indicata la quantità di tempo dedicata a questo ticket ({{time_format}}). Puoi modificare questo valore, se necessario, e quindi fare clic su “Invia tempo”.","views.modal.close":"Annulla","views.modal.count_down":"Questa finestra di dialogo si chiuderà automaticamente fra {{time}} secondi.","views.modal.save":"Invia tempo","views.resume_modal.body":"Vuoi riavviare il timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Sì","views.timelogs.csv_export":"Esporta CSV","views.timelogs.empty":"Nessun registro temporale da visualizzare","views.timelogs.error":"Impossibile caricare i registri temporali.","views.timelogs.hide_timelogs":"Nascondi registri temporali","views.timelogs.show_timelogs":"Mostra registri temporali","views.timelogs.title":"Registro temporale"}},1214(e){e.exports={"app.installation_instructions":"### タイムトラッキングアプリを使い始めるには:\n\n1.Zendesk Supportアカウントにサインインし、サイドバーの管理アイコンをクリックします。\n2.「**アプリ**」>「**マーケットプレイス**」の順に選択して、タイムトラッキングアプリを見つけ、タイルをクリックします。\n3.タイムトラッキングアプリのページで、右上隅の「**アプリをインストール**」をクリックします。このアプリをご利用いただけるのは、 ProfessionalプランとEnterprise プランのお客様だけです。\n4.アプリの名前を入力し、希望の設定を選択し、「**インストール**」をクリックします。\n5.チケットフォーム（生産性向上パックアドオンの一部）を使用している場合は、「**管理**」 > 「**管理**」>「**チケットフォーム**」に移動し、「Total time spent」と「Time spent last update」チケットフィールドを各チケットフォームに追加します。","app.long_description":"* 各Zendeskサポートチケットに費やされた時間を自動的に追跡する\n * チームが必要とする機能が含まれるようにアプリをカスタマイズする\n * インサイトを活用し、タイムトラッキングのデータを使って詳細なレポートを作成する\n\nチームのパフォーマンスとサポート業務全体を簡単に管理できます。最も複雑なチケットを送信する顧客や、解決するのに最も長い時間がかかる問題のタイプを簡単に特定できます。エージェントのチケットを詳しく調べて、解決に時間がかかるものや、各エージェントに相応しい問題を見つけます。\n\n###チームがどのように、どのような箇所に時間を費やしているかを正確に把握します。\n\nチケットの解決を担当したエージェントや、個々のインタラクションにどれくらい時間がかかったかを継続的に記録します。エージェントがチケットの更新に要した合計時間を自動的に記録したり、手動で時間を入力できます。\n\n ###使いやすく、設定、カスタマイズが容易です。\n\nタイムトラッキングアプリには、サードパーティの設定やログインは不要です。サポートチームの現在のワークフローにシームレスに適応するよう、タイムトラッキングアプリの表示や、チームでの操作を簡単にカスタマイズできます。\n\n ###時間ログを記録してアクションを起こします。\n\nインサイトを活用したタイムトラッキングレポートのカスタマイズが容易です。サポートチームのリソースを浪費しているものを正確に把握し、最適化と改善に最適な箇所を見つけます。\n\nこのアプリを有効にすると、[Zendesk作成の利用規約]（https://www.zendesk.com/company/built-by-zendesk-agmt/）に同意したことになります。","app.name":"タイムトラッキング","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"このタイマーはエージェントがチケットから離れると一時停止し、チケットに戻ると再開されます。","app.parameters.auto_pause_resume.label":"自動一時停止","app.parameters.debug_prevent_huge_times.helpText":"対応時間 (秒単位)の値が1209600秒(2週間)を超えるチケットを送信しようとしている場合に、チケットの送信をブロックします。","app.parameters.debug_prevent_huge_times.label":"デバッグ:対応時間が長いチケットの送信をブロック","app.parameters.display_timelogs.helpText":"エージェントはチケットのタイムログ動作を表示できます。","app.parameters.display_timelogs.label":"タイムログをエージェントに表示","app.parameters.hide_from_agents.helpText":"「管理者」のロールを持たないエージェントにアプリが表示されなくなります。このため、送信時に時間を表示/編集することもできません。","app.parameters.hide_from_agents.label":"アプリをエージェントに表示しない","app.parameters.manual_pause_resume.helpText":"エージェントが手動でタイマーを一時停止またはリセットすることができます。","app.parameters.manual_pause_resume.label":"タイマーコントロールを表示","app.parameters.reset.helpText":"エージェントがチケットに費やした現在の時間をリセットできます。","app.parameters.reset.label":"現在の時間をリセット","app.parameters.resume_on_changes.helpText":"フィールドを変更すると、タイマーを再開するかを尋ねるダイアログボックスが表示されます。","app.parameters.resume_on_changes.label":"変更時に再開","app.parameters.simple_submission.helpText":"エージェントはチケットを送信する前に値を分単位で入力できます。","app.parameters.simple_submission.label":"簡易時間送信","app.parameters.time_field_id.helpText":"合計時間を表示するカスタム数値フィールドのID。","app.parameters.time_field_id.label":"時間フィールドID","app.parameters.time_object_field_id.helpText":"チケットに費やした時間を表示するカスタム数値フィールドのID。","app.parameters.time_object_field_id.label":"設定フィールドID","app.parameters.time_submission.helpText":"エージェントはチケットを送信する前に時間を確認し、編集することができます。","app.parameters.time_submission.label":"時間の送信を編集","app.short_description":"チケットに費やした時間をトラッキングできます。","errors.bad_time_with_format":"時間表記が無効です。{{time_format}}の形式にしてください","errors.negative_time":"時間が負の数でした。0にリセットしています。","errors.no_answer":"対応記録がありません","errors.save_hook":"このチケットの時間を送信する必要があります。","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"このアプリのインストール手順に従って、2つの必要なチケットフィールドがすべてのチケットフォームに表示されるように設定しましたか。","errors.setup.solution":'そのように設定していない場合は、<a href="{{url}}" target="_blank">こちらの手順</a>を参照し、チケットフォームの管理ページに進んで、設定を完了してください。',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"送信した時間が長すぎました。","statuses.closed":"終","statuses.hold":"待","statuses.new":"新","statuses.open":"オ","statuses.pending":"保","statuses.solved":"済",time_format_hms:"HH:mm:ss",time_format_minutes:"分","views.main.pause":"一時停止","views.main.play":"再生","views.main.reset":"リセット","views.main.timelogs":"タイムログ","views.main.timelogs_table.agent":"エージェント","views.main.timelogs_table.status":"ステータス","views.main.timelogs_table.time":"時間","views.main.total_time_spent":"合計時間","views.modal.body_with_format":"これはこのチケットに費やした時間数 ({{time_format}}) です。必要であれば時間を編集して、「時間を送信」をクリックしてください。","views.modal.close":"キャンセル","views.modal.count_down":"このウインドウは{{time}}秒後に閉じます。","views.modal.save":"時間を送信","views.resume_modal.body":"タイマーを再開しますか?","views.resume_modal.no":"いいえ","views.resume_modal.yes":"はい","views.timelogs.csv_export":"CSVをエクスポート","views.timelogs.empty":"表示するタイムログがありません","views.timelogs.error":"タイムログを読み込むことができません。","views.timelogs.hide_timelogs":"タイムログを非表示","views.timelogs.show_timelogs":"タイムログを表示","views.timelogs.title":"タイムログ"}},4911(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},449(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},9061(e){e.exports={"app.installation_instructions":"### 시간 추적 앱 시작하기:\n\n1. Zendesk Support 계정에 로그인한 다음 사이드바에 있는 관리자 아이콘을 클릭합니다.\n2. **앱 > 마켓플레이스**를 선택한 다음 시간 추적 앱을 찾아 타일을 클릭합니다.\n3. 시간 추적 앱 페이지 오른쪽 위에 있는 **앱 설치**를 클릭합니다. 이 앱은 Professional 및 Enterprise 플랜에 가입한 고객들에게만 제공됩니다.\n4. 앱 이름을 입력하고 원하는 설정을 구성한 다음 **설치**를 클릭합니다.\n5. 티켓 양식(생산성 팩 추가 기능의 일부)을 사용하는 경우에는 **관리자 > 관리 > 티켓 양식**으로 이동하여 각 티켓 양식에 ‘Total time spent’ 및 ‘Time spent last update’ 티켓 필드를 추가합니다.","app.long_description":"* 각 Zendesk Support 티켓에 소모한 시간을 자동으로 추적하세요.\n* 팀이 필요로 하는 정확한 기능을 포함하도록 앱을 사용자 지정하세요.\n* Insights를 활용하여 시간 추적 데이터로 상세 보고서를 작성하세요.\n\n시간 추적 앱으로 팀의 성과 및 전체적인 지원 운영을 쉽게 관리할 수 있습니다. 가장 복잡한 티켓을 보내는 고객이나 팀이 해결하는 데 시간이 가장 오래 걸리는 문제를 쉽게 파악하세요. 상담원의 티켓을 분석하여 상담원이 많은 시간을 소모하는 문제와 능숙하게 해결하는 문제를 알아내세요.\n\n### 팀이 시간을 어떻게, 그리고 어디에 소모하고 있는지 정확하게 이해.\n\n티켓에서 작업한 지원 상담원의 실행 로그 및 각 상호작용의 지속 시간을 기록하세요. 상담원이 티켓을 업데이트하자마자 총 소모 시간을 자동으로 기록하거나 상담원이 직접 시간을 입력하게 하세요.\n\n### 쉬운 설정, 사용자 지정 및 사용\n\n시간 추적 앱은 제3자의 설정이나 로그인을 필요로 하지 않습니다. 팀의 현재 워크플로에 완벽하게 통합되도록 시간 추적 앱이 지원 팀에 어떤 식으로 표시되고 작동될지 사용자 지정만 하면 됩니다.\n\n### 시간 로그에 대해 리포팅하고 조치 취하기 \n\nInsights를 통해 쉽게 구축할 수 있는 사용자 지정 시간 추적 보고서로 지금 바로 보고를 시작하세요. 지원 팀의 리소스를 소모시키는 것이 무엇인지 정확히 알고 어느 영역을 최적화하고 개선하는 것이 가장 좋은지 찾아내세요.\n\n이 앱을 사용 설정하면 [Zendesk에서 제공 이용 약관](https://www.zendesk.com/company/built-by-zendesk-agmt/)에 동의하는 것입니다.","app.name":"시간 추적","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"상담사가 티켓에서 나가면 타이머가 일시 중지하고 상담사가 티켓에 돌아올 때 타이머가 다시 시작합니다.","app.parameters.auto_pause_resume.label":"자동 일시 중지","app.parameters.debug_prevent_huge_times.helpText":"상담사가 1209600초(2주)보다 긴 시간 값(초 단위)의 티켓을 제출하려고 하는 경우 티켓 제출을 차단합니다.","app.parameters.debug_prevent_huge_times.label":"디버그: 지정 값보다 시간이 더 긴 경우 제출 차단","app.parameters.display_timelogs.helpText":"상담사는 티켓에 대한 시간 로그 활동을 볼 수 있습니다.","app.parameters.display_timelogs.label":"상담사에게 시간 로그 표시","app.parameters.hide_from_agents.helpText":"‘관리자’ 역할이 없는 상담사에게는 앱이 표시되지 않습니다. 따라서 상담사가 티켓 제출 시 해당 티켓에 소요된 시간을 보고 변경하는 것 또한 방지합니다.","app.parameters.hide_from_agents.label":"상담사로부터 앱 숨기기","app.parameters.manual_pause_resume.helpText":"상담사는 타이머를 수동으로 일시 중지하거나 재설정할 수 있습니다.","app.parameters.manual_pause_resume.label":"타이머 컨트롤 표시","app.parameters.reset.helpText":"상담사는 티켓에 소모한 현재 시간을 재설정할 수 있습니다.","app.parameters.reset.label":"현재 시간 재설정","app.parameters.resume_on_changes.helpText":"필드가 변경되면 타이머를 다시 시작할지 묻습니다.","app.parameters.resume_on_changes.label":"변경 시 다시 시작","app.parameters.simple_submission.helpText":"상담사는 티켓을 제출하기 전에 분 단위로 값을 입력할 수 있습니다.","app.parameters.simple_submission.label":"간단 시간 제출","app.parameters.time_field_id.helpText":"총 시간을 보유할 사용자 지정 숫자 필드의 ID.","app.parameters.time_field_id.label":"시간 필드 ID","app.parameters.time_object_field_id.helpText":"티켓에 소모한 시간을 보유할 사용자 지정 숫자 필드의 ID.","app.parameters.time_object_field_id.label":"구성 필드 ID","app.parameters.time_submission.helpText":"상담사는 티켓을 제출하기 전에 시간을 검토 및 편집할 수 있습니다.","app.parameters.time_submission.label":"시간 제출 편집","app.short_description":"티켓에서 소모한 시간을 추적하는 데 도움이 됩니다.","errors.bad_time_with_format":"올바르지 않은 시간 형식입니다. {{time_format}} 형식이어야 합니다.","errors.negative_time":"입력한 시간이 음수이므로 0으로 재설정합니다.","errors.no_answer":"시간이 제출되지 않음","errors.save_hook":"이 티켓에 대한 시간을 제출해야 합니다.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"이 앱의 설치 지침에 따르고 필수 티켓 필드가 둘 다 모든 티켓 양식에 나타나도록 구성하셨습니까?","errors.setup.solution":'그렇게 하지 않은 경우에는 <a href="{{url}}" target="_blank">설치 지침</a>을 참조하여 티켓 양식 관리 페이지로 이동하여 설치를 완료하세요.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"제출된 시간이 너무 깁니다.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"분","views.main.pause":"일시 중지","views.main.play":"실행","views.main.reset":"재설정","views.main.timelogs":"시간 로그","views.main.timelogs_table.agent":"상담사","views.main.timelogs_table.status":"상태","views.main.timelogs_table.time":"시간","views.main.total_time_spent":"총 시간","views.modal.body_with_format":'티켓에서 보낸 시간의 양({{time_format}})입니다. 필요하면 시간을 편집한 다음 "시간 제출" 을 클릭하세요.',"views.modal.close":"취소","views.modal.count_down":"이 모달은 {{time}}초 후 자동으로 닫힙니다.","views.modal.save":"시간 제출","views.resume_modal.body":"타이머를 다시 시작하시겠어요?","views.resume_modal.no":"아니요","views.resume_modal.yes":"예","views.timelogs.csv_export":"CSV 내보내기","views.timelogs.empty":"표시할 시간 로그가 없습니다.","views.timelogs.error":"시간 로그를 로드할 수 없습니다.","views.timelogs.hide_timelogs":"시간 로그 숨기기","views.timelogs.show_timelogs":"시간 로그 표시","views.timelogs.title":"시간 로그"}},9363(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\n\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\n4. Enter a name for the app, select the configurations you want, then click **Install**.\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields 'Total time spent' and 'Time spent last update' to each of your Ticket Forms.\"","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customize the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team's performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent's tickets to discover what's taking up their time and which issues they're experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customize, and use\n\nThe Time Tracking App doesn't require any third party setup or login. Simply customize how the Time Tracking app displays and works for your support team, for a seamless fit into your team's current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what's draining your support team's resources and find the best areas for optimization and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).\"","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls","app.parameters.reset.helpText":"Agents can reset the current time spent on a ticket.","app.parameters.reset.label":"Reset current time","app.parameters.resume_on_changes.helpText":"When changes are made to any fields, a modal will ask if the timer should be resumed.","app.parameters.resume_on_changes.label":"Resume on changes","app.parameters.simple_submission.helpText":"Prompt agents to enter a value in minutes before submitting the ticket","app.parameters.simple_submission.label":"Simplified time submission","app.parameters.time_field_id.helpText":"The ID of a custom numeric field that will hold the total time.","app.parameters.time_field_id.label":"Time Field ID","app.parameters.time_object_field_id.helpText":"The ID of a custom numeric field that will hold the time spent on ticket.","app.parameters.time_object_field_id.label":"Configuration Field ID","app.parameters.time_submission.helpText":"Agents can review and edit their time before submitting the ticket.","app.parameters.time_submission.label":"Edit time submission","app.short_description":"Helps you track time spent on tickets.","errors.bad_time_with_format":"Invalid time format, expected {{time_format}}.","errors.negative_time":"Time was negative. Resetting to 0.","errors.no_answer":"No time submitted","errors.save_hook":"You need to submit your time on this ticket.","errors.setup.contact_admin":"You don't have access to update ticket forms. An admin can fix this by opening the Time Tracking app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalize the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing requi