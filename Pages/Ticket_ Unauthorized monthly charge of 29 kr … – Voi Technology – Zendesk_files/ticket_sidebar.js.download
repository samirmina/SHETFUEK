king app from this ticket.","errors.setup.failed_heading":"Following ticket forms failed to update","errors.setup.failed_manual":'Follow <a href="{{url}}" target="_blank">these instructions</a> to add the missing fields to these forms manually.',"errors.setup.fix_button":"Add missing fields","errors.setup.fix_failed":'The fields couldn\'t be added. Follow <a href="{{url}}" target="_blank">these instructions</a> to update your ticket forms manually.',"errors.setup.fixed_reload":"Reload your browser to apply these changes.","errors.setup.question":"Did you follow the installation instructions for this app and configure both required ticket fields to appear on every ticket form?","errors.setup.solution":'If not, please see <a href="{{url}}" target="_blank">these instructions</a> and go to your ticket forms management page to finalise the setup.',"errors.setup.updated_heading":"Following ticket forms updated successfully","errors.setup.warning_heading":"Some other ticket forms are missing required fields. Time tracking may not work correctly on tickets that use those forms.","errors.time_too_large":"The time submitted was too long.","statuses.closed":"c","statuses.hold":"h","statuses.new":"n","statuses.open":"o","statuses.pending":"p","statuses.solved":"s",time_format_hms:"HH:mm:ss",time_format_minutes:"minutes","views.main.pause":"Pause","views.main.play":"Play","views.main.reset":"Reset","views.main.timelogs":"Timelog","views.main.timelogs_table.agent":"Agent","views.main.timelogs_table.status":"Status","views.main.timelogs_table.time":"Time","views.main.total_time_spent":"Total time","views.modal.body_with_format":'This is the amount of time ({{time_format}}) you spent on this ticket. Edit the time, if needed, and then click "Submit time".',"views.modal.close":"Cancel","views.modal.count_down":"This modal will automatically close in {{time}} seconds.","views.modal.save":"Submit time","views.resume_modal.body":"Would you like to resume the timer?","views.resume_modal.no":"No","views.resume_modal.yes":"Yes","views.timelogs.csv_export":"Export CSV","views.timelogs.empty":"No timelogs to display","views.timelogs.error":"We are unable to load any timelogs.","views.timelogs.hide_timelogs":"Hide timelogs","views.timelogs.show_timelogs":"Show timelogs","views.timelogs.title":"Timelogs"}},9535(e){e.exports={"app.installation_instructions":"### Getting started with the Time Tracking app:\r\n\r\n1. Sign in to your Zendesk Support account, then click the Admin icon in the sidebar.\r\n2. Select **Apps > Marketplace**, then find the Time Tracking app and click the tile.\r\n3. On the Time Tracking app page, click **Install app** in the upper-right corner. This app is only available to customers on the Professional and Enterprise plans.\r\n4. Enter a name for the app, select the configurations you want, then click **Install**.\r\n5. If you are using Ticket Forms (part of the Productivity Pack add-on), go to **Admin > Manage > Ticket Forms** and add the ticket fields ‘Total time spent’ and ‘Time spent last update’ to each of your Ticket Forms.","app.long_description":"* Automatically track the time spent on each of your Zendesk Support tickets\n* Customise the app to include the exact functionality that your team needs\n* Leverage Insights to create detailed reports with your time tracking data\n\nThe Time Tracking app makes managing your team’s performance and overall support operations easier. Easily identify which customers send in the most complicated tickets, or which issue types take the longest for your team to resolve. Dig down into an agent’s tickets to discover what’s taking up their time and which issues they’re experts on.\n\n### Know exactly how and where your team is spending their time\n\nKeep a running log of which support agents have worked on a ticket and how long each interaction lasted. Automatically log the total time spent the second your agent updates a ticket or let them manually enter their time.\n\n### Easy to setup, customise, and use\n\nThe Time Tracking App doesn’t require any third party setup or login. Simply customise how the Time Tracking app displays and works for your support team, for a seamless fit into your team’s current workflow.\n\n### Report on your time logs and take action\n\nStart reporting right away with easily built custom time tracking reports through Insights. Know exactly what’s draining your support team’s resources and find the best areas for optimisation and improvement.\n\nBy enabling this app, You agree to the [Built by Zendesk Terms of Use](https://www.zendesk.com/company/built-by-zendesk-agmt/).","app.name":"Time Tracking","app.parameters.allow_zero_in_follow_up_ticket.helpText":"Allows submission of a ticket with a time spent value of 00:00:00 as time spent on a follow-up ticket.","app.parameters.allow_zero_in_follow_up_ticket.label":"Allow 00:00:00 as time spent on follow-up tickets","app.parameters.auto_pause_resume.helpText":"The timer pauses when the agent navigates away from the ticket and resumes when the agent is back on the ticket.","app.parameters.auto_pause_resume.label":"Auto pause","app.parameters.debug_prevent_huge_times.helpText":"Blocks submission of a ticket if an agent is trying to submit a ticket with a time spent value (in seconds) greater than 1209600s (two weeks).","app.parameters.debug_prevent_huge_times.label":"Debug: Block large time spent submissions","app.parameters.display_timelogs.helpText":"Agents can see timelog activity on tickets.","app.parameters.display_timelogs.label":"Display timelogs to agents","app.parameters.hide_from_agents.helpText":"The app will not be shown to agents who do not have the 'Admin' role. This also prevents them from being able to see & edit the time upon submission.","app.parameters.hide_from_agents.label":"Hide the app from agents","app.parameters.manual_pause_resume.helpText":"Agents can manually pause or reset the timer.","app.parameters.manual_pause_resume.label":"Display timer controls",